<%- include('layouts/header', { title: 'Submit Project', session }) %>

<h1>Submit Project</h1>

<% if (closed) { %>
  <div class="banner">Submissions are closed for this event.</div>
<% } else { %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error"><%= error %></div>
<% } %>

<form method="POST" action="/api/submissions" class="form-narrow">
  <div class="form-group">
    <label for="title">Project Title</label>
    <input type="text" id="title" name="title" required maxlength="200">
  </div>
  <div class="form-group">
    <label for="track_id">Track</label>
    <select id="track_id" name="track_id" required>
      <option value="">Select a track</option>
      <% for (const tr of tracks) { %>
        <option value="<%= tr.id %>"><%= tr.name %></option>
      <% } %>
    </select>
  </div>
  <div class="form-group">
    <label for="team_id">Your Team</label>
    <% if (typeof userTeams !== 'undefined' && userTeams && userTeams.length > 0) { %>
      <select id="team_id" name="team_id" required>
        <% for (const ut of userTeams) { %>
          <option value="<%= ut.id %>"><%= ut.name %> (<%= ut.id %>)</option>
        <% } %>
      </select>
    <% } else { %>
      <input type="text" id="team_id" name="team_id" required placeholder="e.g. tm_01">
      <small style="display:block; margin-top: 4px; color: #666;">You don't have a team yet. <a href="/team">Create or join one here</a>.</small>
    <% } %>
  </div>

  <div class="form-group">
    <label for="repo_url">Repository URL</label>
    <input type="text" id="repo_url" name="repo_url" placeholder="https://github.com/...">
  </div>
  <div class="form-group">
    <label for="summary">Summary</label>
    <textarea id="summary" name="summary" rows="5" placeholder="Describe your project..."></textarea>
  </div>
  <button type="submit">Submit Project</button>
</form>

<% } %>

<%- include('layouts/footer') %>
