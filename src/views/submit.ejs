<%- include('layouts/header', { title: 'Submit Project', session }) %>

<div style="background: #FFFFFF; border: 2px solid #1A1A1A; border-left: 6px solid #1A73E8; padding: 14px 20px; margin-bottom: 24px;">
  <div style="font-size: 0.8rem; font-weight: bold; text-transform: uppercase; color: #1A73E8; letter-spacing: 0.05em; margin-bottom: 4px;">
    Submitting to Hackathon
  </div>
  <h2 style="margin: 0; border: none; padding: 0; font-size: 1.35rem;">
    <%= typeof event !== 'undefined' && event ? event.name : 'Hackathon' %>
  </h2>
  <div style="margin-top: 6px; font-size: 0.88rem; color: #555;">
    Deadline: <%= event && event.submissions_close ? new Date(event.submissions_close).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'No deadline' %>
  </div>
</div>

<h1>Submit Project</h1>

<% if (closed) { %>
  <div class="banner">Submissions are closed for this event.</div>
<% } else { %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error"><%= error %></div>
<% } %>

<form method="POST" action="/api/submissions" class="form-narrow">
  <input type="hidden" name="event_id" value="<%= event ? event.id : '' %>">
  <div class="form-group">
    <label for="title">Project Title</label>
    <input type="text" id="title" name="title" required maxlength="200">
  </div>
  <div class="form-group">
    <label for="track_id">Track</label>
    <select id="track_id" name="track_id" required>
      <option value="">Select a track</option>
      <% for (const tr of tracks) { %>
        <option value="<%= tr.id %>"><%= tr.name %></option>
      <% } %>
    </select>
  </div>
  <div class="form-group">
    <label for="team_id">Your Team</label>
    <% if (typeof userTeams !== 'undefined' && userTeams && userTeams.length > 0) { %>
      <select id="team_id" name="team_id" required>
        <% for (const ut of userTeams) { %>
          <option value="<%= ut.id %>"><%= ut.name %> (<%= ut.id %>)</option>
        <% } %>
      </select>
    <% } else { %>
      <input type="text" id="team_id" name="team_id" required placeholder="e.g. tm_01">
      <small style="display:block; margin-top: 4px; color: #666;">You don't have a team in this hackathon yet. <a href="/team?event_id=<%= event ? event.id : '' %>">Create or join one here</a>.</small>
    <% } %>
  </div>

  <div class="form-group">
    <label for="repo_url">Repository URL</label>
    <input type="text" id="repo_url" name="repo_url" placeholder="https://github.com/...">
  </div>
  <div class="form-group">
    <label for="summary">Summary</label>
    <textarea id="summary" name="summary" rows="5" placeholder="Describe your project..."></textarea>
  </div>
  <button type="submit">Submit Project</button>
</form>

<% } %>

<%- include('layouts/footer') %>
