<%- include('layouts/header', { title: 'My Team', session }) %>

<!-- ── Confirmation Modal ──────────────────────────────────────────────────── -->
<div id="confirm-modal" style="
  display:none;position:fixed;inset:0;z-index:1000;
  background:rgba(0,0,0,.45);align-items:center;justify-content:center;
">
  <div style="
    background:#fff;border-radius:8px;padding:28px 32px;max-width:420px;width:90%;
    box-shadow:0 8px 32px rgba(0,0,0,.2);
  ">
    <h3 id="confirm-title" style="margin:0 0 10px;font-size:1.1rem"></h3>
    <p  id="confirm-message" style="margin:0 0 24px;color:#444;line-height:1.5"></p>
    <div style="display:flex;gap:12px;justify-content:flex-end">
      <button id="confirm-cancel"
        style="padding:8px 20px;border:1px solid #ccc;background:#fff;border-radius:4px;cursor:pointer;font-size:.95rem">
        Cancel
      </button>
      <button id="confirm-ok"
        style="padding:8px 20px;border:none;border-radius:4px;cursor:pointer;font-size:.95rem;font-weight:600">
        Confirm
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  const modal   = document.getElementById('confirm-modal');
  const title   = document.getElementById('confirm-title');
  const message = document.getElementById('confirm-message');
  const btnOk   = document.getElementById('confirm-ok');
  const btnCancel = document.getElementById('confirm-cancel');

  let pendingForm = null;

  // Danger level → button colour
  const colours = {
    danger:  { bg: '#c62828', color: '#fff' },
    warning: { bg: '#f9a825', color: '#000' },
    info:    { bg: '#1a73e8', color: '#fff' },
  };

  /**
   * Call this from any form's onsubmit / button onclick.
   * data-confirm-title, data-confirm-message, data-confirm-level on the form element.
   */
  window.showConfirm = function (form) {
    pendingForm = form;
    const level = form.dataset.confirmLevel || 'danger';
    const c = colours[level] || colours.danger;

    title.textContent   = form.dataset.confirmTitle   || 'Are you sure?';
    message.textContent = form.dataset.confirmMessage || 'This action cannot be undone.';
    btnOk.textContent   = form.dataset.confirmOk      || 'Confirm';
    btnOk.style.background = c.bg;
    btnOk.style.color      = c.color;

    modal.style.display = 'flex';
    btnCancel.focus();
    return false; // always block native submit
  };

  btnOk.addEventListener('click', () => {
    modal.style.display = 'none';
    if (pendingForm) {
      pendingForm.removeAttribute('onsubmit'); // prevent re-triggering
      pendingForm.submit();
      pendingForm = null;
    }
  });

  const close = () => { modal.style.display = 'none'; pendingForm = null; };
  btnCancel.addEventListener('click', close);
  modal.addEventListener('click', e => { if (e.target === modal) close(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
})();
</script>

<h1>My Teams</h1>

<% if (error)   { %><div class="error"  style="margin-bottom:16px"><%= error %></div><% } %>
<% if (success) { %><div class="banner" style="margin-bottom:16px;background:#e6f4ea;color:#137333;border-color:#34a853"><%= success %></div><% } %>
<% if (info)    { %><div class="banner" style="margin-bottom:16px"><%= info %></div><% } %>

<!-- ── Pending Invitations ──────────────────────────────────────────────── -->
<% if (myInvitations.length > 0) { %>
  <section style="margin-bottom:32px;background:#fff8e1;border:1px solid #f9a825;border-radius:6px;padding:20px">
    <h2 style="margin-top:0">📬 Pending Invitations</h2>
    <% for (const inv of myInvitations) { %>
      <div style="display:flex;align-items:center;gap:16px;padding:10px 0;border-bottom:1px solid #ffe082">
        <div style="flex:1">
          <strong><%= inv.team_name %></strong>
          <span style="color:#666;font-size:.9em"> — invited by <%= inv.inviter_name %> (<%= inv.inviter_email %>)</span>
        </div>
        <form method="POST" action="/team/invitation/<%= inv.id %>/accept" style="margin:0">
          <button type="submit" class="btn-action" style="background:#137333;color:#fff;border:none;padding:6px 14px;border-radius:4px;cursor:pointer">Accept</button>
        </form>
        <form method="POST" action="/team/invitation/<%= inv.id %>/decline" style="margin:0">
          <button type="submit" style="background:#c62828;color:#fff;border:none;padding:6px 14px;border-radius:4px;cursor:pointer">Decline</button>
        </form>
      </div>
    <% } %>
  </section>
<% } %>

<!-- ── My Teams ─────────────────────────────────────────────────────────── -->
<% if (teams.length === 0) { %>
  <p>You are not a member of any team yet.</p>
<% } else { %>
  <% for (const team of teams) { %>
    <section style="border:1px solid #ddd;border-radius:6px;padding:20px;margin-bottom:24px">

      <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
        <h2 style="margin:0"><%= team.name %></h2>
        <% if (team.isLeader) { %>
          <span style="background:#1a73e8;color:#fff;font-size:.78em;padding:2px 8px;border-radius:12px">Leader</span>
        <% } %>
      </div>

      <p style="margin:0 0 4px">
        <strong>Invite Code:</strong> <code><%= team.invite_code %></code> &nbsp;
        <a href="/team/join/<%= team.invite_code %>" style="font-size:.85em">Direct link</a>
      </p>
      <p style="margin:0 0 16px;color:#555;font-size:.9em">
        Leader: <strong><%= team.leader_name || '—' %></strong>
      </p>

      <!-- Member list -->
      <h3 style="margin:0 0 8px">Members (<%= team.members.length %>)</h3>
      <table style="width:100%;margin-bottom:16px">
        <thead>
          <tr>
            <th style="text-align:left">Name</th>
            <th style="text-align:left">Email</th>
            <th style="text-align:left">Role</th>
            <% if (team.isLeader && team.members.length > 1) { %><th></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% for (const m of team.members) { %>
            <tr>
              <td><%= m.name %></td>
              <td><%= m.email %></td>
              <td>
                <% if (m.id === team.leader_id) { %>
                  <span style="color:#1a73e8;font-weight:600">Leader</span>
                <% } else { %>
                  Member
                <% } %>
              </td>
              <% if (team.isLeader && team.members.length > 1) { %>
                <td style="white-space:nowrap">
                  <% if (m.id !== session.userId) { %>
                    <!-- Remove member -->
                    <form method="POST" action="/team/<%= team.id %>/remove/<%= m.id %>" style="display:inline"
                          onsubmit="return showConfirm(this)"
                          data-confirm-title="Remove Member"
                          data-confirm-message="Remove <%= m.name %> from the team? They can rejoin using the invite code."
                          data-confirm-ok="Remove"
                          data-confirm-level="danger">
                      <button type="submit" style="background:none;border:1px solid #c62828;color:#c62828;padding:3px 10px;border-radius:4px;cursor:pointer;font-size:.85em">Remove</button>
                    </form>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% } %>
        </tbody>
      </table>

      <!-- Leader-only actions -->
      <% if (team.isLeader) { %>
        <details style="margin-bottom:12px">
          <summary style="cursor:pointer;font-weight:600;color:#1a73e8;margin-bottom:8px">📨 Invite a Member</summary>
          <form method="POST" action="/team/<%= team.id %>/invite" class="form-narrow" style="margin-top:10px">
            <div class="form-group">
              <label>Participant Email</label>
              <input type="email" name="email" required placeholder="member@example.org"
                     list="participants-<%= team.id %>">
              <datalist id="participants-<%= team.id %>">
                <% for (const p of allParticipants) { %>
                  <option value="<%= p.email %>"><%= p.name %></option>
                <% } %>
              </datalist>
            </div>
            <button type="submit" class="btn-action">Send Invitation</button>
          </form>
          <% if (team.pendingInvites.length > 0) { %>
            <p style="margin-top:12px;font-size:.9em;color:#555"><strong>Pending sent invitations:</strong></p>
            <ul style="margin:0;padding-left:18px;font-size:.9em;color:#555">
              <% for (const pi of team.pendingInvites) { %>
                <li><%= pi.invitee_name %> (<%= pi.invitee_email %>)</li>
              <% } %>
            </ul>
          <% } %>
        </details>

        <% if (team.members.length > 1) { %>
          <details style="margin-bottom:12px">
            <summary style="cursor:pointer;font-weight:600;color:#1a73e8;margin-bottom:8px">👑 Transfer Leadership</summary>
            <form method="POST" action="/team/<%= team.id %>/leader" class="form-narrow" style="margin-top:10px"
                  onsubmit="return showConfirm(this)"
                  data-confirm-title="Transfer Leadership"
                  data-confirm-message="Are you sure? You will hand over leadership and can no longer manage the team unless the new leader transfers it back."
                  data-confirm-ok="Yes, Transfer"
                  data-confirm-level="warning">
              <div class="form-group">
                <label>New Leader</label>
                <select name="new_leader_id" required>
                  <option value="">— select member —</option>
                  <% for (const m of team.members) { %>
                    <% if (m.id !== session.userId) { %>
                      <option value="<%= m.id %>"><%= m.name %> (<%= m.email %>)</option>
                    <% } %>
                  <% } %>
                </select>
              </div>
              <button type="submit" style="background:#f9a825;color:#000;border:none;padding:8px 16px;border-radius:4px;cursor:pointer">
                Transfer Leadership
              </button>
            </form>
          </details>
        <% } %>
      <% } %>

      <!-- Leave team (any member) -->
      <form method="POST" action="/team/<%= team.id %>/leave"
            onsubmit="return showConfirm(this)"
            data-confirm-title="Leave Team"
            data-confirm-message="Are you sure you want to leave '<%= team.name %>'?<%= team.isLeader && team.members.length > 1 ? ' As leader, leadership will be auto-transferred to another member.' : team.members.length === 1 ? ' You are the only member — the team will be disbanded.' : '' %>"
            data-confirm-ok="Leave Team"
            data-confirm-level="danger">
        <button type="submit" style="background:none;border:1px solid #999;color:#555;padding:6px 16px;border-radius:4px;cursor:pointer">
          🚪 Leave Team
        </button>
      </form>

    </section>
  <% } %>
<% } %>

<hr style="margin:32px 0;border:0;border-top:1px solid #ccc">

<div style="margin-bottom:20px">
  <a href="/invite" class="btn-action">+ Join Team with Code</a>
</div>

<h2>Create a New Team</h2>
<form method="POST" action="/team" class="form-narrow">
  <input type="hidden" name="event_id" value="<%= typeof eventId !== 'undefined' ? eventId : 'evt_01' %>">
  <div class="form-group">
    <label for="name">Team Name</label>
    <input type="text" id="name" name="name" required maxlength="100" placeholder="e.g. Pixel Pioneers">
  </div>
  <button type="submit">Create Team</button>
</form>

<%- include('layouts/footer') %>
