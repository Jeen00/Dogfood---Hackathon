<%- include('layouts/header', {
  title: project.title,
  session,
  selectedJudgeEvent: typeof judgeAssignment !== 'undefined' && judgeAssignment && typeof selectedJudgeEvent !== 'undefined' ? selectedJudgeEvent : undefined
}) %>

<!-- ═══════════════════════════════════════════════════════════════
     PROJECT DETAIL PAGE
     ═══════════════════════════════════════════════════════════════ -->

<%
  var userLoggedIn = (typeof session !== 'undefined' && session);
  var isAssignedJudge = (typeof judgeAssignment !== 'undefined' && judgeAssignment);
  var hasScore = (typeof judgeScore !== 'undefined' && judgeScore);
  var statusClass = {
    'idea': 'badge-purple',
    'in_development': 'badge-orange',
    'submitted': 'badge-blue',
    'completed': 'badge-green',
    'live': 'badge-bright-green',
    'open_for_contributors': 'badge-teal'
  }[project.status] || 'badge-gray';
  var statusLabel = {
    'idea': 'Idea',
    'in_development': 'In Development',
    'submitted': 'Submitted',
    'completed': 'Completed',
    'live': 'Live',
    'open_for_contributors': 'Open for Contributors'
  }[project.status] || project.status;
  var diffClass = {
    'beginner': 'badge-green',
    'intermediate': 'badge-orange',
    'advanced': 'badge-red'
  }[project.difficulty] || 'badge-gray';
  var diffLabel = project.difficulty
    ? (project.difficulty.charAt(0).toUpperCase() + project.difficulty.slice(1))
    : 'Unknown';
  var techs       = (project.technologies && Array.isArray(project.technologies)) ? project.technologies : [];
  var tags        = (project.tags && Array.isArray(project.tags)) ? project.tags : [];
  var skills      = (project.required_skills && Array.isArray(project.required_skills)) ? project.required_skills : [];
  var screenshots = (project.screenshots && Array.isArray(project.screenshots)) ? project.screenshots : [];
  var trackHue    = project.track_id ? ((project.track_id * 47) % 360) : 210;
%>

<style>
  /* ── Extra Detail Styles for Screenshots, Video, Sharing & Safety ── */
  .detail-actions-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    position: relative;
  }
  .btn-share-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border: 2px solid #1A1A1A;
    padding: 8px 14px;
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    text-decoration: none;
    color: #1A1A1A;
    box-shadow: 2px 2px 0 #1A1A1A;
    transition: all 0.15s;
  }
  .btn-share-trigger:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #1A1A1A;
  }
  .btn-report-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border: 1.5px solid #DC2626;
    color: #DC2626;
    padding: 8px 12px;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 2px 2px 0 #DC2626;
    transition: all 0.15s;
  }
  .btn-report-trigger:hover {
    background: #FEF2F2;
  }

  /* Share Dropdown Menu */
  .share-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 8px;
    background: #fff;
    border: 2px solid #1A1A1A;
    box-shadow: 4px 4px 0 #1A1A1A;
    padding: 12px;
    z-index: 100;
    min-width: 240px;
  }
  .share-dropdown-menu.active {
    display: block;
  }
  .share-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    color: #1A1A1A;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.1s;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    box-sizing: border-box;
  }
  .share-option:hover {
    background: #F1F5F9;
  }

  /* Screenshots Grid */
  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 12px;
  }
  .screenshot-card {
    border: 2px solid #1A1A1A;
    box-shadow: 3px 3px 0 #1A1A1A;
    overflow: hidden;
    background: #000;
    cursor: pointer;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .screenshot-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s;
  }
  .screenshot-card:hover img {
    transform: scale(1.03);
  }

  /* Video Embed Container */
  .video-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    max-width: 100%;
    border: 2px solid #1A1A1A;
    box-shadow: 4px 4px 0 #1A1A1A;
    background: #000;
    margin-top: 12px;
  }
  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Threaded Comments & Replies */
  .comment-replies-list {
    margin-left: 28px;
    padding-left: 14px;
    border-left: 2px dashed #CBD5E1;
    margin-top: 12px;
  }
  .reply-card {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 10px 14px;
    margin-bottom: 8px;
  }
  .reply-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    margin-bottom: 4px;
  }
  .btn-reply-toggle {
    background: none;
    border: none;
    color: #1A73E8;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0;
    margin-top: 6px;
    text-decoration: underline;
  }
  .reply-form-wrap {
    display: none;
    margin-top: 10px;
    background: #F1F5F9;
    padding: 10px;
    border: 1px solid #CBD5E1;
  }
  .reply-form-wrap.active {
    display: block;
  }

  /* Modal Generic */
  .modal-backdrop {
    display: none;
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9999;
    align-items: center;
    justify-content: center;
  }
  .modal-backdrop.active {
    display: flex;
  }
  .modal-box {
    background: #fff;
    border: 3px solid #1A1A1A;
    box-shadow: 6px 6px 0 #1A1A1A;
    max-width: 450px;
    width: 90%;
    padding: 24px;
    position: relative;
  }
  .modal-close-btn {
    position: absolute;
    top: 14px; right: 14px;
    background: none; border: none;
    font-size: 1.25rem; font-weight: bold;
    cursor: pointer;
  }
</style>

<!-- Breadcrumb -->
<nav class="breadcrumb" aria-label="Breadcrumb">
  <% if (isAssignedJudge && typeof selectedJudgeEvent !== 'undefined' && selectedJudgeEvent) { %>
    <a href="/judge/events">All Events</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/judge/assignments?event_id=<%= selectedJudgeEvent.id %>">My Assignments</a>
    <span class="breadcrumb-sep">›</span>
    <span><%= project.title %></span>
  <% } else { %>
    <a href="/projects">Gallery</a>
    <span class="breadcrumb-sep">›</span>
    <span><%= project.title %></span>
  <% } %>
</nav>

<!-- ── Project Header ─────────────────────────────────────────────── -->
<div class="detail-header">
  <div class="detail-track-banner" style="background:hsl(<%= trackHue %>,55%,50%)"></div>

  <div class="detail-header-body">
    <h1 class="detail-title"><%= project.title %></h1>

    <!-- Badges -->
    <div class="detail-badges">
      <span class="badge badge-track" style="background:hsl(<%= trackHue %>,55%,92%);color:hsl(<%= trackHue %>,55%,30%)"><%= project.track_name || 'General' %></span>
      <span class="badge <%= diffClass %>"><%= diffLabel %></span>
      <span class="badge <%= statusClass %>"><%= statusLabel %></span>
    </div>

    <!-- Description -->
    <% if (project.summary) { %>
    <p class="detail-description"><%= project.summary %></p>
    <% } %>

    <!-- Stats row -->
    <div class="detail-stats">
      <span title="Views">👁 <strong><%= project.view_count || 0 %></strong> Views</span>
      <span class="stats-sep">·</span>
      <span title="Votes">👍 <strong id="detail-vote-count"><%= project.vote_count || 0 %></strong> Votes</span>
      <span class="stats-sep">·</span>
      <span title="Saves">🔖 <strong id="detail-save-count"><%= project.save_count || 0 %></strong> Saves</span>
      <span class="stats-sep">·</span>
      <span title="Comments">💬 <strong><%= (comments && comments.length) || 0 %></strong> Discussions</span>
    </div>

    <!-- Voting Closed & Results Published Banner -->
    <% if (typeof votingClosed !== 'undefined' && votingClosed) { %>
    <div style="background: #FFFBEB; border: 2px solid #D97706; border-left: 6px solid #D97706; padding: 12px 16px; margin: 16px 0 6px 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
      <div>
        <strong style="color: #92400E; font-size: 0.95rem; display: block;">🏆 Voting has Concluded!</strong>
        <span style="color: #B45309; font-size: 0.85rem;">Official evaluations and winner standings are now published.</span>
      </div>
      <a href="/results" style="background: #D97706; color: #fff; padding: 7px 14px; font-weight: bold; text-decoration: none; border-radius: 4px; font-size: 0.85rem; box-shadow: 2px 2px 0 #92400E;">
        View Leaderboard & Awards →
      </a>
    </div>
    <% } %>

    <!-- Action buttons (Vote, Save, Links, Sharing, Safety Report) -->
    <div class="detail-actions-wrap">
      <% if (typeof votingClosed !== 'undefined' && votingClosed) { %>
      <button
        class="btn-vote-detail"
        disabled
        style="opacity: 0.65; cursor: not-allowed; background: #E2E8F0; color: #475569;"
        title="Voting has concluded for this event"
      ><span class="action-icon">🔒</span> <span>Voting Closed</span></button>
      <% } else if (typeof votingNotStarted !== 'undefined' && votingNotStarted) { %>
      <button
        class="btn-vote-detail"
        disabled
        style="opacity: 0.75; cursor: not-allowed; background: #E2E8F0; color: #475569;"
        title="Voting opens soon"
      ><span class="action-icon">⏳</span> <span>Voting Opens Soon</span></button>
      <% } else { %>
      <button
        id="detailVoteBtn"
        class="btn-vote-detail <%= project.user_voted ? 'active' : '' %>"
        data-id="<%= project.id %>"
        data-action="vote"
        title="<%= userLoggedIn ? 'Vote for this project' : 'Login to vote' %>"
      ><span class="action-icon">👍</span> <span id="detail-vote-label"><%= project.user_voted ? 'Voted' : 'Vote' %></span></button>
      <% } %>

      <button
        id="detailSaveBtn"
        class="btn-save-detail <%= project.user_saved ? 'active' : '' %>"
        data-id="<%= project.id %>"
        data-action="save"
        title="<%= userLoggedIn ? 'Save this project' : 'Login to save' %>"
      ><span class="action-icon">🔖</span> <span id="detail-save-label"><%= project.user_saved ? 'Saved' : 'Save' %></span></button>

      <% if (project.live_demo_url) { %>
      <a href="<%= project.live_demo_url %>" target="_blank" rel="noopener" class="btn-action-outline btn-demo">🔗 Live Demo</a>
      <% } %>

      <% if (project.repo_url) { %>
      <a href="<%= project.repo_url %>" target="_blank" rel="noopener" class="btn-action-outline btn-github">⬛ GitHub</a>
      <% } %>

      <!-- 🔗 SHARING: Share Dropdown -->
      <div style="position: relative; display: inline-block;">
        <button id="shareTriggerBtn" class="btn-share-trigger" type="button">
          🔗 Share ▾
        </button>
        <div id="shareDropdown" class="share-dropdown-menu">
          <button type="button" class="share-option" onclick="copyProjectLink()">
            📋 Copy Link
          </button>
          <button type="button" class="share-option" onclick="openQrModal()">
            📱 QR Code
          </button>
          <hr style="border: none; border-top: 1px solid #E2E8F0; margin: 4px 0;">
          <a class="share-option" href="https://twitter.com/intent/tweet?text=Check%20out%20<%= encodeURIComponent(project.title) %>%20on%20Dogfood%20Hackathon!&url=<%= encodeURIComponent('http://localhost:8080/projects/' + project.id) %>" target="_blank" rel="noopener">
            🐦 Share on X (Twitter)
          </a>
          <a class="share-option" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent('http://localhost:8080/projects/' + project.id) %>" target="_blank" rel="noopener">
            💼 Share on LinkedIn
          </a>
          <a class="share-option" href="https://api.whatsapp.com/send?text=<%= encodeURIComponent('Check out ' + project.title + ': http://localhost:8080/projects/' + project.id) %>" target="_blank" rel="noopener">
            💬 Share on WhatsApp
          </a>
          <a class="share-option" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('http://localhost:8080/projects/' + project.id) %>" target="_blank" rel="noopener">
            📘 Share on Facebook
          </a>
        </div>
      </div>

      <!-- 🛡️ COMMUNITY / SAFETY: Report Project -->
      <button class="btn-report-trigger" onclick="openReportModal(null)" type="button">
        🚩 Report
      </button>
    </div>

    <!-- Open source indicator -->
    <% if (project.open_source) { %>
    <div class="detail-opensource" style="margin-top: 14px;">
      🔓 <strong>Open Source</strong><% if (project.license) { %> · License: <code><%= project.license %></code><% } %>
    </div>
    <% } %>
  </div>
</div>

<!-- ── Main + Sidebar two-column ─────────────────────────────────── -->
<div class="detail-layout">
  <div class="detail-content">

    <!-- Description -->
    <% if (project.summary) { %>
    <section class="detail-section">
      <h2>Description</h2>
      <p style="font-size: 1.05rem; line-height: 1.6; color: #333;"><%= project.summary %></p>
    </section>
    <% } %>

    <!-- Problem Statement -->
    <% if (project.problem_statement) { %>
    <section class="detail-section">
      <h2>Problem</h2>
      <p style="font-size: 1rem; line-height: 1.6;"><%= project.problem_statement %></p>
    </section>
    <% } %>

    <!-- Solution -->
    <% if (project.solution) { %>
    <section class="detail-section">
      <h2>Solution</h2>
      <p style="font-size: 1rem; line-height: 1.6;"><%= project.solution %></p>
    </section>
    <% } %>

    <!-- Technologies -->
    <% if (techs.length > 0) { %>
    <section class="detail-section">
      <h2>Technologies</h2>
      <div class="badge-group">
        <% techs.forEach(function(t) { %><span class="badge badge-tech"><%= t %></span><% }) %>
      </div>
    </section>
    <% } %>

    <!-- Tags -->
    <% if (tags.length > 0) { %>
    <section class="detail-section">
      <h2>Tags</h2>
      <div class="badge-group">
        <% tags.forEach(function(tag) { %><span class="tag-chip">#<%= tag %></span><% }) %>
      </div>
    </section>
    <% } %>

    <!-- Screenshots -->
    <% if (screenshots.length > 0) { %>
    <section class="detail-section">
      <h2>Screenshots</h2>
      <div class="screenshots-grid">
        <% screenshots.forEach(function(shot, idx) { %>
        <div class="screenshot-card" onclick="window.open('<%= shot %>', '_blank')">
          <img src="<%= shot %>" alt="Screenshot <%= idx + 1 %>" loading="lazy">
        </div>
        <% }); %>
      </div>
    </section>
    <% } %>

    <!-- Demo Video -->
    <% if (project.demo_video_url) { %>
    <section class="detail-section">
      <h2>Demo Video</h2>
      <%
        var ytMatch = project.demo_video_url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
        if (ytMatch && ytMatch[1]) {
      %>
      <div class="video-container">
        <iframe src="https://www.youtube.com/embed/<%= ytMatch[1] %>" frameborder="0" allowfullscreen></iframe>
      </div>
      <% } else { %>
      <div class="repo-block">
        <a href="<%= project.demo_video_url %>" target="_blank" rel="noopener" class="repo-link">🎥 Watch Demo Video (<%= project.demo_video_url %>)</a>
      </div>
      <% } %>
    </section>
    <% } %>

    <!-- GitHub -->
    <% if (project.repo_url) { %>
    <section class="detail-section">
      <h2>GitHub</h2>
      <div class="repo-block">
        <a href="<%= project.repo_url %>" target="_blank" rel="noopener" class="repo-link">⬛ <%= project.repo_url %></a>
        <% if (project.open_source) { %>
        <span class="badge badge-green" style="margin-left:12px">Open Source</span>
        <% if (project.license) { %><code style="margin-left:8px"><%= project.license %></code><% } %>
        <% } %>
      </div>
    </section>
    <% } %>

    <!-- Live Demo -->
    <% if (project.live_demo_url) { %>
    <section class="detail-section">
      <h2>Live Demo</h2>
      <div class="repo-block">
        <a href="<%= project.live_demo_url %>" target="_blank" rel="noopener" class="repo-link">🔗 <%= project.live_demo_url %></a>
      </div>
    </section>
    <% } %>

    <!-- ❤️ COMMUNITY: Discussions, Comments & Threaded Replies -->
    <section class="detail-section" id="comments">
      <h2>Discussions (<%= (comments && comments.length) || 0 %>)</h2>

      <% if (comments && comments.length > 0) { %>
      <div class="comments-list" id="commentsList">
        <% comments.forEach(function(c) { %>
        <div class="comment-card" id="comment-<%= c.id %>">
          <div class="comment-meta">
            <strong class="comment-author"><%= c.author_name || 'Anonymous' %></strong>
            <div>
              <span class="comment-date"><%= new Date(c.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
              <button type="button" onclick="openReportModal('<%= c.id %>')" style="background:none; border:none; color:#DC2626; cursor:pointer; font-size:0.75rem; margin-left:8px;">🚩 Report</button>
            </div>
          </div>
          <p class="comment-content"><%= c.content %></p>

          <% if (userLoggedIn) { %>
          <button type="button" class="btn-reply-toggle" onclick="toggleReplyBox('<%= c.id %>')">💬 Reply</button>
          
          <div id="replyBox-<%= c.id %>" class="reply-form-wrap">
            <form onsubmit="submitReply(event, '<%= c.id %>')">
              <input type="text" id="replyInput-<%= c.id %>" placeholder="Write a reply…" required style="width: 100%; box-sizing: border-box; padding: 6px 10px; margin-bottom: 6px; border: 1px solid #94A3B8;">
              <div style="display:flex; justify-content:flex-end; gap:6px;">
                <button type="button" onclick="toggleReplyBox('<%= c.id %>')" style="background:#E2E8F0; border:none; padding:4px 8px; font-size:0.75rem; cursor:pointer;">Cancel</button>
                <button type="submit" style="background:#1A1A1A; color:#fff; border:none; padding:4px 10px; font-size:0.75rem; font-weight:bold; cursor:pointer;">Post Reply</button>
              </div>
            </form>
          </div>
          <% } %>

          <!-- Threaded Replies -->
          <% if (c.replies && c.replies.length > 0) { %>
          <div class="comment-replies-list" id="replies-<%= c.id %>">
            <% c.replies.forEach(function(rep) { %>
            <div class="reply-card">
              <div class="reply-meta">
                <strong><%= rep.author_name || 'Anonymous' %></strong>
                <div>
                  <span><%= new Date(rep.created_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></span>
                  <button type="button" onclick="openReportModal('<%= rep.id %>')" style="background:none; border:none; color:#DC2626; cursor:pointer; font-size:0.7rem; margin-left:6px;">🚩</button>
                </div>
              </div>
              <p style="margin: 0; font-size: 0.9rem;"><%= rep.content %></p>
            </div>
            <% }); %>
          </div>
          <% } else { %>
          <div class="comment-replies-list" id="replies-<%= c.id %>" style="display:none;"></div>
          <% } %>

        </div>
        <% }) %>
      </div>
      <% } else { %>
      <div class="comments-empty">No comments yet. Be the first to start a discussion!</div>
      <% } %>

      <!-- Add comment -->
      <% if (userLoggedIn) { %>
      <div class="comment-form-wrap" style="margin-top: 24px;">
        <h3>Add a Comment</h3>
        <form id="commentForm" class="comment-form">
          <textarea
            id="commentText"
            name="content"
            rows="3"
            placeholder="Share your thoughts, feedback, or questions…"
            required
          ></textarea>
          <div id="commentError" class="comment-error" aria-live="polite" style="color: #DC2626; font-size: 0.85rem; margin-top: 4px;"></div>
          <button type="submit" class="btn-comment-submit">Post Comment</button>
        </form>
      </div>
      <% } else { %>
      <div class="comment-login-prompt" style="margin-top: 24px;">
        <a href="/login" style="font-weight: bold; color: #1A73E8;">Login</a> to join the discussion.
      </div>
      <% } %>
    </section>

  </div><!-- /.detail-content -->

  <!-- ── Detail Sidebar ─────────────────────────────────────────── -->
  <aside class="detail-sidebar">

    <!-- ===== JUDGE PANEL (only visible to assigned judges) ===== -->
    <% if (isAssignedJudge) { %>
    <%
      var aStatus = judgeAssignment.assignment_status || judgeAssignment.status || 'pending';
      var panelBg = '#fff';
      var panelBorder = '#1A1A1A';
      var panelAccent = '#1A1A1A';
      var statusPill = '⏳ Pending';
      if (hasScore) {
        panelBg = '#f0fdf4'; panelBorder = '#34A853'; panelAccent = '#15803d'; statusPill = '✅ Scored';
      } else if (aStatus === 'in_progress') {
        panelBg = '#EFF6FF'; panelBorder = '#1A73E8'; panelAccent = '#1d4ed8'; statusPill = '🔵 In Progress';
      } else if (aStatus === 'needs_review') {
        panelBg = '#fff7ed'; panelBorder = '#f97316'; panelAccent = '#c2410c'; statusPill = '🔄 Re-evaluation';
      } else if (aStatus === 'conflict') {
        panelBg = '#fef2f2'; panelBorder = '#ef4444'; panelAccent = '#b91c1c'; statusPill = '⚠️ Conflict Declared';
      }
    %>
    <div style="background:<%= panelBg %>; border:2px solid <%= panelBorder %>; padding:18px 18px 16px; margin-bottom:20px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:8px;">
        <div style="font-size:0.75rem; font-weight:bold; text-transform:uppercase; letter-spacing:0.06em; color:<%= panelAccent %>;">
          ⚖️ Judge Panel
        </div>
        <span style="background:<%= panelBg %>; border:1.5px solid <%= panelBorder %>; color:<%= panelAccent %>; font-size:0.75rem; font-weight:bold; padding:2px 10px;">
          <%= statusPill %>
        </span>
      </div>

      <% if (aStatus === 'conflict') { %>
        <div style="font-size:0.84rem; color:#b91c1c; margin-bottom:14px; font-weight:500;">
          You declared a conflict of interest for this project.<br>
          <span style="font-size:0.75rem; color:#666;">Reason: <%= judgeAssignment.conflict_reason || 'None provided' %></span>
        </div>
      <% } else { %>
        <% if (hasScore) { %>
          <div style="margin-bottom:14px;">
            <div style="font-size:0.8rem; font-weight:bold; color:#555; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.04em;">Your Score</div>
            <% if (judgeScore.criteria_scores && typeof judgeScore.criteria_scores === 'object') { %>
              <table style="width:100%; font-size:0.82rem; border-collapse:collapse;">
                <% Object.entries(judgeScore.criteria_scores).forEach(function([k, v]) { %>
                <tr>
                  <td style="padding:3px 0; color:#555; text-transform:capitalize;"><%= k %></td>
                  <td style="padding:3px 0; text-align:right; font-weight:bold; color:<%= panelAccent %>;">
                    <%= v %><span style="color:#aaa; font-weight:normal;">/5</span>
                  </td>
                </tr>
                <% }); %>
              </table>
            <% } %>
            <% if (judgeScore.comment) { %>
            <div style="margin-top:10px; padding:8px 10px; background:rgba(0,0,0,0.04); border-left:3px solid <%= panelBorder %>; font-size:0.8rem; color:#444; line-height:1.45;">
              <em>"<%= judgeScore.comment %>"</em>
            </div>
            <% } %>
            <% if (judgeScore.submitted_at) { %>
            <div style="margin-top:8px; font-size:0.75rem; color:#888;">
              Scored: <%= judgeScore.submitted_at.slice(0,10) %>
            </div>
            <% } %>
          </div>
        <% } else { %>
          <div style="font-size:0.84rem; color:#666; margin-bottom:14px;">
            You haven't scored this project yet.<br>
            <% if (aStatus === 'in_progress') { %>
              <span style="color:<%= panelAccent %>; font-weight:bold;">Ready to score when you are.</span>
            <% } else { %>
              Review the project details below, then submit your score.
            <% } %>
          </div>
        <% } %>

        <a href="/judge/score/<%= project.id %>"
          style="display:block; text-align:center; background:<%= panelAccent %>; color:#fff; font-weight:bold; font-size:0.92rem; padding:11px 16px; text-decoration:none; border:2px solid <%= panelBorder %>; margin-bottom:12px;">
          <%= hasScore ? '✏️ Edit Score' : '⚖️ Score This Project' %>
        </a>

        <div style="margin-bottom:12px;">
          <label style="display:block; font-size:0.75rem; font-weight:bold; color:#555; margin-bottom:4px; text-transform:uppercase; letter-spacing:0.04em;">📝 Private Notes</label>
          <textarea id="judgeNotes" rows="2" placeholder="Jot down notes while reviewing..."
            style="width:100%; box-sizing:border-box; padding:8px; font-size:0.8rem; border:1px solid #ccc; font-family:inherit; margin-bottom:4px;"
            onblur="saveJudgeNotes('<%= project.id %>', this.value)"><%= judgeAssignment.notes || '' %></textarea>
          <div id="notesStatus" style="font-size:0.7rem; color:#888; text-align:right; min-height:14px;"></div>
        </div>

        <% if (hasScore) { %>
        <% if (aStatus !== 'needs_review') { %>
        <button onclick="flagProjectReview('<%= project.id %>', this)"
          style="display:block; width:100%; text-align:center; background:#fff7ed; color:#c2410c; border:1.5px solid #fed7aa; font-size:0.82rem; font-weight:bold; padding:7px 12px; cursor:pointer; margin-top:8px;">
          🔄 Flag for Re-evaluation
        </button>
        <% } else { %>
        <div style="text-align:center; font-size:0.8rem; color:#c2410c; margin-top:8px; font-weight:bold;">
          🔄 Flagged for Re-evaluation
        </div>
        <% } %>
        <% } %>

        <button onclick="declareConflict('<%= project.id %>', this)"
          style="display:block; width:100%; text-align:center; background:none; color:#ef4444; border:none; font-size:0.75rem; text-decoration:underline; cursor:pointer; margin-top:12px;">
          Declare Conflict of Interest
        </button>
      <% } %>
    </div>
    <% } %>
    <!-- ===== END JUDGE PANEL ===== -->

    <!-- Project Information table -->
    <div class="detail-info-card">
      <div class="detail-info-title">Project Information</div>
      <table class="detail-table">
        <tbody>
          <tr><th>Track</th><td><%= project.track_name || '—' %></td></tr>
          <tr><th>Difficulty</th><td><span class="badge <%= diffClass %>"><%= diffLabel %></span></td></tr>
          <tr><th>Team Name</th><td><strong><%= project.team_name || '—' %></strong></td></tr>
          <tr><th>Team Size</th><td><%= (members && members.length) ? members.length + ' member' + (members.length !== 1 ? 's' : '') : '—' %></td></tr>
          <tr><th>Status</th><td><span class="badge <%= statusClass %>"><%= statusLabel %></span></td></tr>
          <% if (project.build_time) { %><tr><th>Build Time</th><td><%= project.build_time %></td></tr><% } %>
          <tr><th>License</th><td><%= project.license || '—' %></td></tr>
          <tr><th>Contributors</th><td><%= project.looking_for_contributors ? '✅ Yes' : '❌ No' %></td></tr>
          <tr><th>Submitted</th><td><%= project.submitted_at ? new Date(project.submitted_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '—' %></td></tr>
          <tr><th>Updated</th><td><%= project.updated_at ? new Date(project.updated_at).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '—' %></td></tr>
        </tbody>
      </table>
    </div>

    <!-- 👥 TEAM: Team Name, Members, Roles, Team Size -->
    <% if (members && members.length > 0) { %>
    <div class="detail-info-card">
      <div class="detail-info-title">Team Members (👥 Team: <%= project.team_name %>)</div>
      <div style="font-size:0.8rem; color:#666; margin-bottom:12px; font-weight:600;">
        Team Size: <%= members.length %> member<%= members.length !== 1 ? 's' : '' %>
      </div>
      <ul class="team-list">
        <% members.forEach(function(m) { %>
        <li class="team-member" style="display:flex; justify-content:space-between; align-items:center; padding: 8px 0; border-bottom: 1px solid #F1F5F9;">
          <div style="display:flex; align-items:center; gap:8px;">
            <span class="team-avatar"><%= (m.name || 'U').charAt(0).toUpperCase() %></span>
            <div class="team-member-info">
              <strong><%= m.name %></strong>
              <% if (m.email) { %><span class="team-email" style="display:block; font-size:0.75rem; color:#666;"><%= m.email %></span><% } %>
            </div>
          </div>
          <span class="badge" style="background:#E0F2FE; color:#0369A1; font-size:0.75rem; font-weight:700;">
            <%= m.role %>
          </span>
        </li>
        <% }) %>
      </ul>
    </div>
    <% } %>
  </aside>
</div><!-- /.detail-layout -->

<!-- ── Similar Projects ───────────────────────────────────────────── -->
<% if (similar && similar.length > 0) { %>
<section class="detail-section similar-section">
  <h2>Similar Projects</h2>
  <div class="similar-grid">
    <% similar.forEach(function(sp, si) { %>
    <%
      var spHue = sp.track_id ? ((sp.track_id * 47) % 360) : (si * 60 % 360);
      var spStatusClass = {
        'idea':'badge-purple','in_development':'badge-orange','submitted':'badge-blue',
        'completed':'badge-green','live':'badge-bright-green','open_for_contributors':'badge-teal'
      }[sp.status] || 'badge-gray';
    %>
    <a href="/projects/<%= sp.id %>" class="similar-card">
      <div class="track-banner" style="background:hsl(<%= spHue %>,55%,50%);height:4px"></div>
      <div class="similar-card-body">
        <div class="similar-card-title"><%= sp.title %></div>
        <div class="similar-card-meta">
          <span class="badge badge-track" style="background:hsl(<%= spHue %>,55%,92%);color:hsl(<%= spHue %>,55%,30%)"><%= sp.track_name || 'General' %></span>
          <span class="badge <%= spStatusClass %>"><%= sp.status || '' %></span>
        </div>
        <div class="similar-card-stats">
          <span>👍 <%= sp.vote_count || 0 %></span>
          <span>👁 <%= sp.view_count || 0 %></span>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
</section>
<% } %>

<!-- ── 🔗 SHARING: QR Code Modal ──────────────────────────────────── -->
<div id="qrModal" class="modal-backdrop">
  <div class="modal-box" style="text-align: center;">
    <button class="modal-close-btn" onclick="closeQrModal()">&times;</button>
    <h3 style="margin: 0 0 8px 0;">📱 Scan to View Project</h3>
    <p style="font-size: 0.88rem; color: #666; margin-bottom: 16px;">Scan this QR code with your mobile camera to view on your phone</p>
    <div style="background: #fff; padding: 12px; display: inline-block; border: 2px solid #1A1A1A;">
      <img id="qrImage" src="" alt="QR Code" width="220" height="220" style="display:block;">
    </div>
    <div style="margin-top: 14px;">
      <button type="button" onclick="copyProjectLink()" style="background: #1A1A1A; color:#fff; border:none; padding:8px 16px; font-weight:bold; cursor:pointer;">
        📋 Copy Direct Link
      </button>
    </div>
  </div>
</div>

<!-- ── 🛡️ COMMUNITY / SAFETY: Report Modal ────────────────────────── -->
<div id="reportModal" class="modal-backdrop">
  <div class="modal-box">
    <button class="modal-close-btn" onclick="closeReportModal()">&times;</button>
    <h3 style="margin: 0 0 6px 0; color: #DC2626;">🚩 Report Project / Content</h3>
    <p style="font-size: 0.85rem; color: #666; margin-bottom: 16px;">Help keep our community safe. Please tell us why you are reporting this content.</p>
    <form id="reportForm" onsubmit="submitReport(event)">
      <input type="hidden" id="reportCommentId" value="">
      <div style="margin-bottom: 12px;">
        <label style="display:block; font-size:0.85rem; font-weight:bold; margin-bottom:4px;">Reason for Report *</label>
        <select id="reportReason" required style="width:100%; padding:8px; border:2px solid #1A1A1A;">
          <option value="">Select a reason</option>
          <option value="Spam or Advertising">Spam or Advertising</option>
          <option value="Inappropriate Content">Inappropriate Content</option>
          <option value="Plagiarism / Intellectual Property">Plagiarism / Intellectual Property</option>
          <option value="Harassment or Abusive Behavior">Harassment or Abusive Behavior</option>
          <option value="Other Policy Violation">Other Policy Violation</option>
        </select>
      </div>
      <div style="margin-bottom: 16px;">
        <label style="display:block; font-size:0.85rem; font-weight:bold; margin-bottom:4px;">Additional Details (Optional)</label>
        <textarea id="reportDetails" rows="3" placeholder="Provide any extra context..." style="width:100%; box-sizing:border-box; padding:8px; border:1px solid #ccc;"></textarea>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px;">
        <button type="button" onclick="closeReportModal()" style="background:#E2E8F0; border:none; padding:8px 14px; font-weight:bold; cursor:pointer;">Cancel</button>
        <button type="submit" id="reportSubmitBtn" style="background:#DC2626; color:#fff; border:none; padding:8px 18px; font-weight:bold; cursor:pointer;">Submit Report</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Tooltip ────────────────────────────────────────────────────── -->
<div class="vote-tooltip" id="voteTooltip" role="alert" aria-live="polite"></div>

<script>
(function () {
  var PROJECT_ID  = '<%= project.id %>';
  var loggedIn    = <%= userLoggedIn ? 'true' : 'false' %>;

  var tooltip = document.getElementById('voteTooltip');
  function showTooltip(msg, x, y) {
    tooltip.textContent = msg;
    tooltip.style.left  = x + 'px';
    tooltip.style.top   = (y - 44) + 'px';
    tooltip.classList.add('visible');
    clearTimeout(tooltip._t);
    tooltip._t = setTimeout(function () { tooltip.classList.remove('visible'); }, 2500);
  }

  /* ── Vote button with Safety & Self-Vote / Duplicate Protection ── */
  var voteBtn   = document.getElementById('detailVoteBtn');
  var voteCount = document.getElementById('detail-vote-count');
  var voteLabel = document.getElementById('detail-vote-label');
  if (voteBtn) {
    voteBtn.addEventListener('click', function (e) {
      e.preventDefault();
      var rect = voteBtn.getBoundingClientRect();
      if (!loggedIn) { showTooltip('Login to vote', rect.left + window.scrollX, rect.top + window.scrollY); return; }
      
      voteBtn.disabled = true;
      fetch('/projects/' + PROJECT_ID + '/vote', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      }).then(function(r) {
        return r.json().then(function(d) { return { status: r.status, data: d }; });
      }).then(function(res) {
        voteBtn.disabled = false;
        if (res.status === 403 || res.status === 429) {
          showTooltip(res.data.error || 'Vote failed.', rect.left + window.scrollX, rect.top + window.scrollY);
          return;
        }
        if (res.data.error) {
          showTooltip(res.data.error, rect.left + window.scrollX, rect.top + window.scrollY);
          return;
        }
        voteBtn.classList.toggle('active', !!res.data.voted);
        if (voteCount) voteCount.textContent = res.data.count;
        if (voteLabel) voteLabel.textContent = res.data.voted ? 'Voted' : 'Vote';
      }).catch(function () {
        voteBtn.disabled = false;
        showTooltip('Something went wrong.', rect.left + window.scrollX, rect.top + window.scrollY);
      });
    });
  }

  /* ── Save button ── */
  var saveBtn   = document.getElementById('detailSaveBtn');
  var saveCount = document.getElementById('detail-save-count');
  var saveLabel = document.getElementById('detail-save-label');
  if (saveBtn) {
    saveBtn.addEventListener('click', function (e) {
      e.preventDefault();
      var rect = saveBtn.getBoundingClientRect();
      if (!loggedIn) { showTooltip('Login to save', rect.left + window.scrollX, rect.top + window.scrollY); return; }
      fetch('/projects/' + PROJECT_ID + '/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      }).then(function(r) { return r.json(); }).then(function(data) {
        saveBtn.classList.toggle('active', !!data.saved);
        if (saveCount) saveCount.textContent = data.count;
        if (saveLabel) saveLabel.textContent  = data.saved ? 'Saved' : 'Save';
      }).catch(function () { showTooltip('Something went wrong.', rect.left + window.scrollX, rect.top + window.scrollY); });
    });
  }

  /* ── Comment form with Safety & Spam Protection ── */
  var commentForm = document.getElementById('commentForm');
  var commentText = document.getElementById('commentText');
  var commentList = document.getElementById('commentsList');
  var commentErr  = document.getElementById('commentError');

  if (commentForm) {
    commentForm.addEventListener('submit', function (e) {
      e.preventDefault();
      var content = commentText.value.trim();
      if (!content) { commentErr.textContent = 'Comment cannot be empty.'; return; }
      commentErr.textContent = '';
      var submitBtn = commentForm.querySelector('button[type="submit"]');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Posting…';

      fetch('/projects/' + PROJECT_ID + '/comment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin',
        body: JSON.stringify({ content: content })
      })
      .then(function (r) {
        return r.json().then(function(d) { return { ok: r.ok, data: d }; });
      })
      .then(function (res) {
        if (!res.ok) {
          commentErr.textContent = res.data.error || 'Failed to post comment.';
          return;
        }
        var data = res.data;
        if (!commentList) {
          var emptyMsg = document.querySelector('.comments-empty');
          if (emptyMsg) emptyMsg.remove();
          var newList = document.createElement('div');
          newList.className = 'comments-list';
          newList.id = 'commentsList';
          commentForm.closest('.detail-section').insertBefore(newList, document.querySelector('.comment-form-wrap'));
          commentList = newList;
        }
        var card = document.createElement('div');
        card.className = 'comment-card comment-card-new';
        card.id = 'comment-' + data.id;
        var author = data.author || '<%= userLoggedIn && session ? session.name || "You" : "You" %>';
        card.innerHTML =
          '<div class="comment-meta">' +
            '<strong class="comment-author">' + author + '</strong>' +
            '<div>' +
              '<span class="comment-date">Just now</span>' +
              '<button type="button" onclick="openReportModal(\'' + data.id + '\')" style="background:none; border:none; color:#DC2626; cursor:pointer; font-size:0.75rem; margin-left:8px;">🚩 Report</button>' +
            '</div>' +
          '</div>' +
          '<p class="comment-content">' + content.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</p>' +
          '<button type="button" class="btn-reply-toggle" onclick="toggleReplyBox(\'' + data.id + '\')">💬 Reply</button>' +
          '<div id="replyBox-' + data.id + '" class="reply-form-wrap">' +
            '<form onsubmit="submitReply(event, \'' + data.id + '\')">' +
              '<input type="text" id="replyInput-' + data.id + '" placeholder="Write a reply…" required style="width: 100%; box-sizing: border-box; padding: 6px 10px; margin-bottom: 6px; border: 1px solid #94A3B8;">' +
              '<div style="display:flex; justify-content:flex-end; gap:6px;">' +
                '<button type="button" onclick="toggleReplyBox(\'' + data.id + '\')" style="background:#E2E8F0; border:none; padding:4px 8px; font-size:0.75rem; cursor:pointer;">Cancel</button>' +
                '<button type="submit" style="background:#1A1A1A; color:#fff; border:none; padding:4px 10px; font-size:0.75rem; font-weight:bold; cursor:pointer;">Post Reply</button>' +
              '</div>' +
            '</form>' +
          '</div>' +
          '<div class="comment-replies-list" id="replies-' + data.id + '" style="display:none;"></div>';
        commentList.insertBefore(card, commentList.firstChild);
        commentText.value = '';

        var statsComment = document.querySelector('.detail-stats span[title="Comments"] strong');
        if (statsComment) statsComment.textContent = parseInt(statsComment.textContent || '0') + 1;
      })
      .catch(function () {
        commentErr.textContent = 'Failed to post comment. Please try again.';
      })
      .finally(function () {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Post Comment';
      });
    });
  }

  /* ── Share dropdown toggle ── */
  var shareBtn = document.getElementById('shareTriggerBtn');
  var shareDropdown = document.getElementById('shareDropdown');
  if (shareBtn && shareDropdown) {
    shareBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      shareDropdown.classList.toggle('active');
    });
    document.addEventListener('click', function() {
      shareDropdown.classList.remove('active');
    });
  }
})();

/* ── 🔗 SHARING Functions: Copy Link & QR Code ── */
window.copyProjectLink = function() {
  var url = window.location.href;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() {
      alert('📋 Link copied to clipboard!\n' + url);
    }).catch(function() {
      prompt('Copy this link:', url);
    });
  } else {
    prompt('Copy this link:', url);
  }
};

window.openQrModal = function() {
  var url = window.location.href;
  var qrImg = document.getElementById('qrImage');
  qrImg.src = 'https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=' + encodeURIComponent(url);
  document.getElementById('qrModal').classList.add('active');
};

window.closeQrModal = function() {
  document.getElementById('qrModal').classList.remove('active');
};

/* ── ❤️ COMMUNITY: Reply Functionality ── */
window.toggleReplyBox = function(commentId) {
  var box = document.getElementById('replyBox-' + commentId);
  if (box) box.classList.toggle('active');
};

window.submitReply = function(e, parentId) {
  e.preventDefault();
  var input = document.getElementById('replyInput-' + parentId);
  var content = input.value.trim();
  if (!content) return;

  var projectId = '<%= project.id %>';
  fetch('/projects/' + projectId + '/comment', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ content: content, parent_id: parentId })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.error) {
      alert(d.error);
      return;
    }
    var repliesList = document.getElementById('replies-' + parentId);
    if (repliesList) {
      repliesList.style.display = 'block';
      var repDiv = document.createElement('div');
      repDiv.className = 'reply-card';
      repDiv.innerHTML =
        '<div class="reply-meta">' +
          '<strong>' + (d.author || 'You') + '</strong>' +
          '<div><span>Just now</span></div>' +
        '</div>' +
        '<p style="margin: 0; font-size: 0.9rem;">' + content.replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</p>';
      repliesList.appendChild(repDiv);
    }
    input.value = '';
    window.toggleReplyBox(parentId);
  })
  .catch(function() {
    alert('Failed to post reply.');
  });
};

/* ── 🛡️ COMMUNITY / SAFETY: Report Modal & Submission ── */
window.openReportModal = function(commentId) {
  document.getElementById('reportCommentId').value = commentId || '';
  document.getElementById('reportReason').value = '';
  document.getElementById('reportDetails').value = '';
  document.getElementById('reportModal').classList.add('active');
};

window.closeReportModal = function() {
  document.getElementById('reportModal').classList.remove('active');
};

window.submitReport = function(e) {
  e.preventDefault();
  var reason = document.getElementById('reportReason').value;
  var details = document.getElementById('reportDetails').value;
  var commentId = document.getElementById('reportCommentId').value;
  var btn = document.getElementById('reportSubmitBtn');

  btn.disabled = true;
  btn.textContent = 'Submitting…';

  fetch('/projects/<%= project.id %>/report', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ reason: reason, details: details, comment_id: commentId })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    btn.disabled = false;
    btn.textContent = 'Submit Report';
    if (d.error) {
      alert(d.error);
    } else {
      alert(d.message || 'Report submitted successfully.');
      closeReportModal();
    }
  })
  .catch(function() {
    btn.disabled = false;
    btn.textContent = 'Submit Report';
    alert('Failed to submit report. Please try again.');
  });
};

/* ── Judge Panel: Flag for Re-evaluation ── */
window.flagProjectReview = function(projectId, btn) {
  if (!confirm('Flag this project for re-evaluation?')) return;
  btn.disabled = true;
  btn.textContent = '…';
  fetch('/judge/assignments/' + projectId + '/flag', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.error) {
        btn.disabled = false;
        btn.textContent = '🔄 Flag for Re-evaluation';
        alert(d.error);
        return;
      }
      btn.parentElement.innerHTML = '<div style="text-align:center;font-size:0.8rem;color:#c2410c;font-weight:bold;">🔄 Flagged for Re-evaluation</div>';
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = '🔄 Flag for Re-evaluation';
      alert('Network error. Try again.');
    });
};

/* ── Judge Panel: Save Notes ── */
window.saveJudgeNotes = function(projectId, notes) {
  var statusDiv = document.getElementById('notesStatus');
  statusDiv.textContent = 'Saving...';
  fetch('/judge/assignments/' + projectId + '/notes', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ notes: notes })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.error) {
      statusDiv.textContent = 'Error saving notes.';
      statusDiv.style.color = '#ef4444';
    } else {
      statusDiv.textContent = 'Saved.';
      statusDiv.style.color = '#34A853';
      setTimeout(function() { statusDiv.textContent = ''; }, 2000);
    }
  })
  .catch(function() {
    statusDiv.textContent = 'Network error.';
    statusDiv.style.color = '#ef4444';
  });
};

/* ── Judge Panel: Declare Conflict ── */
window.declareConflict = function(projectId, btn) {
  var reason = prompt('Please briefly describe the conflict of interest:');
  if (reason === null) return;
  if (!reason.trim()) {
    alert('A reason is required to declare a conflict.');
    return;
  }
  btn.disabled = true;
  btn.textContent = 'Declaring...';
  fetch('/judge/assignments/' + projectId + '/conflict', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ reason: reason })
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.error) {
      btn.disabled = false;
      btn.textContent = 'Declare Conflict of Interest';
      alert(d.error);
    } else {
      window.location.reload();
    }
  })
  .catch(function() {
    btn.disabled = false;
    btn.textContent = 'Declare Conflict of Interest';
    alert('Network error.');
  });
};
</script>

