<%- include('layouts/header', { title: 'Join Team', session }) %>

<h1>Join a Team</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error" style="margin-bottom: 16px;"><%= error %></div>
<% } %>

<p>Enter your invite code to join an existing team.</p>

<form method="POST" action="/team/join" class="form-narrow" id="invite-form">
  <div class="form-group">
    <label for="code">Invite Code</label>
    <input type="text" id="code" name="code" required placeholder="e.g. INV-TM01" style="text-transform: uppercase;">
  </div>
  <button type="submit">Join Team</button>
  <a href="/team" style="margin-left: 16px;">Back to My Teams</a>
</form>

<%- include('layouts/footer') %>
