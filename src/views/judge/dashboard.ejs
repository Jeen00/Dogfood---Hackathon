<%- include('../layouts/header', { title: (typeof selectedEvent !== 'undefined' && selectedEvent ? selectedEvent.name + ' — My Assignments' : 'Judge Dashboard'), session, selectedJudgeEvent: typeof selectedEvent !== 'undefined' ? selectedEvent : null }) %>

<div style="margin-bottom: 20px;">
  <div style="margin-bottom: 6px;">
    <a href="/judge/events" style="text-decoration: none; font-size: 0.9rem; font-weight: bold; color: #1a73e8;">&larr; All Events</a>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <h1 style="margin: 0; padding: 0; border: none;">
      <% if (typeof selectedEvent !== 'undefined' && selectedEvent) { %>
        <%= selectedEvent.name %>
      <% } else { %>
        Judge Dashboard
      <% } %>
    </h1>
    <% if (typeof statusInfo !== 'undefined' && statusInfo) { %>
      <div style="display: flex; align-items: center; gap: 10px;">
        <span class="status-badge <%= statusInfo.badgeClass %>"><%= statusInfo.label %></span>
        <span style="font-weight: bold; font-size: 0.95rem; color: <%= statusInfo.status === 'running' ? '#137333' : '#555' %>;">
          ⏱ <%= statusInfo.timeText %>
        </span>
      </div>
    <% } %>
  </div>
</div>

<%
  const pending  = assignments.filter(a => !a.scored).length;
  const complete = assignments.filter(a =>  a.scored).length;
%>

<div style="display: flex; gap: 24px; margin-bottom: 20px; flex-wrap: wrap;">
  <div style="background: #f0fdf4; border: 1px solid #bbf7d0; padding: 12px 20px; min-width: 120px; text-align: center;">
    <div style="font-size: 2rem; font-weight: bold; color: #15803d;"><%= complete %></div>
    <div style="font-size: 0.85rem; color: #555;">Scored</div>
  </div>
  <div style="background: #fef9c3; border: 1px solid #fde047; padding: 12px 20px; min-width: 120px; text-align: center;">
    <div style="font-size: 2rem; font-weight: bold; color: #854d0e;"><%= pending %></div>
    <div style="font-size: 0.85rem; color: #555;">Pending</div>
  </div>
  <div style="background: #f8f9fa; border: 1px solid #ddd; padding: 12px 20px; min-width: 120px; text-align: center;">
    <div style="font-size: 2rem; font-weight: bold;"><%= assignments.length %></div>
    <div style="font-size: 0.85rem; color: #555;">Total Assigned</div>
  </div>
</div>

<% if (assignments.length === 0) { %>
  <p>No projects have been assigned to you for this event.</p>
  <p><a href="/judge/events">&larr; Back to All Events</a></p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Team</th>
        <th>Track</th>
        <th>Submitted</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% for (const a of assignments) { %>
        <tr>
          <td><a href="/projects/<%= a.id %>"><%= a.title %></a></td>
          <td><%= a.team_name %></td>
          <td><%= a.track_name %></td>
          <td><%= a.submitted_at ? a.submitted_at.slice(0, 10) : 'N/A' %></td>
          <td>
            <% if (a.scored) { %>
              <span style="color: #15803d; font-weight: bold;">✓ Scored</span>
            <% } else { %>
              <span style="color: #c05621; font-weight: bold;">⚪ Pending</span>
            <% } %>
          </td>
          <td><a href="/judge/score/<%= a.id %>"><%= a.scored ? 'Edit Score' : 'Score' %></a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('../layouts/footer') %>
