<%- include('../layouts/header', { title: 'Judge Dashboard', session }) %>

<h1>Judge Dashboard</h1>
<p>Welcome, judge. You have <%= assignments.length %> project<%= assignments.length === 1 ? '' : 's' %> assigned to you.</p>

<% const pending  = assignments.filter(a => !a.scored).length; %>
<% const complete = assignments.filter(a =>  a.scored).length; %>

<p>
  <strong><%= complete %></strong> scored &nbsp;|&nbsp;
  <strong><%= pending %></strong> pending
</p>

<% if (assignments.length === 0) { %>
  <p>No projects have been assigned to you yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Team</th>
        <th>Track</th>
        <th>Submitted</th>
        <th>Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% for (const a of assignments) { %>
        <tr>
          <td><a href="/projects/<%= a.id %>"><%= a.title %></a></td>
          <td><%= a.team_name %></td>
          <td><%= a.track_name %></td>
          <td><%= a.submitted_at ? a.submitted_at.slice(0, 10) : 'N/A' %></td>
          <td><%= a.scored ? 'Scored' : 'Pending' %></td>
          <td><a href="/judge/score/<%= a.id %>"><%= a.scored ? 'Edit Score' : 'Score' %></a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('../layouts/footer') %>
