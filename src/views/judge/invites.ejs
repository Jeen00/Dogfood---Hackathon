<%- include('../layouts/header', { title: 'My Invites', session, selectedJudgeEvent: null }) %>

<h1>Hackathon Invites</h1>
<p style="color:#666; margin-bottom:24px;">Invitations from organizers to judge hackathons.</p>

<% const pending = invites.filter(i => i.status === 'pending'); %>
<% const past    = invites.filter(i => i.status !== 'pending'); %>

<div id="no-invites-msg" style="<%= invites.length === 0 ? 'display:block;' : 'display:none;' %>">
  <p>You have no invites at the moment.</p>
</div>

<div id="pending-section" style="<%= pending.length > 0 ? 'display:block;' : 'display:none;' %> margin-bottom:32px;">
  <h2 id="pending-heading" style="font-size:1.1rem; margin-bottom:14px;">Pending Invites (<span id="pending-count"><%= pending.length %></span>)</h2>
  <div id="pending-list" style="display:flex; flex-direction:column; gap:16px;">
    <% for (const inv of pending) { %>
      <div style="background:#fff; border:2px solid #1A1A1A; padding:20px;" id="invite-card-<%= inv.id %>">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:12px;">
          <div>
            <h3 style="margin:0 0 6px 0; font-size:1.2rem; border:none; padding:0;"><%= inv.event_name %></h3>
            <table style="border:none; font-size:0.9rem; margin-bottom:8px;">
              <tr>
                <td style="color:#555; padding:2px 16px 2px 0;"><strong>Organizer:</strong></td>
                <td><%= inv.organizer_name %></td>
              </tr>
              <tr>
                <td style="color:#555; padding:2px 16px 2px 0;"><strong>Starts:</strong></td>
                <td><%= inv.submissions_open ? new Date(inv.submissions_open).toLocaleString('en-US', {dateStyle:'medium',timeStyle:'short'}) : 'TBD' %></td>
              </tr>
              <tr>
                <td style="color:#555; padding:2px 16px 2px 0;"><strong>Ends:</strong></td>
                <td><%= inv.submissions_close ? new Date(inv.submissions_close).toLocaleString('en-US', {dateStyle:'medium',timeStyle:'short'}) : 'TBD' %></td>
              </tr>
              <tr>
                <td style="color:#555; padding:2px 16px 2px 0;"><strong>Invited:</strong></td>
                <td><%= inv.created_at ? inv.created_at.slice(0,16).replace('T',' ') : '—' %></td>
              </tr>
            </table>
          </div>
          <div style="display:flex; gap:10px; align-items:flex-start; flex-wrap:wrap;">
            <button onclick="respondInvite('<%= inv.id %>', 'accept', this)" data-name="<%= inv.event_name %>" data-organizer="<%= inv.organizer_name %>"
              style="background:#E6F4EA; border:2px solid #34A853; color:#137333; font-weight:bold; font-size:0.95rem; padding:10px 22px; cursor:pointer;">
              ✓ Accept
            </button>
            <button onclick="respondInvite('<%= inv.id %>', 'reject', this)" data-name="<%= inv.event_name %>" data-organizer="<%= inv.organizer_name %>"
              style="background:#FDECEA; border:2px solid #EA4335; color:#c5221f; font-weight:bold; font-size:0.95rem; padding:10px 22px; cursor:pointer;">
              ✗ Decline
            </button>
          </div>
        </div>
        <div id="invite-msg-<%= inv.id %>" style="margin-top:10px; font-size:0.9rem; display:none;"></div>
      </div>
    <% } %>
  </div>
</div>

<div id="past-section" style="<%= past.length > 0 ? 'display:block;' : 'display:none;' %>">
  <h2 style="font-size:1.1rem; margin-bottom:12px;">Past Invites</h2>
  <table>
    <thead>
      <tr>
        <th>Hackathon</th>
        <th>Organizer</th>
        <th>Status</th>
        <th>Responded</th>
      </tr>
    </thead>
    <tbody id="past-tbody">
      <% for (const inv of past) { %>
        <tr>
          <td><%= inv.event_name %></td>
          <td><%= inv.organizer_name %></td>
          <td>
            <% if (inv.status === 'accepted') { %>
              <span style="color:#137333; font-weight:bold;">✓ Accepted</span>
            <% } else { %>
              <span style="color:#c5221f; font-weight:bold;">✗ Declined</span>
            <% } %>
          </td>
          <td style="font-size:0.85rem;"><%= inv.responded_at ? inv.responded_at.slice(0,16).replace('T',' ') : '—' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
function respondInvite(id, action, btn) {
  var eventName = btn ? btn.getAttribute('data-name') : 'hackathon';
  var organizerName = btn ? btn.getAttribute('data-organizer') : 'Organizer';
  var card = document.getElementById('invite-card-' + id);
  var btns = card ? card.querySelectorAll('button') : [];
  btns.forEach(function(b) { b.disabled = true; });

  fetch('/api/judge-invites/' + id + '/' + action, { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.error) {
        btns.forEach(function(b) { b.disabled = false; });
        if (window.showToast) window.showToast(data.error, 'error');
      } else {
        var statusBadge = action === 'accept'
          ? '<span style="color:#137333; font-weight:bold;">✓ Accepted</span>'
          : '<span style="color:#c5221f; font-weight:bold;">✗ Declined</span>';

        if (action === 'accept') {
          if (window.showToast) window.showToast('✓ Accepted invite for ' + (eventName || 'hackathon') + '!', 'success');
          card.style.borderColor = '#34A853';
          card.style.background = '#E6F4EA';
        } else {
          if (window.showToast) window.showToast('Declined invitation.', 'info');
          card.style.borderColor = '#EA4335';
          card.style.background = '#FDECEA';
        }

        // Hide action buttons
        btns.forEach(function(b) { b.style.display = 'none'; });

        // Decrement notification bell count
        var badge = document.getElementById('notif-count');
        if (badge && badge.textContent) {
          var count = parseInt(badge.textContent, 10);
          if (count > 1) {
            badge.textContent = count - 1;
          } else {
            badge.style.display = 'none';
          }
        }

        // Append to Past Invites table without reload
        var pastSec = document.getElementById('past-section');
        var pastTbody = document.getElementById('past-tbody');
        if (pastSec) pastSec.style.display = 'block';
        if (pastTbody) {
          var nowStr = new Date().toISOString().slice(0, 16).replace('T', ' ');
          var newRow = '<tr>' +
            '<td>' + (eventName || '') + '</td>' +
            '<td>' + (organizerName || 'Organizer') + '</td>' +
            '<td>' + statusBadge + '</td>' +
            '<td style="font-size:0.85rem;">' + nowStr + '</td>' +
            '</tr>';
          pastTbody.innerHTML = newRow + pastTbody.innerHTML;
        }

        // Remove card after 1 second without page reload
        setTimeout(function() {
          if (card) card.remove();
          var remaining = document.querySelectorAll('#pending-list > div');
          var pCount = document.getElementById('pending-count');
          if (pCount) pCount.textContent = remaining.length;
          if (remaining.length === 0) {
            var pSec = document.getElementById('pending-section');
            if (pSec) pSec.style.display = 'none';
          }
        }, 1100);
      }
    })
    .catch(function() {
      btns.forEach(function(b) { b.disabled = false; });
      if (window.showToast) window.showToast('Network error. Please try again.', 'error');
    });
}
</script>

<%- include('../layouts/footer') %>
