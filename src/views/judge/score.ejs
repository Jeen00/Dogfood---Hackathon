<%- include('../layouts/header', { title: 'Score: ' + project.title, session, selectedJudgeEvent: typeof selectedEvent !== 'undefined' ? selectedEvent : null }) %>

<div class="breadcrumb">
  <a href="/judge/events">All Events</a>
  <% if (typeof selectedEvent !== 'undefined' && selectedEvent) { %>
    / <a href="/judge/assignments?event_id=<%= selectedEvent.id %>">My Assignments</a>
    / <a href="/projects/<%= project.id %>"><%= project.title %></a>
  <% } else { %>
    / <a href="/judge/dashboard">Dashboard</a>
    / <a href="/projects/<%= project.id %>"><%= project.title %></a>
  <% } %>
  / Score
</div>

<h1>Score: <%= project.title %></h1>

<table class="detail-table" style="margin-bottom: 24px;">
  <tr>
    <th>Team</th>
    <td><%= project.team_name %></td>
  </tr>
  <tr>
    <th>Track</th>
    <td><%= project.track_name %></td>
  </tr>
  <% if (project.repo_url) { %>
  <tr>
    <th>Repository</th>
    <td><a href="<%= project.repo_url %>" target="_blank" rel="noopener noreferrer"><%= project.repo_url %></a></td>
  </tr>
  <% } %>
</table>

<h2>Project Summary</h2>
<p><%= project.summary || 'No summary provided.' %></p>

<hr style="border: 1px solid #1A1A1A; margin: 24px 0;">

<h2>Scoring Evaluation</h2>
<div style="background: #eef2ff; border-left: 4px solid #4f46e5; padding: 12px 16px; margin-bottom: 24px;">
  <strong>Instructions:</strong> Review the project details, demo, and code. Rate each criterion below based on the hackathon guidelines from 1 (lowest) to 5 (highest). Pay attention to the Weightage assigned to each criterion.
</div>

<form method="POST" action="/api/judge/scores" id="score-form">
  <input type="hidden" name="project_id" value="<%= project.id %>">

  <% for (const crit of criteria) { %>
    <div class="form-group" style="margin-bottom: 16px;">
      <label for="crit_<%= crit.name %>" style="display:flex; justify-content:space-between; align-items:center; max-width:400px;">
        <span style="font-weight:bold;"><%= crit.name.charAt(0).toUpperCase() + crit.name.slice(1) %></span>
        <span style="background:#e2e8f0; padding:2px 8px; font-size:0.8em; border-radius:12px;">Weightage: <%= (crit.weight * 100).toFixed(0) %>%</span>
      </label>
      <input
        type="number"
        id="crit_<%= crit.name %>"
        name="criteria_scores[<%= crit.name %>]"
        min="1"
        max="5"
        value="<%= existingScores[crit.name] || '' %>"
        required
        style="width: 100%; max-width:400px; padding:8px; font-size:1rem;"
        class="score-input"
        data-weight="<%= crit.weight %>"
      >
    </div>
  <% } %>

  <div class="form-group">
    <label for="comment" style="font-weight:bold;">Comments & Justification</label>
    <textarea id="comment" name="comment" rows="5" placeholder="Provide your justification for the scores and overall feedback for the team..." style="width:100%; max-width:600px; padding:8px;"><%= existingComment || '' %></textarea>
  </div>

  <div id="weighted-preview" style="margin-bottom: 16px; border: 2px solid #1A1A1A; padding: 12px; background: #F5F5F0;">
    Weighted Score: <strong id="weighted-value">--</strong> / 5.00
  </div>

  <button type="submit">Submit Score</button>
  <a href="/projects/<%= project.id %>" style="margin-left: 16px;">← Back to Project</a>
</form>

<script>
  function recalculate() {
    var inputs = document.querySelectorAll('.score-input');
    var total = 0;
    var valid = true;
    inputs.forEach(function(input) {
      var val = parseFloat(input.value);
      var weight = parseFloat(input.dataset.weight);
      if (isNaN(val) || val < 1 || val > 5) {
        valid = false;
      } else {
        total += val * weight;
      }
    });
    document.getElementById('weighted-value').textContent = valid ? total.toFixed(2) : '--';
  }

  document.querySelectorAll('.score-input').forEach(function(input) {
    input.addEventListener('input', recalculate);
    input.addEventListener('change', recalculate);
  });

  // Initial calculation
  recalculate();

  // Handle form submission — convert nested name to JSON body via fetch
  document.getElementById('score-form').addEventListener('submit', function(e) {
    e.preventDefault();
    var form = e.target;
    var projectId = form.querySelector('[name="project_id"]').value;
    var comment   = form.querySelector('[name="comment"]').value;
    var criteriaScores = {};
    form.querySelectorAll('.score-input').forEach(function(input) {
      // name="criteria_scores[functionality]" -> extract key
      var match = input.name.match(/\[([^\]]+)\]/);
      if (match) {
        criteriaScores[match[1]] = parseInt(input.value, 10);
      }
    });

    fetch('/api/judge/scores', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ project_id: projectId, criteria_scores: criteriaScores, comment: comment })
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.error) {
        if (window.showToast) window.showToast('Error: ' + data.error, 'error');
        else alert('Error: ' + data.error);
      } else {
        if (window.showToast) window.showToast('Score submitted successfully! ✅', 'success');
        var eventId = '<% if (typeof selectedEvent !== "undefined" && selectedEvent) { %><%= selectedEvent.id %><% } %>';
        setTimeout(function() {
          window.location.href = '/judge/dashboard' + (eventId ? '?event_id=' + eventId : '');
        }, 800);
      }
    })
    .catch(function(err) {
      if (window.showToast) window.showToast('Network error: ' + err.message, 'error');
      else alert('Network error: ' + err.message);
    });
  });
</script>

<%- include('../layouts/footer') %>
