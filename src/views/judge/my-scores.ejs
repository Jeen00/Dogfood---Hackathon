<%- include('../layouts/header', { title: 'My Scores', session, selectedJudgeEvent: typeof selectedEvent !== 'undefined' ? selectedEvent : null }) %>

<div style="margin-bottom: 20px;">
  <% if (typeof selectedEvent !== 'undefined' && selectedEvent) { %>
    <div style="margin-bottom: 6px;">
      <a href="/judge/events" style="text-decoration: none; font-size: 0.9rem; font-weight: bold; color: #1a73e8;">&larr; All Events</a>
    </div>
    <h1 style="margin: 0; padding: 0; border: none;">My Scores — <%= selectedEvent.name %></h1>
  <% } else { %>
    <h1>My Submitted Scores</h1>
  <% } %>
</div>

<% if (scores.length === 0) { %>
  <p>You have not submitted any scores yet
    <% if (typeof selectedEvent !== 'undefined' && selectedEvent) { %> for this event<% } %>.
  </p>
  <% if (typeof selectedEvent !== 'undefined' && selectedEvent) { %>
    <p><a href="/judge/dashboard?event_id=<%= selectedEvent.id %>">&larr; Go to your assignments</a></p>
  <% } else { %>
    <p><a href="/judge/events">Go to All Events</a></p>
  <% } %>
<% } else { %>
  <p><%= scores.length %> score<%= scores.length === 1 ? '' : 's' %> submitted.</p>
  <table>
    <thead>
      <tr>
        <th>Project</th>
        <th>Track</th>
        <th>Functionality</th>
        <th>Quality</th>
        <th>Presentation</th>
        <th>Weighted</th>
        <th>Submitted</th>
      </tr>
    </thead>
    <tbody>
      <% for (const s of scores) { %>
        <%
          var fn  = s.criteria_scores.functionality || 0;
          var q   = s.criteria_scores.quality       || 0;
          var pr  = s.criteria_scores.presentation  || 0;
          var ws  = (fn * 0.5 + q * 0.3 + pr * 0.2).toFixed(2);
        %>
        <tr>
          <td><a href="/projects/<%= s.project_id %>"><%= s.project_title %></a></td>
          <td><%= s.track_name %></td>
          <td><%= fn %></td>
          <td><%= q %></td>
          <td><%= pr %></td>
          <td><%= ws %></td>
          <td><%= s.submitted_at ? s.submitted_at.slice(0, 10) : 'N/A' %></td>
        </tr>
        <% if (s.comment) { %>
          <tr>
            <td colspan="7" style="font-size: 0.85em; color: #555; padding-left: 24px;">
              Comment: <%= s.comment %>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('../layouts/footer') %>
