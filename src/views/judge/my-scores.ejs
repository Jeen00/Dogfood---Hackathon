<%- include('../layouts/header', { title: 'My Scores', session }) %>

<h1>My Submitted Scores</h1>

<% if (scores.length === 0) { %>
  <p>You have not submitted any scores yet.</p>
  <p><a href="/judge/dashboard">Go to your assignments</a></p>
<% } else { %>
  <p><%= scores.length %> score<%= scores.length === 1 ? '' : 's' %> submitted.</p>
  <table>
    <thead>
      <tr>
        <th>Project</th>
        <th>Track</th>
        <th>Functionality</th>
        <th>Quality</th>
        <th>Presentation</th>
        <th>Weighted</th>
        <th>Submitted</th>
      </tr>
    </thead>
    <tbody>
      <% for (const s of scores) { %>
        <%
          var fn  = s.criteria_scores.functionality || 0;
          var q   = s.criteria_scores.quality       || 0;
          var pr  = s.criteria_scores.presentation  || 0;
          var ws  = (fn * 0.5 + q * 0.3 + pr * 0.2).toFixed(2);
        %>
        <tr>
          <td><a href="/projects/<%= s.project_id %>"><%= s.project_title %></a></td>
          <td><%= s.track_name %></td>
          <td><%= fn %></td>
          <td><%= q %></td>
          <td><%= pr %></td>
          <td><%= ws %></td>
          <td><%= s.submitted_at ? s.submitted_at.slice(0, 10) : 'N/A' %></td>
        </tr>
        <% if (s.comment) { %>
          <tr>
            <td colspan="7" style="font-size: 0.85em; color: #555; padding-left: 24px;">
              Comment: <%= s.comment %>
            </td>
          </tr>
        <% } %>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('../layouts/footer') %>
