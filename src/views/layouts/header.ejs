<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - DOGFOOD 2026' : 'DOGFOOD 2026' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav>
    <a href="/projects" class="site-name">DOGFOOD 2026</a>
    <a href="/projects">Gallery</a>
    <% if (typeof session !== 'undefined' && session) { %>
      <% if (session.role === 'judge') { %>
        <a href="/judge/dashboard">My Assignments</a>
        <a href="/judge/scores">My Scores</a>
      <% } %>
      <% if (session.role === 'organizer' || session.role === 'admin') { %>
        <a href="/organizer/dashboard">Dashboard</a>
        <a href="/events/new">New Event</a>
        <a href="/organizer/assignments">Assignments</a>
        <a href="/organizer/normalization">Normalization</a>
      <% } %>
      <% if (session.role === 'participant') { %>
        <a href="/team">My Team</a>
        <a href="/submissions/new">Submit Project</a>
      <% } %>
      <a href="/auth/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
    <% } %>
  </nav>
  <main>
