<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - DOGFOOD 2026' : 'DOGFOOD 2026' %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/organizer.css">
</head>
<body>
  <nav>
    <a href="/" class="site-name">DOGFOOD 2026</a>
    <% if (typeof session === 'undefined' || !session || session.role !== 'organizer' || (typeof selectedEvent === 'undefined' || !selectedEvent)) { %>
      <% if (!session || session.role !== 'judge' || (typeof selectedJudgeEvent === 'undefined' || !selectedJudgeEvent)) { %>
        <% if (!session || session.role !== 'participant' || (typeof selectedParticipantEvent === 'undefined' || !selectedParticipantEvent)) { %>
          <a href="/overview">Overview</a>
          <a href="/projects">Gallery</a>
          <a href="/results">Results</a>
        <% } %>
      <% } %>
    <% } %>
    <% if (typeof session !== 'undefined' && session) { %>
      <% if (session.role === 'judge') { %>
        <% if (typeof selectedJudgeEvent !== 'undefined' && selectedJudgeEvent) { %>
          <a href="/judge/events" style="color: #4CAF50; font-weight: bold;">&larr; All Events</a>
          <a href="/judge/dashboard?event_id=<%= selectedJudgeEvent.id %>">Dashboard</a>
          <a href="/judge/assignments?event_id=<%= selectedJudgeEvent.id %>">My Assignments</a>
          <a href="/judge/scores?event_id=<%= selectedJudgeEvent.id %>">My Scores</a>
          <a href="/judge/profile">Profile</a>
        <% } else { %>
          <a href="/judge/events" style="font-weight: bold;">All Events</a>
          <a href="/judge/invites">My Invites</a>
          <a href="/judge/profile">Profile</a>
        <% } %>
      <% } %>

      <% if (session.role === 'organizer' || session.role === 'admin') { %>
        <% if (typeof selectedEvent !== 'undefined' && selectedEvent) { %>
          <a href="/organizer/events" style="color: #4CAF50; font-weight: bold;">&larr; All Hackathons</a>
          <a href="/organizer/dashboard?event_id=<%= selectedEvent.id %>">Dashboard</a>
          <a href="/organizer/assignments?event_id=<%= selectedEvent.id %>">Assignments</a>
          <a href="/organizer/invites?event_id=<%= selectedEvent.id %>">Invite Judges</a>
          <a href="/organizer/normalization?event_id=<%= selectedEvent.id %>">Normalization</a>
          <a href="/organizer/results?event_id=<%= selectedEvent.id %>">Leaderboard</a>
          <a href="/organizer/rubric?event_id=<%= selectedEvent.id %>">Rubric</a>
        <% } else { %>
          <a href="/organizer/events" style="font-weight: bold;">All Hackathons</a>
          <a href="/events/new">+ New Event</a>
        <% } %>
      <% } %>

      <% if (session.role === 'participant') { %>
        <% if (typeof selectedParticipantEvent !== 'undefined' && selectedParticipantEvent) { %>
          <a href="/team/events" style="color: #4CAF50; font-weight: bold;">&larr; All Hackathons</a>
          <a href="/team?event_id=<%= selectedParticipantEvent.id %>">My Team</a>
          <a href="/submissions/new?event_id=<%= selectedParticipantEvent.id %>">Submit Project</a>
          <a href="/participant/profile">Profile</a>
        <% } else { %>
          <a href="/team/events" style="font-weight: bold;">All Hackathons</a>
          <a href="/participant/profile">Profile</a>
        <% } %>
      <% } %>

      <!-- Notification bell (all logged-in users) -->
      <div class="notif-bell-wrap" style="margin-left:auto; position:relative;">
        <button id="notif-bell" title="Notifications"
          style="background:none; border:none; color:#F5F5F0; cursor:pointer; font-size:1.25rem; padding:4px 6px; position:relative; line-height:1;">
          🔔
          <span id="notif-count"
            style="display:none; position:absolute; top:-4px; right:-4px; background:#EA4335; color:#fff;
                   font-size:0.65rem; font-weight:bold; padding:2px 5px; min-width:16px; text-align:center;">0</span>
        </button>
        <div id="notif-dropdown"
          style="display:none; position:absolute; right:0; top:40px; width:340px; max-height:420px; overflow-y:auto;
                 background:#fff; border:2px solid #1A1A1A; z-index:9999; box-shadow:none;">
          <div style="padding:10px 14px; border-bottom:1px solid #ddd; display:flex; justify-content:space-between; align-items:center;">
            <strong style="color:#1A1A1A; font-size:0.95rem;">Notifications</strong>
            <button onclick="markAllRead()"
              style="background:none; border:none; color:#1a73e8; cursor:pointer; font-size:0.8rem; font-weight:bold; padding:0;">
              Mark all read
            </button>
          </div>
          <div id="notif-list" style="padding:0;"></div>
        </div>
      </div>

      <a href="/auth/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
    <% } %>
  </nav>
  <main>

<% if (typeof session !== 'undefined' && session) { %>
<script>
(function() {
  var bell  = document.getElementById('notif-bell');
  var drop  = document.getElementById('notif-dropdown');
  var list  = document.getElementById('notif-list');
  var badge = document.getElementById('notif-count');
  var open  = false;

  // Poll for unread count every 4 seconds
  function pollCount() {
    fetch('/api/notifications/poll')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.unread > 0) {
          badge.style.display = 'block';
          badge.textContent = d.unread > 99 ? '99+' : d.unread;
        } else {
          badge.style.display = 'none';
        }
        if (open) {
          loadNotifications();
        }
      })
      .catch(function(){});
  }
  pollCount();
  setInterval(pollCount, 4000);

  // Toggle dropdown
  bell.addEventListener('click', function(e) {
    e.stopPropagation();
    open = !open;
    drop.style.display = open ? 'block' : 'none';
    if (open) loadNotifications();
  });

  // Close on outside click
  document.addEventListener('click', function(e) {
    if (!drop.contains(e.target) && e.target !== bell) {
      drop.style.display = 'none';
      open = false;
    }
  });

  function loadNotifications() {
    list.innerHTML = '<div style="padding:14px; color:#555; font-size:0.9rem;">Loading…</div>';
    fetch('/api/notifications')
      .then(function(r) { return r.json(); })
      .then(function(d) {
        var notifs = d.notifications || [];
        if (notifs.length === 0) {
          list.innerHTML = '<div style="padding:16px 14px; color:#555; font-size:0.9rem;">No notifications yet.</div>';
          return;
        }
        var html = '';
        notifs.forEach(function(n) {
          var bg = n.read ? '#fff' : '#EFF6FF';
          var dot = n.read ? '' : '<span style="display:inline-block;width:8px;height:8px;background:#1a73e8;vertical-align:middle;margin-right:6px;"></span>';
          var typeIcon = n.type === 'judge_invite' ? '📩' :
                         n.type === 'invite_accepted' ? '✅' :
                         n.type === 'invite_rejected' ? '❌' : '🔔';
          html += '<div data-id="' + n.id + '" onclick="readNotif(this, \'' + n.id + '\')" ' +
            'style="padding:12px 14px; border-bottom:1px solid #eee; cursor:pointer; background:' + bg + ';">' +
            '<div style="font-weight:bold; font-size:0.88rem; margin-bottom:3px;">' + dot + typeIcon + ' ' + n.title + '</div>' +
            '<div style="font-size:0.82rem; color:#444; line-height:1.4;">' + n.body + '</div>' +
            '<div style="font-size:0.75rem; color:#888; margin-top:4px;">' + (n.created_at || '').slice(0,16).replace('T',' ') + '</div>' +
            '</div>';
        });
        list.innerHTML = html;
        badge.style.display = d.unread > 0 ? 'block' : 'none';
        badge.textContent = d.unread > 99 ? '99+' : d.unread;
      })
      .catch(function() {
        list.innerHTML = '<div style="padding:14px; color:#c5221f; font-size:0.9rem;">Failed to load.</div>';
      });
  }

  window.readNotif = function(el, id) {
    el.style.background = '#fff';
    var dot = el.querySelector('span[style*="background:#1a73e8"]');
    if (dot) dot.remove();
    fetch('/api/notifications/' + id + '/read', { method: 'POST' }).catch(function(){});
    // If it's a judge invite, navigate to invites page
    setTimeout(function() {
      var role = '<%= session.role %>';
      if (role === 'judge') {
        window.location.href = '/judge/invites';
      }
    }, 200);
  };

  window.markAllRead = function() {
    fetch('/api/notifications/read-all', { method: 'POST' })
      .then(function() {
        badge.style.display = 'none';
        loadNotifications();
      })
      .catch(function(){});
  };

  // Modern Toast Notification Utility (no refresh required)
  window.showToast = function(message, type, duration) {
    duration = duration || 4000;
    var container = document.getElementById('toast-container');
    if (!container) return;

    var toast = document.createElement('div');
    var bg = '#ffffff';
    var border = '#1A1A1A';
    var text = '#1A1A1A';
    var icon = '🔔';

    if (type === 'success') {
      bg = '#E6F4EA';
      border = '#34A853';
      text = '#137333';
      icon = '✅';
    } else if (type === 'error') {
      bg = '#FDECEA';
      border = '#EA4335';
      text = '#c5221f';
      icon = '❌';
    } else if (type === 'info') {
      bg = '#E8F0FE';
      border = '#1A73E8';
      text = '#1A73E8';
      icon = '📩';
    }

    toast.style.cssText = 'background:' + bg + '; border:2px solid ' + border + '; color:' + text +
      '; padding:12px 18px; font-size:0.92rem; font-weight:bold; box-shadow:0 4px 14px rgba(0,0,0,0.15);' +
      'display:flex; align-items:center; justify-content:space-between; gap:14px; min-width:280px;';
    toast.innerHTML = '<div><span style="margin-right:8px;">' + icon + '</span>' + message + '</div>' +
      '<button onclick="this.parentElement.remove()" style="background:none;border:none;color:' + text + ';font-size:1.2rem;cursor:pointer;line-height:1;padding:0;">&times;</button>';

    container.appendChild(toast);
    setTimeout(function() {
      if (toast && toast.parentElement) toast.remove();
    }, duration);
  };
})();
</script>

<div id="toast-container" style="position:fixed; bottom:24px; right:24px; z-index:99999; display:flex; flex-direction:column; gap:10px; max-width:400px;"></div>
<% } %>
