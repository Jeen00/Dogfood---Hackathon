<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - DOGFOOD 2026' : 'DOGFOOD 2026' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <nav>
    <a href="/projects" class="site-name">DOGFOOD 2026</a>
    <% if (typeof session === 'undefined' || !session || session.role !== 'organizer' || (typeof selectedEvent === 'undefined' || !selectedEvent)) { %>
      <% if (!session || session.role !== 'judge' || (typeof selectedJudgeEvent === 'undefined' || !selectedJudgeEvent)) { %>
        <a href="/projects">Gallery</a>
      <% } %>
    <% } %>
    <% if (typeof session !== 'undefined' && session) { %>
      <% if (session.role === 'judge') { %>
        <% if (typeof selectedJudgeEvent !== 'undefined' && selectedJudgeEvent) { %>
          <a href="/judge/events" style="color: #4CAF50; font-weight: bold;">&larr; All Events</a>
          <a href="/judge/dashboard?event_id=<%= selectedJudgeEvent.id %>">My Assignments</a>
          <a href="/judge/scores?event_id=<%= selectedJudgeEvent.id %>">My Scores</a>
        <% } else { %>
          <a href="/judge/events" style="font-weight: bold;">All Events</a>
        <% } %>
      <% } %>
      <% if (session.role === 'organizer' || session.role === 'admin') { %>
        <% if (typeof selectedEvent !== 'undefined' && selectedEvent) { %>
          <a href="/organizer/events" style="color: #4CAF50; font-weight: bold;">&larr; All Hackathons</a>
          <a href="/organizer/dashboard?event_id=<%= selectedEvent.id %>">Dashboard</a>
          <a href="/organizer/assignments?event_id=<%= selectedEvent.id %>">Assignments</a>
          <a href="/organizer/normalization?event_id=<%= selectedEvent.id %>">Normalization</a>
          <a href="/organizer/results?event_id=<%= selectedEvent.id %>">Leaderboard</a>
          <a href="/organizer/rubric?event_id=<%= selectedEvent.id %>">Rubric</a>
        <% } else { %>
          <a href="/organizer/events" style="font-weight: bold;">All Hackathons</a>
          <a href="/events/new">+ New Event</a>
        <% } %>
      <% } %>

      <% if (session.role === 'participant') { %>
        <a href="/team">My Team</a>
        <a href="/submissions/new">Submit Project</a>
      <% } %>
      <a href="/auth/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
    <% } %>
  </nav>
  <main>
