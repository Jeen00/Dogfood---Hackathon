<%- include('layouts/header', { title: 'Hackathon Results & Leaderboard', session }) %>

<style>
  .results-container {
    max-width: 1100px;
    margin: 40px auto;
    padding: 0 20px;
  }
  .results-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .results-title {
    font-size: 2.75rem;
    font-weight: 900;
    margin: 0 0 12px 0;
    letter-spacing: -0.5px;
  }
  .results-subtitle {
    color: #666;
    font-size: 1.15rem;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Podium / Winners */
  .podium-section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-bottom: 48px;
    align-items: stretch;
  }
  .winner-card {
    background: #fff;
    border: 3px solid #1A1A1A;
    box-shadow: 6px 6px 0 #1A1A1A;
    padding: 28px 24px;
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .winner-card.first {
    border-color: #D97706;
    background: #FFFBEB;
    box-shadow: 6px 6px 0 #D97706;
  }
  .winner-card.second {
    border-color: #475569;
    background: #F8FAFC;
    box-shadow: 6px 6px 0 #475569;
  }
  .winner-card.third {
    border-color: #B45309;
    background: #FFF7ED;
    box-shadow: 6px 6px 0 #B45309;
  }
  .winner-badge {
    font-size: 3rem;
    margin-bottom: 8px;
    line-height: 1;
  }
  .winner-rank {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 8px;
  }
  .first .winner-rank { color: #B45309; }
  .second .winner-rank { color: #475569; }
  .third .winner-rank { color: #9A3412; }

  .winner-title {
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 8px 0;
  }
  .winner-title a {
    color: inherit;
    text-decoration: none;
  }
  .winner-title a:hover {
    text-decoration: underline;
  }
  .winner-team {
    font-size: 0.95rem;
    color: #555;
    margin-bottom: 16px;
  }
  .winner-score-pill {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.88rem;
    background: #1A1A1A;
    color: #fff;
  }

  /* Awards Grid */
  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: 48px;
  }
  .award-card {
    background: #fff;
    border: 2px solid #1A1A1A;
    padding: 20px;
    box-shadow: 4px 4px 0 #1A1A1A;
  }
  .award-icon {
    font-size: 2rem;
    margin-bottom: 8px;
  }
  .award-name {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 6px 0;
  }
  .award-project {
    font-weight: 700;
    color: #1A73E8;
  }
  .award-project a {
    color: #1A73E8;
    text-decoration: none;
  }
  .award-team {
    font-size: 0.85rem;
    color: #666;
    margin-top: 4px;
  }

  /* Leaderboard Table */
  .leaderboard-card {
    background: #fff;
    border: 2px solid #1A1A1A;
    box-shadow: 4px 4px 0 #1A1A1A;
    padding: 24px;
    margin-bottom: 48px;
    overflow-x: auto;
  }
  .leaderboard-table {
    width: 100%;
    border-collapse: collapse;
  }
  .leaderboard-table th {
    background: #F1F5F9;
    padding: 12px 16px;
    text-align: left;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid #1A1A1A;
  }
  .leaderboard-table td {
    padding: 14px 16px;
    border-bottom: 1px solid #E2E8F0;
    font-size: 0.95rem;
  }
  .leaderboard-table tr:hover {
    background: #F8FAFC;
  }

  /* Hackathon Selector */
  .hackathon-selector-card {
    background: #fff;
    border: 2px solid #1A1A1A;
    box-shadow: 4px 4px 0 #1A1A1A;
    padding: 16px 20px;
    margin-bottom: 28px;
  }
  .hackathon-selector-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }
  .hackathon-selector-title {
    font-size: 0.92rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #475569;
  }
  .hackathon-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hackathon-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 2px solid #1A1A1A;
    background: #F8FAFC;
    color: #1A1A1A;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  .hackathon-pill:hover {
    background: #E2E8F0;
  }
  .hackathon-pill.active {
    background: #1A1A1A;
    color: #fff;
    box-shadow: 2px 2px 0 rgba(0,0,0,0.3);
  }
  .hackathon-status-tag {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tag-published {
    background: #DCFCE7;
    color: #166534;
  }
  .tag-judging {
    background: #FEF3C7;
    color: #92400E;
  }
  .tag-upcoming {
    background: #E0E7FF;
    color: #3730A3;
  }
  .hackathon-pill.active .tag-published {
    background: #22C55E;
    color: #FFFFFF;
  }
  .hackathon-pill.active .tag-judging {
    background: #F59E0B;
    color: #FFFFFF;
  }
  .hackathon-pill.active .tag-upcoming {
    background: #6366F1;
    color: #FFFFFF;
  }

  /* Current Event Meta Card */
  .event-meta-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #F8FAFC;
    border: 2px solid #1A1A1A;
    padding: 16px 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .event-meta-left h2 {
    margin: 0 0 4px 0;
    font-size: 1.35rem;
    font-weight: 800;
  }
  .event-meta-left p {
    margin: 0;
    color: #64748B;
    font-size: 0.88rem;
  }
  .event-meta-stats {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }
  .stat-badge {
    text-align: center;
    background: #fff;
    border: 1.5px solid #1A1A1A;
    padding: 6px 14px;
    border-radius: 4px;
    min-width: 80px;
  }
  .stat-val {
    font-size: 1.15rem;
    font-weight: 900;
    line-height: 1.1;
  }
  .stat-lbl {
    font-size: 0.7rem;
    color: #64748B;
    text-transform: uppercase;
    font-weight: 700;
  }
</style>

<div class="results-container">
  <div class="results-header">
    <h1 class="results-title">🏆 Hackathon Results & Leaderboard</h1>
    <p class="results-subtitle">
      Explore official standings, award winners, and published scores across all hackathons
    </p>
  </div>

  <!-- ── 🔄 HACKATHON SELECTOR ────────────────────────────────────────── -->
  <% if (typeof allEvents !== 'undefined' && allEvents && allEvents.length > 0) { %>
    <div class="hackathon-selector-card">
      <div class="hackathon-selector-header">
        <span class="hackathon-selector-title">Select Hackathon</span>
        <select onchange="window.location.href='/results?event_id=' + this.value" style="padding: 6px 12px; border: 2px solid #1A1A1A; font-weight: bold; background: #fff; cursor: pointer; border-radius: 4px;">
          <% allEvents.forEach(function(ev) { %>
            <option value="<%= ev.id %>" <%= (event && event.id === ev.id) ? 'selected' : '' %>>
              <%= ev.name %> (<%= ev.score_count > 0 ? 'Results Published' : (ev.project_count > 0 ? 'Judging' : 'Upcoming') %>)
            </option>
          <% }); %>
        </select>
      </div>

      <div class="hackathon-pills">
        <% allEvents.forEach(function(ev) { 
             const isActive = event && event.id === ev.id;
             let tagClass = 'tag-upcoming';
             let tagText = 'Upcoming';
             if (ev.score_count > 0) {
               tagClass = 'tag-published';
               tagText = 'Results Ready';
             } else if (ev.project_count > 0 || (new Date(ev.submissions_close) <= new Date())) {
               tagClass = 'tag-judging';
               tagText = 'Judging';
             }
        %>
          <a href="/results?event_id=<%= ev.id %>" class="hackathon-pill <%= isActive ? 'active' : '' %>">
            <span><%= ev.name %></span>
            <span class="hackathon-status-tag <%= tagClass %>"><%= tagText %></span>
          </a>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- ── 📌 SELECTED EVENT BANNER ──────────────────────────────────────── -->
  <% if (event) { %>
    <div class="event-meta-banner">
      <div class="event-meta-left">
        <h2><%= event.name %></h2>
        <p>Submissions closed: <%= new Date(event.submissions_close).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></p>
      </div>
      <div class="event-meta-stats">
        <div class="stat-badge">
          <div class="stat-val"><%= event.project_count || (leaderboard ? leaderboard.length : 0) %></div>
          <div class="stat-lbl">Projects</div>
        </div>
        <div class="stat-badge">
          <div class="stat-val"><%= event.score_count != null ? event.score_count : (leaderboard ? leaderboard.reduce((acc, c) => acc + (c.reviews_count || 0), 0) : 0) %></div>
          <div class="stat-lbl">Reviews</div>
        </div>
        <div class="stat-badge">
          <div class="stat-val" style="color: <%= leaderboard && leaderboard.length > 0 ? '#16A34A' : '#D97706' %>;">
            <%= leaderboard && leaderboard.length > 0 ? 'Published' : 'In Progress' %>
          </div>
          <div class="stat-lbl">Status</div>
        </div>
      </div>
    </div>
  <% } %>

  <% if (!leaderboard || leaderboard.length === 0) { %>
    <div style="background: #fff; border: 3px solid #1A1A1A; box-shadow: 6px 6px 0 #1A1A1A; padding: 48px 24px; text-align: center; margin-bottom: 48px;">
      <div style="font-size: 3.5rem; margin-bottom: 12px;">⏳</div>
      <h2 style="font-size: 1.75rem; margin: 0 0 8px 0;">Results Not Yet Published</h2>
      <p style="color: #555; max-width: 580px; margin: 0 auto 24px auto; font-size: 1.05rem; line-height: 1.5;">
        <% if (event && event.project_count > 0) { %>
          Submissions for <strong><%= event.name %></strong> have been received! Judges are currently reviewing and scoring the <strong><%= event.project_count %> submitted projects</strong>. Final standings and normalized scores will appear here once scoring and normalization wrap up.
        <% } else { %>
          Submissions or evaluations for <strong><%= event ? event.name : 'this hackathon' %></strong> are still underway. The official leaderboard and awards will appear here once judging wraps up.
        <% } %>
      </p>

      <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
        <a href="/projects" style="display: inline-block; padding: 12px 24px; background: #1A1A1A; color: #fff; text-decoration: none; font-weight: bold; border: 2px solid #1A1A1A; box-shadow: 3px 3px 0 rgba(0,0,0,0.2);">
          🎨 Explore Project Gallery
        </a>
        <% const eventsWithScores = (typeof allEvents !== 'undefined' ? allEvents : []).filter(e => e.score_count > 0 && (!event || e.id !== event.id)); %>
        <% if (eventsWithScores.length > 0) { %>
          <a href="/results?event_id=<%= eventsWithScores[0].id %>" style="display: inline-block; padding: 12px 24px; background: #22C55E; color: #fff; text-decoration: none; font-weight: bold; border: 2px solid #1A1A1A; box-shadow: 3px 3px 0 #1A1A1A;">
            🏆 View Completed Results for <%= eventsWithScores[0].name %> &rarr;
          </a>
        <% } %>
      </div>
    </div>
  <% } else { %>

    <!-- ── 🥇 WINNERS PODIUM ────────────────────────────────────────── -->
    <h2>🥇 Top Winners</h2>
    <div class="podium-section">
      <% if (leaderboard[0]) { %>
      <div class="winner-card first">
        <div>
          <div class="winner-badge">🥇</div>
          <div class="winner-rank">1st Place — Grand Champion</div>
          <h3 class="winner-title">
            <a href="/projects/<%= leaderboard[0].project_id %>"><%= leaderboard[0].project_title %></a>
          </h3>
          <div class="winner-team">by <strong><%= leaderboard[0].team_name %></strong> · <%= leaderboard[0].track_name %></div>
        </div>
        <div>
          <div class="winner-score-pill">
            Normalized: <%= leaderboard[0].final_normalized_score != null ? (leaderboard[0].final_normalized_score > 0 ? '+' : '') + leaderboard[0].final_normalized_score.toFixed(3) : '--' %>
          </div>
        </div>
      </div>
      <% } %>

      <% if (leaderboard[1]) { %>
      <div class="winner-card second">
        <div>
          <div class="winner-badge">🥈</div>
          <div class="winner-rank">2nd Place — Runner-Up</div>
          <h3 class="winner-title">
            <a href="/projects/<%= leaderboard[1].project_id %>"><%= leaderboard[1].project_title %></a>
          </h3>
          <div class="winner-team">by <strong><%= leaderboard[1].team_name %></strong> · <%= leaderboard[1].track_name %></div>
        </div>
        <div>
          <div class="winner-score-pill" style="background:#475569;">
            Normalized: <%= leaderboard[1].final_normalized_score != null ? (leaderboard[1].final_normalized_score > 0 ? '+' : '') + leaderboard[1].final_normalized_score.toFixed(3) : '--' %>
          </div>
        </div>
      </div>
      <% } %>

      <% if (leaderboard[2]) { %>
      <div class="winner-card third">
        <div>
          <div class="winner-badge">🥉</div>
          <div class="winner-rank">3rd Place — Bronze Award</div>
          <h3 class="winner-title">
            <a href="/projects/<%= leaderboard[2].project_id %>"><%= leaderboard[2].project_title %></a>
          </h3>
          <div class="winner-team">by <strong><%= leaderboard[2].team_name %></strong> · <%= leaderboard[2].track_name %></div>
        </div>
        <div>
          <div class="winner-score-pill" style="background:#B45309;">
            Normalized: <%= leaderboard[2].final_normalized_score != null ? (leaderboard[2].final_normalized_score > 0 ? '+' : '') + leaderboard[2].final_normalized_score.toFixed(3) : '--' %>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- ── 🎖️ SPECIAL AWARDS ────────────────────────────────────────── -->
    <h2>🎖️ Special Awards & Recognitions</h2>
    <div class="awards-grid">
      <!-- Community Favorite Award -->
      <% if (communityFavorite) { %>
      <div class="award-card">
        <div class="award-icon">❤️</div>
        <div class="award-name">Community Choice Award</div>
        <div class="award-project">
          <a href="/projects/<%= communityFavorite.id %>"><%= communityFavorite.title %></a>
        </div>
        <div class="award-team">Team: <%= communityFavorite.team_name %> · <%= communityFavorite.vote_count %> Community Votes</div>
      </div>
      <% } %>

      <!-- Track Winners -->
      <% if (trackWinners && trackWinners.length > 0) { %>
        <% trackWinners.forEach(function(tw) { %>
        <div class="award-card">
          <div class="award-icon">🎯</div>
          <div class="award-name"><%= tw.track_name %> Best in Track</div>
          <div class="award-project">
            <a href="/projects/<%= tw.project_id %>"><%= tw.project_title %></a>
          </div>
          <div class="award-team">Team: <%= tw.team_name %></div>
        </div>
        <% }) %>
      <% } %>
    </div>

    <!-- ── 📊 PUBLISHED SCORES & LEADERBOARD ────────────────────────── -->
    <h2>📊 Full Leaderboard & Published Scores</h2>
    <div class="leaderboard-card">
      <table class="leaderboard-table">
        <thead>
          <tr>
            <th style="width: 70px;">Rank</th>
            <th>Project Title</th>
            <th>Team</th>
            <th>Track</th>
            <th style="text-align: right;">Reviews</th>
            <th style="text-align: right;">Raw Avg</th>
            <th style="text-align: right;">Normalized Score</th>
          </tr>
        </thead>
        <tbody>
          <% leaderboard.forEach(function(item) { %>
          <tr>
            <td>
              <% if (item.rank === 1) { %>
                <strong style="color: #d97706; font-size: 1.15em;">🥇 1</strong>
              <% } else if (item.rank === 2) { %>
                <strong style="color: #64748b; font-size: 1.15em;">🥈 2</strong>
              <% } else if (item.rank === 3) { %>
                <strong style="color: #b45309; font-size: 1.15em;">🥉 3</strong>
              <% } else { %>
                <strong>#<%= item.rank %></strong>
              <% } %>
            </td>
            <td>
              <a href="/projects/<%= item.project_id %>" style="color: #1A73E8; font-weight: bold; text-decoration: none;">
                <%= item.project_title %>
              </a>
              <% if (item.repo_url) { %>
                <div style="font-size: 0.8rem; margin-top: 2px;">
                  <a href="<%= item.repo_url %>" target="_blank" rel="noopener" style="color: #888; text-decoration: none;">GitHub ↗</a>
                </div>
              <% } %>
            </td>
            <td><%= item.team_name %></td>
            <td><span class="badge badge-track"><%= item.track_name || 'General' %></span></td>
            <td style="text-align: right;"><%= item.reviews_count || 0 %></td>
            <td style="text-align: right; font-weight: 500;">
              <%= item.avg_raw_score != null ? item.avg_raw_score.toFixed(2) : '--' %> / 5.00
            </td>
            <td style="text-align: right;">
              <strong style="color: <%= item.final_normalized_score > 0 ? '#15803D' : '#1A1A1A' %>;">
                <%= item.final_normalized_score != null ? (item.final_normalized_score > 0 ? '+' : '') + item.final_normalized_score.toFixed(3) : 'Pending' %>
              </strong>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  <% } %>
</div>

<%- include('layouts/footer') %>
