<%- include('../layouts/header', { title: 'Judging Re-evaluation Center', session, selectedEvent }) %>
<% locals._page = 'judging-reeval'; %>
<% var eid = (typeof selectedEvent !== 'undefined' && selectedEvent) ? selectedEvent.id : ''; %>

<div class="org-layout">
  <%- include('_sidebar') %>

  <main class="org-content">
    <div class="org-page-header">
      <div>
        <h1 class="org-page-title">🔄 Re-evaluation Center</h1>
        <p class="org-page-sub">Request score revisions, reset biased evaluations, and track review resolutions for <%= selectedEvent ? selectedEvent.name : 'Hackathon' %></p>
      </div>

      <div style="display:flex;gap:10px;">
        <button class="org-action-btn" onclick="document.getElementById('newReevalModal').style.display='flex'">+ Request Re-evaluation</button>
        <a href="/organizer/judging<%= eid ? '?event_id=' + eid : '' %>" class="org-action-btn org-action-btn-outline">Judging Center</a>
      </div>
    </div>

    <!-- Sub-navigation tabs -->
    <nav class="org-tabs">
      <a href="/organizer/judging<%= eid ? '?event_id=' + eid : '' %>" class="org-tab-item">Judging Center</a>
      <a href="/organizer/integrity<%= eid ? '?event_id=' + eid : '' %>" class="org-tab-item">Integrity Center</a>
      <a href="/organizer/reevaluation<%= eid ? '?event_id=' + eid : '' %>" class="org-tab-item active">Re-evaluation Requests</a>
      <a href="javascript:void(0)" onclick="document.getElementById('newReevalModal').style.display='flex'" class="org-tab-item">+ Request Re-eval</a>
    </nav>

    <!-- Requests Table -->
    <div class="org-card">
      <div class="org-card-header">
        <h3 class="org-card-title">Re-evaluation Requests (<%= (typeof requestsList !== 'undefined' && requestsList) ? requestsList.length : 0 %>)</h3>
      </div>

      <% var reqs = (typeof requestsList !== 'undefined' && requestsList) ? requestsList : []; %>
      <% if (reqs.length === 0) { %>
        <p class="org-empty">No active re-evaluation requests. All project scores are finalized.</p>
      <% } else { %>
        <table class="org-table">
          <thead>
            <tr>
              <th>Project Title</th>
              <th>Team</th>
              <th>Specific Judge</th>
              <th>Reason</th>
              <th>Status</th>
              <th>Logged Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% reqs.forEach(function(r) { %>
              <tr>
                <td><strong><%= r.project_title %></strong></td>
                <td><%= r.team_name || 'Team' %></td>
                <td><%= r.judge_name || 'All Assigned Judges' %></td>
                <td><%= r.reason %></td>
                <td>
                  <% if (r.status === 'resolved') { %>
                    <span class="org-status-chip org-status-done">Resolved</span>
                  <% } else { %>
                    <span class="org-status-chip org-status-pending">Pending Review</span>
                  <% } %>
                </td>
                <td><%= r.created_at ? r.created_at.slice(0, 10) : 'Recent' %></td>
                <td>
                  <% if (r.status !== 'resolved') { %>
                    <form method="POST" action="/organizer/reevaluation/resolve" style="display:inline;">
                      <input type="hidden" name="request_id" value="<%= r.id %>">
                      <input type="hidden" name="event_id" value="<%= eid %>">
                      <button type="submit" class="org-action-btn org-btn-success org-btn-sm">Mark Resolved</button>
                    </form>
                  <% } else { %>
                    <span style="font-size:0.8rem;color:#888;">Complete</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>

<!-- Modal for New Re-evaluation Request -->
<div id="newReevalModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:999;align-items:center;justify-content:center;">
  <div style="background:#fff;border-radius:8px;padding:24px;max-width:500px;width:90%;box-shadow:0 8px 30px rgba(0,0,0,0.2);">
    <h3 style="margin:0 0 14px;">Request Project Re-evaluation</h3>
    <form method="POST" action="/organizer/reevaluation/request">
      <input type="hidden" name="event_id" value="<%= eid %>">
      <div class="org-form-group">
        <label class="org-form-label">Select Project *</label>
        <select name="project_id" class="org-select" required>
          <option value="">Choose Project...</option>
          <% if (typeof projectsList !== 'undefined') { %>
            <% projectsList.forEach(function(p) { %>
              <option value="<%= p.id %>"><%= p.title %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <div class="org-form-group">
        <label class="org-form-label">Target Judge (Optional — Leave blank for all)</label>
        <select name="judge_id" class="org-select">
          <option value="">All Judges Assigned</option>
          <% if (typeof judgesList !== 'undefined') { %>
            <% judgesList.forEach(function(j) { %>
              <option value="<%= j.id %>"><%= j.name %></option>
            <% }); %>
          <% } %>
        </select>
        <span class="org-form-hint">Selecting a judge will reset their previous score to allow resubmission.</span>
      </div>
      <div class="org-form-group">
        <label class="org-form-label">Reason for Re-evaluation *</label>
        <textarea name="reason" class="org-textarea" rows="3" required placeholder="e.g. Broken demo link now repaired, massive scoring anomaly, conflict of interest"></textarea>
      </div>
      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px;">
        <button type="button" class="org-action-btn org-action-btn-outline" onclick="document.getElementById('newReevalModal').style.display='none'">Cancel</button>
        <button type="submit" class="org-action-btn">Submit Request</button>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
