<%- include('../layouts/header', { title: 'Invite Judge', session }) %>

<h1>Invite Judge</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error"><%= error %></div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
  <div class="banner"><%= success %></div>
<% } %>

<p>Share a judge's session cookie from the list below, or create a new judge user via the API.</p>

<h2>Seeded Judges with Fixed Sessions</h2>
<table>
  <thead>
    <tr>
      <th>Judge</th>
      <th>Session Cookie Value</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Tomas Varga (jdg_01)</td>
      <td><code>session=jdg_a_91bc</code></td>
    </tr>
    <tr>
      <td>Wei Lindqvist (jdg_02)</td>
      <td><code>session=jdg_b_44de</code></td>
    </tr>
  </tbody>
</table>

<p style="margin-top: 16px;">To assign a judge to a project, use the <a href="/organizer/assignments">Assignments</a> page or trigger auto-assignment.</p>

<h2>Auto-Assign Judges</h2>
<form method="POST" action="/api/organizer/assignments/auto">
  <button type="submit">Run Auto-Assignment</button>
</form>

<%- include('../layouts/footer') %>
