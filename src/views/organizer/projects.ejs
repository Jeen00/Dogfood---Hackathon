<%- include('../layouts/header', { title: 'Projects Management', session, selectedEvent }) %>
<% locals._page = 'projects-all'; %>
<% var eid = (typeof selectedEvent !== 'undefined' && selectedEvent) ? selectedEvent.id : ''; %>

<div class="org-layout">
  <%- include('_sidebar') %>

  <main class="org-content">
    <div class="org-page-header">
      <div>
        <h1 class="org-page-title">📁 Projects Management</h1>
        <p class="org-page-sub">Review submissions, repositories, demo links, tech stacks and shortlisted entries for <%= selectedEvent ? selectedEvent.name : 'Hackathon' %></p>
      </div>

      <div style="display:flex;gap:10px;">
        <a href="/projects<%= eid ? '?event_id=' + eid : '' %>" target="_blank" class="org-action-btn org-action-btn-outline">🔭 Public Gallery</a>
        <a href="/api/export.csv?type=projects<%= eid ? '&event_id=' + eid : '' %>" class="org-action-btn">📤 Export Projects CSV</a>
      </div>
    </div>

    <!-- Tabs matching user's tree -->
    <nav class="org-tabs">
      <a href="/organizer/projects<%= eid ? '?event_id=' + eid : '' %>" class="org-tab-item active">All Projects</a>
      <a href="/organizer/projects?status=draft<%= eid ? '&event_id=' + eid : '' %>" class="org-tab-item">Draft Projects</a>
      <a href="/organizer/projects?status=submitted<%= eid ? '&event_id=' + eid : '' %>" class="org-tab-item">Submitted</a>
      <a href="/organizer/projects?status=late<%= eid ? '&event_id=' + eid : '' %>" class="org-tab-item">Late Submissions</a>
      <a href="/organizer/projects?status=shortlisted<%= eid ? '&event_id=' + eid : '' %>" class="org-tab-item">Shortlisted</a>
      <a href="/organizer/projects?status=rejected<%= eid ? '&event_id=' + eid : '' %>" class="org-tab-item">Rejected</a>
      <a href="#repos" class="org-tab-item">GitHub / Repos</a>
      <a href="#demos" class="org-tab-item">Demo Links</a>
      <a href="#tags" class="org-tab-item">Tags & Tech</a>
      <a href="#bulk" class="org-tab-item">Bulk Actions</a>
    </nav>

    <!-- Projects Table -->
    <div class="org-card">
      <div class="org-card-header">
        <h3 class="org-card-title">Projects List (<%= (typeof projectList !== 'undefined' && projectList) ? projectList.length : 40 %>)</h3>
        <div style="display:flex;gap:8px;" id="bulk">
          <button class="org-action-btn org-btn-secondary org-btn-sm" onclick="alert('Bulk shortlist updated')">Shortlist</button>
          <button class="org-action-btn org-btn-danger org-btn-sm" onclick="alert('Bulk reject updated')">Reject</button>
        </div>
      </div>

      <% var projs = (typeof projectList !== 'undefined' && projectList) ? projectList : []; %>
      <% if (projs.length === 0) { %>
        <p class="org-empty">No projects found for this event filter.</p>
      <% } else { %>
        <table class="org-table">
          <thead>
            <tr>
              <th style="width:28px;"><input type="checkbox"></th>
              <th>Project Title</th>
              <th>Team</th>
              <th>Track</th>
              <th>Repository</th>
              <th>Demo</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% projs.forEach(function(p) { %>
              <tr>
                <td><input type="checkbox"></td>
                <td>
                  <a href="/projects/<%= p.id %>" target="_blank" style="font-weight:600;color:#1a73e8;"><%= p.title %></a>
                </td>
                <td><%= p.team_name || 'Team' %></td>
                <td><span class="org-track-chip"><%= p.track_name || 'General' %></span></td>
                <td>
                  <% if (p.repo_url) { %>
                    <a href="<%= p.repo_url %>" target="_blank" class="badge badge-tech" style="text-decoration:none;">GitHub ↗</a>
                  <% } else { %>—<% } %>
                </td>
                <td>
                  <% if (p.live_demo_url) { %>
                    <a href="<%= p.live_demo_url %>" target="_blank" style="color:#137333;font-size:0.8rem;text-decoration:none;">🟢 Live Demo</a>
                  <% } else { %>—<% } %>
                </td>
                <td><span class="org-status-chip org-status-done">Submitted</span></td>
                <td>
                  <a href="/projects/<%= p.id %>" class="org-action-btn org-action-btn-outline org-btn-sm">Inspect</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
