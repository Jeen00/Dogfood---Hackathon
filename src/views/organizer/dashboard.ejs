<%- include('../layouts/header', { title: (typeof selectedEvent !== 'undefined' && selectedEvent ? selectedEvent.name : 'Organizer Dashboard'), session, selectedEvent }) %>

<div style="margin-bottom: 20px;">
  <div style="margin-bottom: 6px;">
    <a href="/organizer/events" style="text-decoration: none; font-size: 0.9rem; font-weight: bold; color: #1a73e8;">&larr; All Hackathons</a>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <h1 style="margin: 0; padding: 0; border: none;"><%= typeof selectedEvent !== 'undefined' && selectedEvent ? selectedEvent.name : 'Organizer Dashboard' %></h1>
    <% if (typeof statusInfo !== 'undefined' && statusInfo) { %>
      <div style="display: flex; align-items: center; gap: 10px;">
        <span class="status-badge <%= statusInfo.badgeClass %>"><%= statusInfo.label %></span>
        <span style="font-weight: bold; font-size: 0.95rem; color: <%= statusInfo.status === 'running' ? '#137333' : '#555' %>;">
          ⏱ <%= statusInfo.timeText %>
        </span>
      </div>
    <% } %>
  </div>
</div>

<div class="dashboard-actions" style="margin-bottom: 24px;">
  <a href="/organizer/results<%= typeof selectedEvent !== 'undefined' && selectedEvent ? '?event_id=' + selectedEvent.id : '' %>" class="btn-action">Leaderboard Results</a>
  <a href="/api/export.csv<%= typeof selectedEvent !== 'undefined' && selectedEvent ? '?event_id=' + selectedEvent.id : '' %>" class="btn-action">Download CSV</a>
  <a href="/organizer/normalization<%= typeof selectedEvent !== 'undefined' && selectedEvent ? '?event_id=' + selectedEvent.id : '' %>" class="btn-action">Run Normalization</a>
  <a href="/organizer/assignments<%= typeof selectedEvent !== 'undefined' && selectedEvent ? '?event_id=' + selectedEvent.id : '' %>" class="btn-action">View Assignments</a>
  <a href="/organizer/rubric<%= typeof selectedEvent !== 'undefined' && selectedEvent ? '?event_id=' + selectedEvent.id : '' %>" class="btn-action">Rubric</a>
</div>



<h2>Judge Progress</h2>
<% if (judgeProgress.length === 0) { %>
  <p>No judges found.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Judge</th>
        <th>Assigned</th>
        <th>Completed</th>
        <th>Completion</th>
      </tr>
    </thead>
    <tbody>
      <% for (const j of judgeProgress) { %>
        <%
          var pct = j.assigned > 0
            ? Math.round((j.completed / j.assigned) * 100)
            : 0;
        %>
        <tr>
          <td><%= j.judge_name %></td>
          <td><%= j.assigned %></td>
          <td><%= j.completed %></td>
          <td><%= pct %>%</td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<h2>Project Coverage</h2>
<% if (projectCoverage.length === 0) { %>
  <p>No projects found.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Project Title</th>
        <th>Track</th>
        <th>Reviews Received</th>
        <th>Reviews Needed</th>
      </tr>
    </thead>
    <tbody>
      <% for (const p of projectCoverage) { %>
        <tr>
          <td><a href="/projects/<%= p.project_id %>"><%= p.project_title %></a></td>
          <td><%= p.track_name %></td>
          <td><%= p.reviews_received %></td>
          <td><%= p.reviews_needed %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('../layouts/footer') %>
