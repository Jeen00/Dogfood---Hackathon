<%- include('../layouts/header', { title: 'Create Event', session }) %>

<h1>Create New Event</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error"><%= error %></div>
<% } %>

<form method="POST" action="/api/events" class="form-narrow">
  <div class="form-group">
    <label for="name">Event Name</label>
    <input type="text" id="name" name="name" required maxlength="200">
  </div>
  <div class="form-group">
    <label for="submissions_open">Submissions Open</label>
    <input type="datetime-local" id="submissions_open" name="submissions_open">
  </div>
  <div class="form-group">
    <label for="submissions_close">Submissions Close</label>
    <input type="datetime-local" id="submissions_close" name="submissions_close">
  </div>
  <div class="form-group">
    <label for="voting_open">Voting Open</label>
    <input type="datetime-local" id="voting_open" name="voting_open">
  </div>
  <div class="form-group">
    <label for="voting_close">Voting Close</label>
    <input type="datetime-local" id="voting_close" name="voting_close">
  </div>

  <div class="form-group">
    <label for="judge_emails">Invite Judges (optional)</label>
    <p style="color:#555; font-size:0.85rem; margin:4px 0 8px 0;">
      Enter judge email addresses, one per line. Judges must have an account with the <strong>judge</strong> role.
      You can also invite judges later from the hackathon's "Invite Judges" section.
    </p>
    <textarea id="judge_emails" name="judge_emails" rows="4"
      style="width:100%; padding:9px 12px; border:1px solid #1A1A1A; font-family:monospace; font-size:0.9rem; background:#F5F5F0;"
      placeholder="judge1@example.com&#10;judge2@example.com"></textarea>
  </div>

  <button type="submit">Create Event</button>
  <a href="/organizer/events" style="margin-left: 16px;">Cancel</a>
</form>

<%- include('../layouts/footer') %>
