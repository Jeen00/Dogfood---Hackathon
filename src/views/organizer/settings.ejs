<%- include('../layouts/header', { title: 'Global Platform Settings', session, selectedEvent }) %>
<% locals._page = 'settings-general'; %>
<% var eid = (typeof selectedEvent !== 'undefined' && selectedEvent) ? selectedEvent.id : ''; %>

<div class="org-layout">
  <%- include('_sidebar') %>

  <main class="org-content">
    <div class="org-page-header">
      <div>
        <h1 class="org-page-title">⚙️ Organizer & Platform Settings</h1>
        <p class="org-page-sub">Configure platform defaults, permissions, integrations, API keys, and event rules</p>
      </div>
    </div>

    <!-- Sub-tabs covering all 13 items in user's tree -->
    <nav class="org-tabs">
      <a href="#general" class="org-tab-item active">General</a>
      <a href="#registration" class="org-tab-item">Registration</a>
      <a href="#team" class="org-tab-item">Teams</a>
      <a href="#submission" class="org-tab-item">Submissions</a>
      <a href="#judging" class="org-tab-item">Judging</a>
      <a href="#voting" class="org-tab-item">Voting</a>
      <a href="#notifications" class="org-tab-item">Notifications</a>
      <a href="#privacy" class="org-tab-item">Privacy</a>
      <a href="#roles" class="org-tab-item">Roles & Permissions</a>
      <a href="#integrations" class="org-tab-item">Integrations</a>
      <a href="#apikeys" class="org-tab-item">API Keys</a>
      <a href="#webhooks" class="org-tab-item">Webhooks</a>
      <a href="#danger" class="org-tab-item" style="color:#d93025;">Danger Zone</a>
    </nav>

    <div style="display:flex;flex-direction:column;gap:24px;max-width:900px;">

      <!-- 1. General Settings -->
      <section id="general" class="org-card">
        <h3 class="org-card-title" style="margin-bottom:14px;">1. 🌐 General Platform Settings</h3>
        <div class="org-form-grid">
          <div class="org-form-group">
            <label class="org-form-label">Platform Name</label>
            <input type="text" class="org-input" value="DOGFOOD Hackathon Platform">
          </div>
          <div class="org-form-group">
            <label class="org-form-label">Primary Timezone</label>
            <select class="org-select">
              <option>UTC (Coordinated Universal Time)</option>
              <option>EST / EDT (Eastern Time)</option>
              <option>PST / PDT (Pacific Time)</option>
              <option>IST (Indian Standard Time)</option>
            </select>
          </div>
        </div>
      </section>

      <!-- 2. Registration Settings & 3. Team Settings -->
      <section id="registration" class="org-card">
        <h3 class="org-card-title" style="margin-bottom:14px;">2. 👥 Registration & 3. 👨‍👩‍👧 Team Rules</h3>
        <div class="org-form-grid">
          <div class="org-form-group">
            <label class="org-form-label">Max Participants Capacity</label>
            <input type="number" class="org-input" value="1000">
          </div>
          <div class="org-form-group" id="team">
            <label class="org-form-label">Team Size Limit (Min - Max)</label>
            <div style="display:flex;gap:10px;">
              <input type="number" class="org-input" value="1" placeholder="Min" style="width:100px;">
              <input type="number" class="org-input" value="4" placeholder="Max" style="width:100px;">
            </div>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;font-size:0.85rem;">
          <label><input type="checkbox" checked> Allow solo builders (Team size = 1)</label>
          <label><input type="checkbox" checked> Allow team leader transfers</label>
          <label><input type="checkbox" checked> Require invite codes to join teams</label>
        </div>
      </section>

      <!-- 4. Submission & 5. Judging & 6. Voting -->
      <section id="submission" class="org-card">
        <h3 class="org-card-title" style="margin-bottom:14px;">4. 📁 Submissions, 5. ⚖️ Judging & 6. 🗳️ Voting Rules</h3>
        <div class="org-form-grid">
          <div class="org-form-group">
            <label class="org-form-label">Require GitHub Repo</label>
            <select class="org-select">
              <option>Mandatory for all submissions</option>
              <option>Optional</option>
            </select>
          </div>
          <div class="org-form-group" id="judging">
            <label class="org-form-label">Reviews Required per Project</label>
            <input type="number" class="org-input" value="3" min="1" max="10">
          </div>
          <div class="org-form-group" id="voting">
            <label class="org-form-label">Public Voting Access</label>
            <select class="org-select">
              <option>Authenticated users only (1 vote per project)</option>
              <option>Anyone with email verification</option>
              <option>Disabled</option>
            </select>
          </div>
        </div>
      </section>

      <!-- 7. Notifications & 8. Privacy -->
      <section id="notifications" class="org-card">
        <h3 class="org-card-title" style="margin-bottom:14px;">7. 🔔 Notifications & 8. 🔒 Privacy</h3>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:0.85rem;" id="privacy">
          <label><input type="checkbox" checked> Send automated email confirmation on project submission</label>
          <label><input type="checkbox" checked> Send weekly digest to registered judges</label>
          <label><input type="checkbox" checked> Mask participant emails from public gallery</label>
          <label><input type="checkbox" checked> Enable audit logging for all organizer actions</label>
        </div>
      </section>

      <!-- 9. Roles & Permissions -->
      <section id="roles" class="org-card">
        <h3 class="org-card-title" style="margin-bottom:14px;">9. 🛡️ Roles & Permissions</h3>
        <table class="org-table">
          <thead>
            <tr><th>Role</th><th>Manage Events</th><th>Assign Judges</th><th>Edit Rubric</th><th>View Leaderboard</th></tr>
          </thead>
          <tbody>
            <tr><td><strong>Organizer (Admin)</strong></td><td>✅ Full</td><td>✅ Full</td><td>✅ Full</td><td>✅ Full</td></tr>
            <tr><td><strong>Judge</strong></td><td>❌ None</td><td>❌ None</td><td>👁️ Read Only</td><td>👁️ After Publish</td></tr>
            <tr><td><strong>Participant</strong></td><td>❌ None</td><td>❌ None</td><td>👁️ Read Only</td><td>👁️ Public</td></tr>
          </tbody>
        </table>
      </section>

      <!-- 10. Integrations, 11. API Keys & 12. Webhooks -->
      <section id="integrations" class="org-card">
        <h3 class="org-card-title" style="margin-bottom:14px;">10. 🔌 Integrations, 11. 🔑 API Keys & 12. ⚡ Webhooks</h3>
        <div class="org-form-group" id="apikeys">
          <label class="org-form-label">Platform API Key</label>
          <div style="display:flex;gap:10px;">
            <input type="text" class="org-input" readonly value="dgf_live_9a7bc384e0214f9d8a1e" style="font-family:monospace;background:#f5f5f5;">
            <button class="org-action-btn org-action-btn-outline" onclick="alert('API key copied!')">Copy</button>
            <button class="org-action-btn org-btn-secondary" onclick="alert('New key generated.')">Regenerate</button>
          </div>
        </div>

        <div class="org-form-group" id="webhooks" style="margin-top:16px;">
          <label class="org-form-label">Webhook URL (Event Triggers)</label>
          <input type="url" class="org-input" placeholder="https://api.yourdomain.com/hackathon-webhook" value="">
          <span class="org-form-hint">Sends JSON payload on <code>project.submitted</code>, <code>judge.scored</code>, <code>results.published</code></span>
        </div>
      </section>

      <!-- 13. Danger Zone -->
      <section id="danger" class="org-card" style="border:1px solid #fce8e6;background:#fff8f8;">
        <h3 class="org-card-title" style="color:#d93025;margin-bottom:10px;">13. ⚠️ Danger Zone</h3>
        <p style="font-size:0.85rem;color:#666;margin-bottom:14px;">Irreversible administrative actions for this instance.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <button class="org-action-btn org-btn-danger" onclick="alert('Reset cache initiated.')">Flush Redis & Cache</button>
          <button class="org-action-btn org-btn-danger" onclick="if(confirm('Clear test sessions?')) alert('Cleared.')">Clear Inactive Sessions</button>
        </div>
      </section>

      <div>
        <button class="org-action-btn" style="padding:10px 24px;font-size:0.95rem;" onclick="alert('Settings saved successfully!')">
          💾 Save All Settings
        </button>
      </div>

    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
