<%- include('../layouts/header', { title: 'Analytics & Insights', session, selectedEvent }) %>
<% locals._page = 'analytics-overview'; %>
<% var eid = (typeof selectedEvent !== 'undefined' && selectedEvent) ? selectedEvent.id : ''; %>

<div class="org-layout">
  <%- include('_sidebar') %>

  <main class="org-content">
    <div class="org-page-header">
      <div>
        <h1 class="org-page-title">📊 Analytics & Reporting</h1>
        <p class="org-page-sub">Comprehensive data analytics covering registration velocity, submission conversion, score distribution, and judge metrics</p>
      </div>

      <a href="/api/export.csv?type=complete<%= eid ? '&event_id=' + eid : '' %>" class="org-action-btn">
        📥 Export Analytics Bundle
      </a>
    </div>

    <!-- Tabs matching user's tree -->
    <nav class="org-tabs">
      <a href="#overview" class="org-tab-item active">Overview</a>
      <a href="#reg" class="org-tab-item">Registration</a>
      <a href="#part" class="org-tab-item">Participants</a>
      <a href="#teams" class="org-tab-item">Teams</a>
      <a href="#subs" class="org-tab-item">Submissions</a>
      <a href="#tracks" class="org-tab-item">Tracks</a>
      <a href="#judges" class="org-tab-item">Judges</a>
      <a href="#progress" class="org-tab-item">Judging Progress</a>
      <a href="#scores" class="org-tab-item">Score Distribution</a>
      <a href="#voting" class="org-tab-item">Voting Analytics</a>
      <a href="#engagement" class="org-tab-item">Engagement</a>
      <a href="#views" class="org-tab-item">Traffic / Views</a>
      <a href="#reports" class="org-tab-item">Custom Reports</a>
    </nav>

    <!-- KPI Cards Overview -->
    <div class="org-stat-grid" id="overview" style="grid-template-columns:repeat(4,1fr);margin-bottom:24px;">
      <div class="org-stat-card">
        <div class="org-stat-icon" style="background:#e8f0fe">👥</div>
        <div class="org-stat-body">
          <div class="org-stat-value">124</div>
          <div class="org-stat-label">Total Participants</div>
        </div>
      </div>
      <div class="org-stat-card">
        <div class="org-stat-icon" style="background:#e6f4ea">📁</div>
        <div class="org-stat-body">
          <div class="org-stat-value">40</div>
          <div class="org-stat-label">Submitted Projects</div>
        </div>
      </div>
      <div class="org-stat-card">
        <div class="org-stat-icon" style="background:#fff3e0">📈</div>
        <div class="org-stat-body">
          <div class="org-stat-value">95.2%</div>
          <div class="org-stat-label">Team Submission Rate</div>
        </div>
      </div>
      <div class="org-stat-card">
        <div class="org-stat-icon" style="background:#fce8e6">👁️</div>
        <div class="org-stat-body">
          <div class="org-stat-value">1,840</div>
          <div class="org-stat-label">Gallery Page Views</div>
        </div>
      </div>
    </div>

    <!-- Two-Col Analytics Charts -->
    <div class="org-two-col">

      <!-- Registration & Participant Velocity -->
      <div class="org-card" id="reg">
        <div class="org-card-header">
          <h3 class="org-card-title">📈 Registration & Team Growth</h3>
        </div>
        <div class="dash-status-pills">
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">Participants</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:85%;height:100%;background:#1a73e8;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">124</span>
          </div>
          <div class="dash-status-pill-row" id="teams">
            <span class="dash-status-pill-label">Formed Teams</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:42%;height:100%;background:#137333;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">42</span>
          </div>
          <div class="dash-status-pill-row" id="subs">
            <span class="dash-status-pill-label">Submissions</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:40%;height:100%;background:#e37400;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">40</span>
          </div>
        </div>
      </div>

      <!-- Track Submissions Breakdown -->
      <div class="org-card" id="tracks">
        <div class="org-card-header">
          <h3 class="org-card-title">🎯 Submissions by Track</h3>
        </div>
        <div class="dash-status-pills">
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">Web & Cloud</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:75%;height:100%;background:#4285f4;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">14</span>
          </div>
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">AI / ML</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:65%;height:100%;background:#34a853;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">12</span>
          </div>
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">Mobile Dev</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:45%;height:100%;background:#fbbc05;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">8</span>
          </div>
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">Cybersecurity</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:35%;height:100%;background:#ea4335;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">6</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Score Distribution & Judging Progress -->
    <div class="org-two-col" style="margin-top:24px;">

      <div class="org-card" id="scores">
        <div class="org-card-header">
          <h3 class="org-card-title">📊 Score Distribution (Normalized)</h3>
        </div>
        <p style="font-size:0.83rem;color:#666;">Frequency of normalized project evaluation scores:</p>
        <div class="dash-status-pills">
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">9.0 - 10.0 (Top 10%)</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:25%;height:100%;background:#137333;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">4</span>
          </div>
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">8.0 - 8.9 (High)</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:65%;height:100%;background:#1a73e8;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">14</span>
          </div>
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">7.0 - 7.9 (Average)</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:75%;height:100%;background:#fbbc05;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">16</span>
          </div>
          <div class="dash-status-pill-row">
            <span class="dash-status-pill-label">&lt; 7.0 (Needs work)</span>
            <div class="dash-status-pill-bar-wrap">
              <div style="width:30%;height:100%;background:#ea4335;border-radius:4px;"></div>
            </div>
            <span class="dash-status-pill-count">6</span>
          </div>
        </div>
      </div>

      <div class="org-card" id="voting">
        <div class="org-card-header">
          <h3 class="org-card-title">🗳️ Voting & Engagement</h3>
        </div>
        <table class="org-table">
          <tbody>
            <tr><td>Total Public Votes Cast</td><td><strong>482</strong></td></tr>
            <tr><td>Unique Voters</td><td><strong>216</strong></td></tr>
            <tr><td>Comments Posted</td><td><strong>84</strong></td></tr>
            <tr><td>Project Bookmarks / Saves</td><td><strong>195</strong></td></tr>
            <tr><td>Avg Reviews per Project</td><td><strong>3.4</strong></td></tr>
          </tbody>
        </table>
      </div>

    </div>

    <!-- Custom Reports Section -->
    <div class="org-card" id="reports" style="margin-top:24px;">
      <div class="org-card-header">
        <h3 class="org-card-title">📄 Generate Custom Reports</h3>
      </div>
      <p style="font-size:0.85rem;color:#666;">Export filtered datasets tailored for sponsors, academic partners, or leadership decks.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <button class="org-action-btn org-action-btn-outline" onclick="alert('Sponsor summary generated.')">Executive Sponsor Summary (PDF)</button>
        <button class="org-action-btn org-action-btn-outline" onclick="alert('Demographics breakdown generated.')">Participant Demographics (CSV)</button>
        <button class="org-action-btn org-action-btn-outline" onclick="alert('Judge scoring matrix generated.')">Full Scoring Audit Report (CSV)</button>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
