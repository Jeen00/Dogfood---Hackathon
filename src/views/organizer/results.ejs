<%- include('../layouts/header', { title: 'Hackathon Results & Final Standings', session, selectedEvent }) %>
<% locals._page = 'results-overview'; %>
<% var eid = (typeof selectedEvent !== 'undefined' && selectedEvent) ? selectedEvent.id : ''; %>

<div class="org-layout">
  <%- include('_sidebar') %>

  <main class="org-content">
    <div class="org-page-header">
      <div>
        <h1 class="org-page-title">🏆 Results & Final Rankings</h1>
        <p class="org-page-sub">Review normalized leaderboard rankings, track winners, runner-ups, and publish results for <%= selectedEvent ? selectedEvent.name : 'Hackathon' %></p>
      </div>

      <div style="display:flex;gap:10px;align-items:center;">
        <button class="org-action-btn org-btn-success" id="publish" onclick="alert('Results published to public gallery!')">
          📢 Publish Results
        </button>
        <button class="org-action-btn org-action-btn-outline" id="hide" onclick="alert('Results hidden from public')">
          🔒 Hide Results
        </button>
        <a href="/api/export.csv<%= eid ? '?event_id=' + eid : '' %>" class="org-action-btn">
          📥 Download CSV Export
        </a>
      </div>
    </div>

    <!-- Horizontal sub-navbar tabs for all 11 Results sub-items -->
    <nav class="org-tabs">
      <a href="#overview" class="org-tab-item active">Results Overview</a>
      <a href="#shortlist" class="org-tab-item">Shortlisted Projects</a>
      <a href="#rankings" class="org-tab-item">Final Rankings</a>
      <a href="#winners" class="org-tab-item">Winners</a>
      <a href="#categories" class="org-tab-item">Award Categories</a>
      <a href="#special" class="org-tab-item">Special Awards</a>
      <a href="#track-winners" class="org-tab-item">Track Winners</a>
      <a href="#runner-ups" class="org-tab-item">Runner-ups</a>
      <a href="#history" class="org-tab-item">Result History</a>
    </nav>

    <!-- Podium Winners Display -->
    <div class="org-stat-grid" id="winners" style="grid-template-columns:repeat(3, 1fr);margin-bottom:24px;">
      <div class="org-card" style="border:2px solid #ffd700;background:#fffdf0;text-align:center;">
        <div style="font-size:2.5rem;margin-bottom:4px;">🥇</div>
        <div style="font-weight:700;font-size:1.1rem;color:#b45309;">1st Place Winner</div>
        <div style="font-size:1rem;font-weight:600;margin:6px 0;">Autonomous Drone Delivery</div>
        <span class="badge badge-tech">Robotics & Cloud</span>
        <div style="margin-top:10px;font-size:0.9rem;font-weight:700;color:#137333;">Score: +2.140 Z-score ($15,000)</div>
      </div>

      <div class="org-card" style="border:2px solid #c0c0c0;background:#fafafa;text-align:center;">
        <div style="font-size:2.5rem;margin-bottom:4px;">🥈</div>
        <div style="font-weight:700;font-size:1.1rem;color:#64748b;">2nd Place Winner</div>
        <div style="font-size:1rem;font-weight:600;margin:6px 0;">EcoRoute EV Charging Planner</div>
        <span class="badge badge-tech">Web Development</span>
        <div style="margin-top:10px;font-size:0.9rem;font-weight:700;color:#137333;">Score: +1.890 Z-score ($8,000)</div>
      </div>

      <div class="org-card" id="runner-ups" style="border:2px solid #cd7f32;background:#fffaf5;text-align:center;">
        <div style="font-size:2.5rem;margin-bottom:4px;">🥉</div>
        <div style="font-weight:700;font-size:1.1rem;color:#b45309;">3rd Place Winner</div>
        <div style="font-size:1rem;font-weight:600;margin:6px 0;">AI Healthcare Triage Assistant</div>
        <span class="badge badge-tech">AI / ML</span>
        <div style="margin-top:10px;font-size:0.9rem;font-weight:700;color:#137333;">Score: +1.640 Z-score ($4,000)</div>
      </div>
    </div>

    <!-- Final Rankings Table -->
    <div class="org-card" id="rankings">
      <div class="org-card-header">
        <h3 class="org-card-title">Official Final Standings (Cross-Judge Normalized)</h3>
        <a href="/organizer/normalization<%= eid ? '?event_id=' + eid : '' %>" class="org-card-link">Re-Run Normalization →</a>
      </div>

      <% if (typeof leaderboard === 'undefined' || !leaderboard || leaderboard.length === 0) { %>
        <p class="org-empty">No normalized scores computed yet. Run score normalization first.</p>
      <% } else { %>
        <table class="org-table">
          <thead>
            <tr>
              <th style="width:70px;">Rank</th>
              <th>Project Title</th>
              <th>Team</th>
              <th>Track</th>
              <th style="text-align:right;">Reviews</th>
              <th style="text-align:right;">Avg Raw Score</th>
              <th style="text-align:right;">Normalized Score</th>
            </tr>
          </thead>
          <tbody>
            <% leaderboard.forEach(function(item) { %>
              <tr>
                <td>
                  <% if (item.rank === 1) { %>
                    <strong style="color:#d97706;font-size:1.1rem;">🥇 1</strong>
                  <% } else if (item.rank === 2) { %>
                    <strong style="color:#64748b;font-size:1.1rem;">🥈 2</strong>
                  <% } else if (item.rank === 3) { %>
                    <strong style="color:#b45309;font-size:1.1rem;">🥉 3</strong>
                  <% } else { %>
                    <strong>#<%= item.rank %></strong>
                  <% } %>
                </td>
                <td>
                  <a href="/projects/<%= item.project_id %>" style="color:#1a73e8;font-weight:600;"><%= item.project_title %></a>
                  <% if (item.repo_url) { %>
                    <div style="font-size:0.75rem;"><a href="<%= item.repo_url %>" target="_blank" style="color:#888;"><%= item.repo_url %></a></div>
                  <% } %>
                </td>
                <td><%= item.team_name %></td>
                <td><span class="org-track-chip"><%= item.track_name %></span></td>
                <td style="text-align:right;"><%= item.reviews_count %></td>
                <td style="text-align:right;"><%= item.avg_raw_score != null ? item.avg_raw_score.toFixed(2) : '--' %> / 10</td>
                <td style="text-align:right;">
                  <strong><%= item.final_normalized_score != null ? (item.final_normalized_score > 0 ? '+' : '') + item.final_normalized_score.toFixed(3) : 'Pending' %></strong>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Special Awards & Track Winners Two-Col -->
    <div class="org-two-col" style="margin-top:24px;">
      <div class="org-card" id="track-winners">
        <div class="org-card-header">
          <h3 class="org-card-title">🎯 Track Winners</h3>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:0.86rem;">
          <div style="padding:10px;border:1px solid #eee;border-radius:6px;background:#fafafa;">
            <strong>Best Web & Cloud Solution:</strong> EcoRoute EV Charging ($2,500)
          </div>
          <div style="padding:10px;border:1px solid #eee;border-radius:6px;background:#fafafa;">
            <strong>Best AI/ML Application:</strong> Healthcare Triage Assistant ($2,500)
          </div>
          <div style="padding:10px;border:1px solid #eee;border-radius:6px;background:#fafafa;">
            <strong>Best Mobile Experience:</strong> Dry Harbour Emergency App ($2,500)
          </div>
        </div>
      </div>

      <div class="org-card" id="special">
        <div class="org-card-header">
          <h3 class="org-card-title">⭐ Special Award Categories</h3>
        </div>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:0.86rem;">
          <div style="padding:10px;border:1px solid #eee;border-radius:6px;background:#fafafa;">
            <strong>People's Choice Award:</strong> Autonomous Drone Delivery (48 Votes)
          </div>
          <div style="padding:10px;border:1px solid #eee;border-radius:6px;background:#fafafa;">
            <strong>Best UI / UX Design:</strong> Smart Expense Tracker
          </div>
          <div style="padding:10px;border:1px solid #eee;border-radius:6px;background:#fafafa;">
            <strong>Sustainability Champion:</strong> Solar Grid Optimizer
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
