<%- include('../layouts/header', { title: 'Hackathon Results & Leaderboard', session }) %>

<div class="breadcrumb" style="margin-bottom: 16px;">
  <a href="/organizer/dashboard">Dashboard</a> / Leaderboard Results
</div>

<h1>Hackathon Results & Final Standings</h1>
<p style="color: #666; margin-bottom: 24px;">Rankings calculated from cross-judge Z-score normalization.</p>

<div class="dashboard-actions" style="margin-bottom: 24px;">
  <a href="/api/export.csv" class="btn-action">Download CSV Export</a>
  <a href="/organizer/normalization" class="btn-action">Re-Run Normalization</a>
  <a href="/organizer/dashboard" class="btn-secondary">Back to Dashboard</a>
</div>

<% if (!leaderboard || leaderboard.length === 0) { %>
  <p>No project scores available yet.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th style="width: 60px;">Rank</th>
        <th>Project Title</th>
        <th>Team</th>
        <th>Track</th>
        <th style="text-align: right;">Reviews</th>
        <th style="text-align: right;">Avg Raw Score</th>
        <th style="text-align: right;">Normalized Score</th>
      </tr>
    </thead>
    <tbody>
      <% for (const item of leaderboard) { %>
        <tr>
          <td>
            <% if (item.rank === 1) { %>
              <strong style="color: #d97706; font-size: 1.1em;">🥇 1</strong>
            <% } else if (item.rank === 2) { %>
              <strong style="color: #64748b; font-size: 1.1em;">🥈 2</strong>
            <% } else if (item.rank === 3) { %>
              <strong style="color: #b45309; font-size: 1.1em;">🥉 3</strong>
            <% } else { %>
              <%= item.rank %>
            <% } %>
          </td>
          <td>
            <a href="/projects/<%= item.project_id %>"><strong><%= item.project_title %></strong></a>
            <% if (item.repo_url) { %>
              <div style="font-size: 0.85em;"><a href="<%= item.repo_url %>" target="_blank" rel="noopener noreferrer" style="color: #888;"><%= item.repo_url %></a></div>
            <% } %>
          </td>
          <td><%= item.team_name %></td>
          <td><%= item.track_name %></td>
          <td style="text-align: right;"><%= item.reviews_count %></td>
          <td style="text-align: right;"><%= item.avg_raw_score != null ? item.avg_raw_score.toFixed(2) : '--' %> / 5.00</td>
          <td style="text-align: right;">
            <strong><%= item.final_normalized_score != null ? (item.final_normalized_score > 0 ? '+' : '') + item.final_normalized_score.toFixed(3) : 'Pending' %></strong>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('../layouts/footer') %>
