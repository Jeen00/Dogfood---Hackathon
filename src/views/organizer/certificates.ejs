<%- include('../layouts/header', { title: 'Certificates & Credentials', session, selectedEvent }) %>
<% locals._page = 'certificates-templates'; %>
<% var eid = (typeof selectedEvent !== 'undefined' && selectedEvent) ? selectedEvent.id : ''; %>

<div class="org-layout">
  <%- include('_sidebar') %>

  <main class="org-content">
    <div class="org-page-header">
      <div>
        <h1 class="org-page-title">🎓 Certificates & Digital Credentials</h1>
        <p class="org-page-sub">Generate, customize, and issue verifiable digital certificates for participants, finalists, and winners of <%= selectedEvent ? selectedEvent.name : 'Hackathon' %></p>
      </div>

      <button class="org-action-btn" onclick="alert('Bulk certificate generation initiated.')">+ Bulk Generate All</button>
    </div>

    <!-- Tabs matching user's tree -->
    <nav class="org-tabs">
      <a href="#templates" class="org-tab-item active">Certificate Templates</a>
      <a href="#participation" class="org-tab-item">Participation</a>
      <a href="#finalist" class="org-tab-item">Finalist</a>
      <a href="#winner" class="org-tab-item">Winner</a>
      <a href="#special" class="org-tab-item">Special Award</a>
      <a href="#generate" class="org-tab-item">Generate</a>
      <a href="#history" class="org-tab-item">History</a>
      <a href="#verify" class="org-tab-item">Verify Certificate</a>
    </nav>

    <!-- Certificate Templates Grid -->
    <div class="org-stat-grid" id="templates" style="grid-template-columns:repeat(auto-fill, minmax(280px, 1fr));gap:20px;margin-bottom:24px;">

      <!-- Participation -->
      <div class="org-card" id="participation">
        <div style="background:#e8f0fe;height:120px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin-bottom:12px;">
          🎓
        </div>
        <h3 class="org-card-title">Certificate of Participation</h3>
        <p style="font-size:0.83rem;color:#666;margin:6px 0 14px;">Issued to all registered builders who submitted a valid project.</p>
        <div style="display:flex;gap:8px;">
          <button class="org-action-btn org-btn-sm" onclick="alert('Generated preview for Participation')">Preview</button>
          <button class="org-action-btn org-action-btn-outline org-btn-sm" onclick="alert('Issuing 124 participation certificates')">Issue to All (124)</button>
        </div>
      </div>

      <!-- Finalist -->
      <div class="org-card" id="finalist">
        <div style="background:#fff3e0;height:120px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin-bottom:12px;">
          🥈
        </div>
        <h3 class="org-card-title">Finalist Certificate</h3>
        <p style="font-size:0.83rem;color:#666;margin:6px 0 14px;">Issued to top 10 ranked teams after normalized score evaluation.</p>
        <div style="display:flex;gap:8px;">
          <button class="org-action-btn org-btn-sm" onclick="alert('Generated preview for Finalist')">Preview</button>
          <button class="org-action-btn org-action-btn-outline org-btn-sm" onclick="alert('Issuing finalist certificates')">Issue to Top 10</button>
        </div>
      </div>

      <!-- Winner -->
      <div class="org-card" id="winner">
        <div style="background:#fce8e6;height:120px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin-bottom:12px;">
          🏆
        </div>
        <h3 class="org-card-title">Winner Certificate</h3>
        <p style="font-size:0.83rem;color:#666;margin:6px 0 14px;">Grand Prize 1st, 2nd, and 3rd place credentials with prize endorsements.</p>
        <div style="display:flex;gap:8px;">
          <button class="org-action-btn org-btn-sm" onclick="alert('Generated preview for Winner')">Preview</button>
          <button class="org-action-btn org-action-btn-outline org-btn-sm" onclick="alert('Issuing winners certificates')">Issue to Winners (3)</button>
        </div>
      </div>

      <!-- Special Award -->
      <div class="org-card" id="special">
        <div style="background:#e8f5e9;height:120px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin-bottom:12px;">
          ⭐
        </div>
        <h3 class="org-card-title">Special Track Award</h3>
        <p style="font-size:0.83rem;color:#666;margin:6px 0 14px;">Custom badge for Best AI, Most Innovative, Best Design, and Sponsor challenges.</p>
        <div style="display:flex;gap:8px;">
          <button class="org-action-btn org-btn-sm" onclick="alert('Generated preview for Special Award')">Preview</button>
          <button class="org-action-btn org-action-btn-outline org-btn-sm" onclick="alert('Issuing track awards')">Issue Track Awards</button>
        </div>
      </div>

    </div>

    <!-- Verify Certificate Search -->
    <div class="org-card" id="verify">
      <div class="org-card-header">
        <h3 class="org-card-title">🔍 Verification Portal Check</h3>
      </div>
      <p style="font-size:0.85rem;color:#666;">Validate authenticity of a certificate ID.</p>
      <div style="display:flex;gap:10px;max-width:500px;">
        <input type="text" class="org-input" placeholder="e.g. CERT-2026-DGF-8841A">
        <button class="org-action-btn" onclick="alert('Certificate verified: Issued to Priya Sharma on Sept 28, 2026.')">Verify</button>
      </div>
    </div>
  </main>
</div>

<%- include('../layouts/footer') %>
