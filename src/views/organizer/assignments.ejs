<%- include('../layouts/header', { title: 'Judge Assignments', session }) %>

<h1>Judge Assignments</h1>

<div style="margin-bottom: 16px;">
  <form method="POST" action="/api/organizer/assignments/auto" style="display: inline;">
    <button type="submit">Run Auto-Assignment</button>
  </form>
</div>

<% if (assignments.length === 0) { %>
  <p>No assignments found. Run auto-assignment to create them.</p>
<% } else { %>
  <p><%= assignments.length %> total assignment<%= assignments.length === 1 ? '' : 's' %>.</p>
  <table>
    <thead>
      <tr>
        <th>Judge</th>
        <th>Project</th>
        <th>Track</th>
      </tr>
    </thead>
    <tbody>
      <% for (const a of assignments) { %>
        <tr>
          <td><%= a.judge_name %></td>
          <td><%= a.project_title %></td>
          <td><%= a.track_name %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('../layouts/footer') %>
