<%- include('../layouts/header', { title: 'Judge Invites — ' + selectedEvent.name, session, selectedEvent }) %>

<div style="margin-bottom: 16px;">
  <a href="/organizer/events" style="font-size:0.9rem; font-weight:bold; color:#1a73e8;">&larr; All Hackathons</a>
</div>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
  <div>
    <h1 style="margin:0; padding:0; border:none;">Invite Judges — <%= selectedEvent.name %></h1>
    <div style="margin-top:6px; display:flex; gap:10px; align-items:center;">
      <span class="status-badge <%= statusInfo.badgeClass %>"><%= statusInfo.label %></span>
      <span style="font-size:0.9rem; color:#555;">⏱ <%= statusInfo.timeText %></span>
    </div>
  </div>
</div>

<% if (canInvite) { %>
  <div style="background:#fff; border:2px solid #1A1A1A; padding:20px; margin-bottom:28px;">
    <h2 style="margin:0 0 14px 0; font-size:1.1rem;">Send New Invite</h2>
    <p style="color:#555; margin:0 0 14px 0; font-size:0.9rem;">
      Enter a judge's email address or select from registered judges.
      Invites can be sent up to 6 hours before the hackathon begins.
    </p>
    <form id="invite-form" style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
      <div style="flex:1; min-width:260px;">
        <label for="judge_email" style="display:block; font-weight:bold; margin-bottom:6px; font-size:0.9rem;">Judge Email</label>
        <input type="email" id="judge_email" list="judges-list" placeholder="e.g. tomas.varga@example.org" required
          style="width:100%; padding:9px 12px; border:1px solid #1A1A1A; font-size:0.95rem; background:#F5F5F0;">
        <datalist id="judges-list">
          <% if (typeof availableJudges !== 'undefined' && availableJudges) { %>
            <% for (const j of availableJudges) { %>
              <option value="<%= j.email %>"><%= j.name %> (<%= j.email %>)</option>
            <% } %>
          <% } %>
        </datalist>
      </div>
      <button type="submit" id="btn-submit-invite" class="btn-action" style="white-space:nowrap;">Send Invite</button>
    </form>

    <% if (typeof availableJudges !== 'undefined' && availableJudges && availableJudges.length > 0) { %>
      <div style="margin-top: 14px; font-size: 0.85rem; color: #555;">
        <span style="font-weight: bold; margin-right: 6px;">Registered Judges:</span>
        <% for (const j of availableJudges.slice(0, 8)) { %>
          <button type="button" onclick="document.getElementById('judge_email').value='<%= j.email %>'"
            style="display: inline-block; background: #E8E8E4; border: 1px solid #ccc; padding: 2px 8px; margin: 2px 4px 2px 0; font-size: 0.8rem; cursor: pointer; color: #1A1A1A;">
            <%= j.name %> (<%= j.email %>)
          </button>
        <% } %>
      </div>
    <% } %>

    <div id="invite-msg" style="margin-top:10px; font-size:0.9rem; display:none;"></div>
  </div>
<% } else { %>
  <div style="background:#FFF3CD; border:1px solid #FFC107; padding:14px 18px; margin-bottom:24px; font-size:0.95rem;">
    ⚠️ <strong><%= inviteBlockReason %></strong>
  </div>
<% } %>

<h2 id="invites-heading" style="font-size:1.1rem; margin-bottom:12px;">Sent Invites (<span id="invites-count"><%= invites.length %></span>)</h2>

<div id="invites-container">
  <% if (invites.length === 0) { %>
    <p id="no-invites-msg" style="color:#666;">No invites sent yet for this hackathon.</p>
  <% } else { %>
    <table id="invites-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Judge Name</th>
          <th>Status</th>
          <th>Sent</th>
          <th>Responded</th>
          <% if (canInvite) { %><th>Action</th><% } %>
        </tr>
      </thead>
      <tbody id="invites-tbody">
        <% for (const inv of invites) { %>
          <tr id="row-inv-<%= inv.id %>">
            <td><%= inv.judge_email %></td>
            <td><%= inv.judge_name || '—' %></td>
            <td id="status-cell-<%= inv.id %>">
              <% if (inv.status === 'accepted') { %>
                <span style="color:#137333; font-weight:bold;">✓ Accepted</span>
              <% } else if (inv.status === 'rejected') { %>
                <span style="color:#c5221f; font-weight:bold;">✗ Rejected</span>
              <% } else { %>
                <span style="color:#854d0e; font-weight:bold;">⏳ Pending</span>
              <% } %>
            </td>
            <td style="font-size:0.85rem;"><%= inv.created_at ? inv.created_at.slice(0,16).replace('T',' ') : '—' %></td>
            <td id="resp-cell-<%= inv.id %>" style="font-size:0.85rem;"><%= inv.responded_at ? inv.responded_at.slice(0,16).replace('T',' ') : '—' %></td>
            <% if (canInvite) { %>
              <td id="action-cell-<%= inv.id %>">
                <% if (inv.status === 'pending') { %>
                  <button onclick="cancelInvite('<%= inv.id %>')"
                    style="background:#fee2e2; border:1px solid #c5221f; color:#c5221f; font-weight:bold; cursor:pointer; padding:4px 10px; font-size:0.82rem;">
                    Cancel
                  </button>
                <% } else { %>—<% } %>
              </td>
            <% } %>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</div>

<script>
(function() {
  var form      = document.getElementById('invite-form');
  var msg       = document.getElementById('invite-msg');
  var submitBtn = document.getElementById('btn-submit-invite');
  var eventId   = '<%= selectedEvent.id %>';
  var canInvite = <%= canInvite ? 'true' : 'false' %>;

  // Track known statuses to fire real-time toast alerts on state change
  var knownStatuses = {};
  <% for (const inv of invites) { %>
    knownStatuses['<%= inv.id %>'] = '<%= inv.status %>';
  <% } %>

  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var input = document.getElementById('judge_email');
      var email = input.value.trim();
      if (!email) return;

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      fetch('/api/invites', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event_id: eventId, judge_email: email })
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Invite';

        if (data.error) {
          msg.style.display = 'block';
          msg.style.color = '#c5221f';
          msg.textContent = data.error;
          if (window.showToast) window.showToast(data.error, 'error');
        } else {
          msg.style.display = 'block';
          msg.style.color = '#137333';
          msg.textContent = data.message;
          if (window.showToast) window.showToast(data.message, 'success');
          input.value = '';

          // Real-time refresh without page reload
          fetchInvites();
        }
      })
      .catch(function() {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Invite';
        msg.style.display = 'block';
        msg.style.color = '#c5221f';
        msg.textContent = 'Network error. Please try again.';
      });
    });
  }

  // Real-time live poll every 3 seconds for updates without refresh
  function fetchInvites() {
    fetch('/api/invites?event_id=' + encodeURIComponent(eventId))
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var invites = data.invites || [];
        renderInvitesTable(invites);

        // Check if any status changed in real-time
        invites.forEach(function(inv) {
          var prev = knownStatuses[inv.id];
          if (prev && prev === 'pending' && inv.status !== 'pending') {
            if (inv.status === 'accepted') {
              if (window.showToast) window.showToast('Judge ' + (inv.judge_name || inv.judge_email) + ' accepted your invite!', 'success');
            } else if (inv.status === 'rejected') {
              if (window.showToast) window.showToast('Judge ' + (inv.judge_name || inv.judge_email) + ' declined your invite.', 'error');
            }
          }
          knownStatuses[inv.id] = inv.status;
        });
      })
      .catch(function(){});
  }

  setInterval(fetchInvites, 3500);

  function renderInvitesTable(invites) {
    document.getElementById('invites-count').textContent = invites.length;
    var container = document.getElementById('invites-container');

    if (invites.length === 0) {
      container.innerHTML = '<p id="no-invites-msg" style="color:#666;">No invites sent yet for this hackathon.</p>';
      return;
    }

    var html = '<table id="invites-table">' +
      '<thead><tr><th>Email</th><th>Judge Name</th><th>Status</th><th>Sent</th><th>Responded</th>' +
      (canInvite ? '<th>Action</th>' : '') + '</tr></thead><tbody id="invites-tbody">';

    invites.forEach(function(inv) {
      var statusBadge = '';
      if (inv.status === 'accepted') {
        statusBadge = '<span style="color:#137333; font-weight:bold;">✓ Accepted</span>';
      } else if (inv.status === 'rejected') {
        statusBadge = '<span style="color:#c5221f; font-weight:bold;">✗ Rejected</span>';
      } else {
        statusBadge = '<span style="color:#854d0e; font-weight:bold;">⏳ Pending</span>';
      }

      var actionHtml = '';
      if (canInvite) {
        actionHtml = inv.status === 'pending'
          ? '<button onclick="cancelInvite(\'' + inv.id + '\')" style="background:#fee2e2; border:1px solid #c5221f; color:#c5221f; font-weight:bold; cursor:pointer; padding:4px 10px; font-size:0.82rem;">Cancel</button>'
          : '—';
      }

      html += '<tr id="row-inv-' + inv.id + '">' +
        '<td>' + (inv.judge_email || '') + '</td>' +
        '<td>' + (inv.judge_name || '—') + '</td>' +
        '<td>' + statusBadge + '</td>' +
        '<td style="font-size:0.85rem;">' + (inv.created_at ? inv.created_at.slice(0,16).replace('T',' ') : '—') + '</td>' +
        '<td style="font-size:0.85rem;">' + (inv.responded_at ? inv.responded_at.slice(0,16).replace('T',' ') : '—') + '</td>' +
        (canInvite ? '<td>' + actionHtml + '</td>' : '') +
        '</tr>';
    });

    html += '</tbody></table>';
    container.innerHTML = html;
  }

  window.cancelInvite = function(id) {
    fetch('/api/invites/' + id, { method: 'DELETE' })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.message) {
          if (window.showToast) window.showToast('Invite cancelled.', 'info');
          delete knownStatuses[id];
          fetchInvites();
        } else {
          alert(data.error || 'Failed to cancel');
        }
      })
      .catch(function() {
        alert('Network error. Failed to cancel invite.');
      });
  };
})();
</script>

<%- include('../layouts/footer') %>
