<%- include('layouts/header', { title: 'Login', session: null }) %>

<h1>Login</h1>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="error"><%= error %></div>
<% } %>

<form method="POST" action="/auth/login" class="form-narrow">
  <div class="form-group">
    <label for="email">Email address</label>
    <input type="email" id="email" name="email" required autocomplete="email">
  </div>
  <div class="form-group">
    <label for="password">Password</label>
    <input type="password" id="password" name="password" required autocomplete="current-password">
  </div>
  <button type="submit">Login</button>
</form>

<p style="margin-top: 16px; font-size: 0.9em; color: #555;">
  For demo access, use any email from the seeded data with any non-empty password.
</p>

<%- include('layouts/footer') %>
