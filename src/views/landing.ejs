<%- include('layouts/header', { title: 'Welcome', session, selectedEvent: undefined, selectedJudgeEvent: undefined }) %>

<style>
  .hero-section {
    background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
    color: white;
    padding: 70px 20px 60px 20px;
    text-align: center;
    border-bottom: 4px solid #1a1a1a;
  }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    margin: 0 0 16px 0;
    letter-spacing: -1px;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto 32px auto;
    opacity: 0.9;
  }
  .countdown-box {
    display: inline-flex;
    gap: 16px;
    background: rgba(0, 0, 0, 0.25);
    padding: 18px 24px;
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    margin-bottom: 30px;
  }
  .time-unit {
    display: flex;
    flex-direction: column;
    min-width: 70px;
  }
  .time-val {
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .time-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
    margin-top: 4px;
  }
  .btn-large {
    display: inline-block;
    background: #fff;
    color: #1a73e8;
    font-size: 1.05rem;
    font-weight: bold;
    padding: 12px 28px;
    border-radius: 4px;
    text-decoration: none;
    border: 2px solid #fff;
    transition: all 0.2s;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }
  .btn-large:hover {
    background: #f8f9fa;
    transform: translateY(-2px);
  }
  .btn-large.outline {
    background: transparent;
    color: white;
    border-color: white;
  }
  .btn-large.gold {
    background: #D97706;
    color: white;
    border-color: #D97706;
  }

  /* ── 3-Way Portal Pathways (Gallery, Tracks, Results) ── */
  .portal-pathways-wrap {
    max-width: 1100px;
    margin: -35px auto 40px auto;
    padding: 0 20px;
    position: relative;
    z-index: 10;
  }
  .portal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
  }
  .portal-card {
    background: #fff;
    border: 3px solid #1A1A1A;
    box-shadow: 6px 6px 0 #1A1A1A;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s, box-shadow 0.15s;
    text-decoration: none;
    color: inherit;
  }
  .portal-card:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 #1A1A1A;
  }
  .portal-icon {
    font-size: 2.2rem;
    margin-bottom: 12px;
  }
  .portal-title {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 8px 0;
    color: #1A1A1A;
  }
  .portal-desc {
    font-size: 0.92rem;
    color: #555;
    line-height: 1.5;
    margin-bottom: 18px;
  }
  .portal-link-text {
    font-weight: 800;
    font-size: 0.95rem;
    color: #1A73E8;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Status Announcement Banners */
  .status-announcement-banner {
    max-width: 1060px;
    margin: 20px auto 10px auto;
    padding: 16px 24px;
    border: 2px solid #1A1A1A;
    box-shadow: 4px 4px 0 #1A1A1A;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }
  .status-announcement-banner.closed {
    background: #FFFBEB;
    border-color: #D97706;
    box-shadow: 4px 4px 0 #D97706;
  }
  .status-announcement-banner.voting-open {
    background: #F0FDF4;
    border-color: #16A34A;
    box-shadow: 4px 4px 0 #16A34A;
  }

  .stats-bar {
    display: flex;
    justify-content: center;
    gap: 40px;
    padding: 30px 20px;
    background: #f8f9fa;
    border-bottom: 2px solid #ddd;
    border-top: 2px solid #ddd;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .stat-item {
    text-align: center;
  }
  .stat-val {
    font-size: 2rem;
    font-weight: 900;
    color: #1a73e8;
  }
  .stat-label {
    font-size: 0.85rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .content-section {
    max-width: 1000px;
    margin: 50px auto;
    padding: 0 20px;
  }
  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .track-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .track-card {
    background: #fff;
    border: 2px solid #1a1a1a;
    padding: 24px;
    box-shadow: 4px 4px 0px #1a1a1a;
    transition: transform 0.2s, box-shadow 0.2s;
    height: 100%;
    box-sizing: border-box;
  }
  .track-card:hover {
    transform: translateY(-4px);
    box-shadow: 6px 6px 0px #1a1a1a;
  }
  .track-title {
    font-size: 1.2rem;
    font-weight: bold;
    margin: 0 0 8px 0;
    color: #1a1a1a;
  }
  .track-desc {
    font-size: 0.9rem;
    color: #555;
    line-height: 1.5;
    margin-bottom: 12px;
  }
  .track-action {
    font-size: 0.85rem;
    font-weight: bold;
    color: #1A73E8;
  }
  .dates-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    background: #fff;
    border: 2px solid #1a1a1a;
  }
  .dates-table th, .dates-table td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  .dates-table th {
    background: #f1f5f9;
    font-weight: bold;
    width: 30%;
  }
</style>

<% if (event) { %>
  <!-- ── 1. Hero Section ─────────────────────────────────────────── -->
  <div class="hero-section">
    <h1 class="hero-title"><%= event.name %></h1>
    <p class="hero-subtitle">Join us for an incredible hackathon of building, learning, and competing. Build the future with us.</p>
    
    <div class="countdown-box" id="countdown" data-close="<%= event.submissions_close %>" data-voting-close="<%= event.voting_close || '' %>">
      <div class="time-unit">
        <span class="time-val" id="cd-d">--</span>
        <span class="time-label">Days</span>
      </div>
      <div class="time-unit">
        <span class="time-val" id="cd-h">--</span>
        <span class="time-label">Hours</span>
      </div>
      <div class="time-unit">
        <span class="time-val" id="cd-m">--</span>
        <span class="time-label">Minutes</span>
      </div>
      <div class="time-unit">
        <span class="time-val" id="cd-s">--</span>
        <span class="time-label">Seconds</span>
      </div>
    </div>

    <div style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
      <a href="/projects" class="btn-large" style="background:#4CAF50; color:#fff; border-color:#4CAF50;">🖼️ Browse Gallery</a>
      <a href="#tracks-section" class="btn-large outline">🎯 Explore Tracks</a>
      <a href="/results" class="btn-large gold">🏆 Live Results</a>
      
      <% if (!session) { %>
        <a href="/login" class="btn-large" style="margin-left: 8px;">Log In</a>
      <% } else if (session.role === 'organizer' || session.role === 'admin') { %>
        <a href="/organizer/dashboard?event_id=<%= event.id %>" class="btn-large outline">Organizer Dashboard</a>
      <% } else if (session.role === 'judge') { %>
        <a href="/judge/dashboard?event_id=<%= event.id %>" class="btn-large outline">Judge Dashboard</a>
      <% } else if (session.role === 'participant') { %>
        <a href="/team/events" class="btn-large outline">My Hackathons</a>
      <% } %>
    </div>
  </div>

  <!-- ── 2. Voting Status / Results Banner ───────────────────────── -->
  <% if (typeof votingClosed !== 'undefined' && votingClosed) { %>
  <div class="status-announcement-banner closed">
    <div>
      <strong style="color: #92400E; font-size: 1.05rem; display: block;">🏆 Voting has Concluded!</strong>
      <span style="color: #B45309; font-size: 0.9rem;">The judging period has concluded and final winners & awards are published on the Leaderboard.</span>
    </div>
    <a href="/results" style="background: #D97706; color: #fff; padding: 10px 20px; font-weight: bold; text-decoration: none; border-radius: 4px; border: 2px solid #1A1A1A; box-shadow: 2px 2px 0 #1A1A1A;">
      View Final Standings →
    </a>
  </div>
  <% } else if (typeof votingOpen !== 'undefined' && votingOpen) { %>
  <div class="status-announcement-banner voting-open">
    <div>
      <strong style="color: #15803D; font-size: 1.05rem; display: block;">🗳️ Community Voting is LIVE!</strong>
      <span style="color: #166534; font-size: 0.9rem;">Explore projects in the gallery, test live demos, and upvote your favorite submissions.</span>
    </div>
    <a href="/projects" style="background: #16A34A; color: #fff; padding: 10px 20px; font-weight: bold; text-decoration: none; border-radius: 4px; border: 2px solid #1A1A1A; box-shadow: 2px 2px 0 #1A1A1A;">
      Cast Your Vote in Gallery →
    </a>
  </div>
  <% } %>

  <!-- ── 3. The 3 Public Pathways: Gallery | Tracks | Results ────── -->
  <div class="portal-pathways-wrap">
    <div class="portal-grid">
      <!-- Portal 1: Gallery -->
      <a href="/projects" class="portal-card">
        <div>
          <div class="portal-icon">🖼️</div>
          <h3 class="portal-title">Project Gallery</h3>
          <p class="portal-desc">
            Discover all submitted hackathon projects. Search by tech stack, difficulty, team size, and filter by tags.
          </p>
        </div>
        <div class="portal-link-text">Browse Projects (<%= stats.projects %> Built) →</div>
      </a>

      <!-- Portal 2: Tracks -->
      <a href="#tracks-section" class="portal-card">
        <div>
          <div class="portal-icon">🎯</div>
          <h3 class="portal-title">Hackathon Tracks</h3>
          <p class="portal-desc">
            Explore focused challenge areas, problem statements, and browse projects categorized by specific tracks.
          </p>
        </div>
        <div class="portal-link-text">Explore <%= tracks.length %> Tracks →</div>
      </a>

      <!-- Portal 3: Results -->
      <a href="/results" class="portal-card">
        <div>
          <div class="portal-icon">🏆</div>
          <h3 class="portal-title">Results & Leaderboard</h3>
          <p class="portal-desc">
            Check out the official podium winners, track prize champions, Community Choice awards, and normalized scores.
          </p>
        </div>
        <div class="portal-link-text">View Standings & Awards →</div>
      </a>
    </div>
  </div>

  <!-- ── 4. Live Statistics Bar ──────────────────────────────────── -->
  <div class="stats-bar">
    <div class="stat-item">
      <div class="stat-val"><%= stats.projects %></div>
      <div class="stat-label">Projects Built</div>
    </div>
    <div class="stat-item">
      <div class="stat-val"><%= stats.participants %></div>
      <div class="stat-label">Participants</div>
    </div>
    <div class="stat-item">
      <div class="stat-val"><%= stats.judges %></div>
      <div class="stat-label">Judges</div>
    </div>
    <div class="stat-item">
      <div class="stat-val"><%= tracks.length %></div>
      <div class="stat-label">Tracks</div>
    </div>
  </div>

  <!-- ── 5. Hackathon Tracks (Clickable to Filter Gallery) ───────── -->
  <div class="content-section" id="tracks-section">
    <h2>🎯 Hackathon Tracks</h2>
    <p style="color: #666; font-size: 1rem; margin-top: -6px;">
      Click any track below to view and filter projects submitted in that category.
    </p>

    <% if (tracks.length > 0) { %>
      <div class="tracks-grid">
        <% tracks.forEach((t, i) => { 
          const colors = ['#e0e7ff', '#dcfce7', '#fef3c7', '#fee2e2', '#f3e8ff', '#ccfbf1'];
          const bg = colors[i % colors.length];
        %>
          <a href="/projects?track=<%= t.id %>" class="track-card-link" title="View <%= t.name %> Projects">
            <div class="track-card">
              <div style="background: <%= bg %>; width: 44px; height: 44px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 14px;">
                <%= ['🚀','🌱','💡','🎨','🔧','📊'][i % 6] %>
              </div>
              <h3 class="track-title"><%= t.name %></h3>
              <p class="track-desc"><%= t.description || 'Solve real-world challenges in this category.' %></p>
              <div class="track-action">Browse <%= t.name %> Projects →</div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color: #666; font-style: italic;">Tracks for this hackathon haven't been announced yet.</p>
    <% } %>
  </div>

  <!-- ── 6. Key Dates & Voting Timeline ─────────────────────────── -->
  <div class="content-section">
    <h2>📅 Key Dates & Schedule</h2>
    <table class="dates-table">
      <tr>
        <th>Submissions Open</th>
        <td><%= new Date(event.submissions_open).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      </tr>
      <tr>
        <th>Submissions Close</th>
        <td><%= new Date(event.submissions_close).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      </tr>
      <% if (event.voting_open) { %>
      <tr>
        <th>Voting Opens</th>
        <td><%= new Date(event.voting_open).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      </tr>
      <% } %>
      <% if (event.voting_close) { %>
      <tr>
        <th>Voting Closes</th>
        <td><%= new Date(event.voting_close).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      </tr>
      <% } %>
    </table>
  </div>

  <!-- ── Client-Side Countdown & Stage Detection ────────────────── -->
  <script>
    (function() {
      const cd = document.getElementById('countdown');
      if (!cd) return;
      const targetStr = cd.getAttribute('data-close');
      if (!targetStr) return;
      const targetDate = new Date(targetStr).getTime();

      const dEl = document.getElementById('cd-d');
      const hEl = document.getElementById('cd-h');
      const mEl = document.getElementById('cd-m');
      const sEl = document.getElementById('cd-s');

      function update() {
        const now = new Date().getTime();
        const diff = targetDate - now;

        if (diff <= 0) {
          dEl.innerText = '00';
          hEl.innerText = '00';
          mEl.innerText = '00';
          sEl.innerText = '00';
          return;
        }

        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);

        dEl.innerText = d.toString().padStart(2, '0');
        hEl.innerText = h.toString().padStart(2, '0');
        mEl.innerText = m.toString().padStart(2, '0');
        sEl.innerText = s.toString().padStart(2, '0');
      }

      update();
      setInterval(update, 1000);
    })();
  </script>

<% } else { %>
  <div class="hero-section" style="padding: 120px 20px;">
    <h1 class="hero-title">Welcome to the Platform</h1>
    <p class="hero-subtitle">There are currently no active hackathons. Check back later!</p>
    <% if (!session) { %>
      <a href="/login" class="btn-large">Log in</a>
    <% } %>
  </div>
<% } %>

<%- include('layouts/footer') %>
