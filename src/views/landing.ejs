<%- include('layouts/header', { title: 'Welcome', session, selectedEvent: undefined, selectedJudgeEvent: undefined }) %>

<style>
  .hero-section {
    background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
    color: white;
    padding: 80px 20px;
    text-align: center;
    border-bottom: 4px solid #1a1a1a;
  }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    margin: 0 0 16px 0;
    letter-spacing: -1px;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    max-width: 600px;
    margin: 0 auto 32px auto;
    opacity: 0.9;
  }
  .countdown-box {
    display: inline-flex;
    gap: 16px;
    background: rgba(0, 0, 0, 0.2);
    padding: 20px;
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 32px;
  }
  .time-unit {
    display: flex;
    flex-direction: column;
    min-width: 70px;
  }
  .time-val {
    font-size: 2.5rem;
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .time-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
    margin-top: 4px;
  }
  .stats-bar {
    display: flex;
    justify-content: center;
    gap: 40px;
    padding: 30px 20px;
    background: #f8f9fa;
    border-bottom: 2px solid #ddd;
    flex-wrap: wrap;
  }
  .stat-item {
    text-align: center;
  }
  .stat-val {
    font-size: 2rem;
    font-weight: 900;
    color: #1a73e8;
  }
  .stat-label {
    font-size: 0.85rem;
    color: #666;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .content-section {
    max-width: 1000px;
    margin: 60px auto;
    padding: 0 20px;
  }
  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .track-card {
    background: #fff;
    border: 2px solid #1a1a1a;
    padding: 24px;
    box-shadow: 4px 4px 0px #1a1a1a;
    transition: transform 0.2s;
  }
  .track-card:hover {
    transform: translateY(-4px);
  }
  .track-title {
    font-size: 1.25rem;
    font-weight: bold;
    margin: 0 0 12px 0;
    color: #1a1a1a;
  }
  .track-desc {
    font-size: 0.95rem;
    color: #555;
    line-height: 1.5;
  }
  .dates-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 24px;
    background: #fff;
    border: 2px solid #1a1a1a;
  }
  .dates-table th, .dates-table td {
    padding: 16px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  .dates-table th {
    background: #f1f5f9;
    font-weight: bold;
    width: 30%;
  }
  .btn-large {
    display: inline-block;
    background: #fff;
    color: #1a73e8;
    font-size: 1.1rem;
    font-weight: bold;
    padding: 14px 32px;
    border-radius: 4px;
    text-decoration: none;
    border: 2px solid #fff;
    transition: all 0.2s;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  }
  .btn-large:hover {
    background: #f8f9fa;
    transform: translateY(-2px);
  }
</style>

<% if (event) { %>
  <div class="hero-section">
    <h1 class="hero-title"><%= event.name %></h1>
    <p class="hero-subtitle">Join us for an incredible weekend of building, learning, and competing. Build the future with us.</p>
    
    <div class="countdown-box" id="countdown" data-close="<%= event.submissions_close %>">
      <div class="time-unit">
        <span class="time-val" id="cd-d">--</span>
        <span class="time-label">Days</span>
      </div>
      <div class="time-unit">
        <span class="time-val" id="cd-h">--</span>
        <span class="time-label">Hours</span>
      </div>
      <div class="time-unit">
        <span class="time-val" id="cd-m">--</span>
        <span class="time-label">Minutes</span>
      </div>
      <div class="time-unit">
        <span class="time-val" id="cd-s">--</span>
        <span class="time-label">Seconds</span>
      </div>
    </div>

    <div>
      <% if (session) { %>
        <a href="/projects" class="btn-large" style="background:#4CAF50; color:#fff; border-color:#4CAF50;">Go to Gallery</a>
        <% if (session.role === 'organizer' || session.role === 'admin') { %>
          <a href="/organizer/dashboard?event_id=<%= event.id %>" class="btn-large" style="margin-left: 12px; background: transparent; color: white;">Organizer Dashboard</a>
        <% } else if (session.role === 'judge') { %>
          <a href="/judge/dashboard?event_id=<%= event.id %>" class="btn-large" style="margin-left: 12px; background: transparent; color: white;">Judge Dashboard</a>
        <% } else if (session.role === 'participant') { %>
          <a href="/team/events" class="btn-large" style="margin-left: 12px; background: transparent; color: white;">My Hackathons</a>
        <% } %>
      <% } else { %>
        <a href="/login" class="btn-large">Log in to Participate</a>
        <a href="/projects" class="btn-large" style="margin-left: 12px; background: transparent; color: white;">View Gallery</a>
      <% } %>
    </div>
  </div>

  <div class="stats-bar">
    <div class="stat-item">
      <div class="stat-val"><%= stats.projects %></div>
      <div class="stat-label">Projects Built</div>
    </div>
    <div class="stat-item">
      <div class="stat-val"><%= stats.participants %></div>
      <div class="stat-label">Participants</div>
    </div>
    <div class="stat-item">
      <div class="stat-val"><%= stats.judges %></div>
      <div class="stat-label">Judges</div>
    </div>
    <div class="stat-item">
      <div class="stat-val"><%= tracks.length %></div>
      <div class="stat-label">Tracks</div>
    </div>
  </div>

  <div class="content-section">
    <h2>📅 Key Dates</h2>
    <table class="dates-table">
      <tr>
        <th>Submissions Open</th>
        <td><%= new Date(event.submissions_open).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      </tr>
      <tr>
        <th>Submissions Close</th>
        <td><%= new Date(event.submissions_close).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      </tr>
      <% if (event.voting_open) { %>
      <tr>
        <th>Voting Opens</th>
        <td><%= new Date(event.voting_open).toLocaleString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
      </tr>
      <% } %>
    </table>
  </div>

  <div class="content-section">
    <h2>🎯 Hackathon Tracks</h2>
    <% if (tracks.length > 0) { %>
      <div class="tracks-grid">
        <% tracks.forEach((t, i) => { 
          const colors = ['#e0e7ff', '#dcfce7', '#fef3c7', '#fee2e2', '#f3e8ff', '#ccfbf1'];
          const bg = colors[i % colors.length];
        %>
          <div class="track-card">
            <div style="background: <%= bg %>; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 16px;">
              <%= ['🚀','🌱','💡','🎨','🔧','📊'][i % 6] %>
            </div>
            <h3 class="track-title"><%= t.name %></h3>
            <p class="track-desc"><%= t.description || 'Join this track to build something amazing in this category.' %></p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p style="color: #666; font-style: italic;">Tracks for this hackathon haven't been announced yet.</p>
    <% } %>
  </div>

  <script>
    (function() {
      const cd = document.getElementById('countdown');
      if (!cd) return;
      const targetStr = cd.getAttribute('data-close');
      if (!targetStr) return;
      const targetDate = new Date(targetStr).getTime();

      const dEl = document.getElementById('cd-d');
      const hEl = document.getElementById('cd-h');
      const mEl = document.getElementById('cd-m');
      const sEl = document.getElementById('cd-s');

      function update() {
        const now = new Date().getTime();
        const diff = targetDate - now;

        if (diff <= 0) {
          dEl.innerText = '00';
          hEl.innerText = '00';
          mEl.innerText = '00';
          sEl.innerText = '00';
          const label = document.createElement('div');
          label.innerText = 'Submissions Closed';
          label.style.position = 'absolute';
          label.style.bottom = '-30px';
          label.style.left = '0';
          label.style.width = '100%';
          label.style.fontSize = '1rem';
          label.style.fontWeight = 'bold';
          label.style.color = '#ffb0b0';
          cd.style.position = 'relative';
          cd.appendChild(label);
          return;
        }

        const d = Math.floor(diff / (1000 * 60 * 60 * 24));
        const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((diff % (1000 * 60)) / 1000);

        dEl.innerText = d.toString().padStart(2, '0');
        hEl.innerText = h.toString().padStart(2, '0');
        mEl.innerText = m.toString().padStart(2, '0');
        sEl.innerText = s.toString().padStart(2, '0');
      }

      update();
      setInterval(update, 1000);
    })();
  </script>

<% } else { %>
  <div class="hero-section" style="padding: 120px 20px;">
    <h1 class="hero-title">Welcome to the Platform</h1>
    <p class="hero-subtitle">There are currently no active hackathons. Check back later!</p>
    <% if (!session) { %>
      <a href="/login" class="btn-large">Log in</a>
    <% } %>
  </div>
<% } %>

<%- include('layouts/footer') %>
