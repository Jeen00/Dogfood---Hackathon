<%- include('layouts/header', { title: 'Project Gallery' }) %>

<!-- ═══════════════════════════════════════════════════════════════
     GALLERY PAGE
     ═══════════════════════════════════════════════════════════════ -->

<div class="gallery-page-header">
  <h1 class="gallery-title">Project Gallery</h1>
  <p class="gallery-subtitle">Discover, explore and build interesting projects</p>
</div>

<!-- ── Global Search Bar ─────────────────────────────────────────── -->
<form class="gallery-search-form" id="searchForm" method="GET" action="/projects">
  <div class="gallery-search-bar">
    <input
      type="text"
      name="q"
      id="searchInput"
      class="gallery-search-input"
      placeholder="Search by title, description, tags or technology…"
      value="<%= typeof q !== 'undefined' ? q : '' %>"
      autocomplete="off"
    >
    <button type="submit" class="gallery-search-btn">Search</button>
  </div>
  <!-- Preserve other active filters when submitting search -->
  <% if (typeof track !== 'undefined' && track) { %><input type="hidden" name="track" value="<%= track %>"><% } %>
  <% if (typeof difficulty !== 'undefined' && difficulty) { %><input type="hidden" name="difficulty" value="<%= difficulty %>"><% } %>
  <% if (typeof status !== 'undefined' && status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
  <% if (typeof open_source !== 'undefined' && open_source) { %><input type="hidden" name="open_source" value="1"><% } %>
  <% if (typeof has_demo !== 'undefined' && has_demo) { %><input type="hidden" name="has_demo" value="1"><% } %>
  <% if (typeof contributors !== 'undefined' && contributors) { %><input type="hidden" name="contributors" value="1"><% } %>
  <% if (typeof sort !== 'undefined' && sort) { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
</form>

<!-- ── Main Layout: Sidebar + Grid ───────────────────────────────── -->
<div class="gallery-layout">

  <!-- ── Sidebar Filters ─────────────────────────────────────────── -->
  <aside class="gallery-sidebar">
    <form class="filter-form" id="filterForm" method="GET" action="/projects">
      <!-- Preserve search query -->
      <% if (typeof q !== 'undefined' && q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
      <input type="hidden" name="sort" id="hiddenSort" value="<%= typeof sort !== 'undefined' ? sort : 'newest' %>">

      <!-- Track -->
      <div class="filter-section">
        <div class="filter-label">Track</div>
        <label class="filter-radio">
          <input type="radio" name="track" value="" <%= (!track) ? 'checked' : '' %>> All Tracks
        </label>
        <% tracks.forEach(function(t) { %>
        <label class="filter-radio">
          <input type="radio" name="track" value="<%= t.id %>" <%= (track == t.id) ? 'checked' : '' %>> <%= t.name %>
        </label>
        <% }) %>
      </div>

      <!-- Difficulty -->
      <div class="filter-section">
        <div class="filter-label">Difficulty</div>
        <% ['', 'beginner', 'intermediate', 'advanced'].forEach(function(d) { %>
        <label class="filter-radio">
          <input type="radio" name="difficulty" value="<%= d %>" <%= (difficulty === d) ? 'checked' : '' %>>
          <%= d ? (d.charAt(0).toUpperCase() + d.slice(1)) : 'All' %>
        </label>
        <% }) %>
      </div>

      <!-- Status -->
      <div class="filter-section">
        <div class="filter-label">Status</div>
        <%
          var statusOptions = [
            { val: '', label: 'All' },
            { val: 'submitted', label: 'Submitted' },
            { val: 'in_development', label: 'In Development' },
            { val: 'completed', label: 'Completed' },
            { val: 'live', label: 'Live' },
            { val: 'open_for_contributors', label: 'Open for Contributors' }
          ];
        %>
        <% statusOptions.forEach(function(s) { %>
        <label class="filter-radio">
          <input type="radio" name="status" value="<%= s.val %>" <%= (status === s.val) ? 'checked' : '' %>> <%= s.label %>
        </label>
        <% }) %>
      </div>

      <!-- Checkboxes -->
      <div class="filter-section">
        <div class="filter-label">More Filters</div>
        <label class="filter-checkbox">
          <input type="checkbox" name="open_source" value="1" <%= (open_source) ? 'checked' : '' %>> Open Source Only
        </label>
        <label class="filter-checkbox">
          <input type="checkbox" name="has_demo" value="1" <%= (has_demo) ? 'checked' : '' %>> Has Live Demo
        </label>
        <label class="filter-checkbox">
          <input type="checkbox" name="contributors" value="1" <%= (contributors) ? 'checked' : '' %>> Looking for Contributors
        </label>
      </div>

      <a href="/projects" class="filter-clear-btn">Clear All Filters</a>
    </form>
  </aside>

  <!-- ── Right Column ───────────────────────────────────────────── -->
  <div class="gallery-main">

    <!-- Sort Bar -->
    <div class="gallery-sort-bar">
      <span class="gallery-count"><strong><%= total %></strong> Project<%= total !== 1 ? 's' : '' %> Found</span>
      <div class="gallery-sort-right">
        <label for="sortSelect" class="sort-label">Sort by:</label>
        <select name="sort" id="sortSelect" class="sort-select">
          <% var currentSort = (typeof sort !== 'undefined' && sort) ? sort : 'newest'; %>
          <option value="newest"   <%= currentSort === 'newest'   ? 'selected' : '' %>>Newest</option>
          <option value="updated"  <%= currentSort === 'updated'  ? 'selected' : '' %>>Recently Updated</option>
          <option value="views"    <%= currentSort === 'views'    ? 'selected' : '' %>>Most Viewed</option>
          <option value="votes"    <%= currentSort === 'votes'    ? 'selected' : '' %>>Most Voted</option>
          <option value="saves"    <%= currentSort === 'saves'    ? 'selected' : '' %>>Most Saved</option>
          <option value="trending" <%= currentSort === 'trending' ? 'selected' : '' %>>Trending</option>
        </select>
      </div>
    </div>

    <!-- ── Trending Strip (only on page 1, no active filters) ──── -->
    <%
      var noFiltersActive = !q && !track && !difficulty && !status && !open_source && !has_demo && !contributors;
      var isPageOne = (typeof page === 'undefined' || page == 1);
      var trendingProjects = (projects && projects.length >= 4) ? projects.slice(0, 4) : projects;
    %>
    <% if (noFiltersActive && isPageOne && trendingProjects && trendingProjects.length > 0) { %>
    <div class="trending-section">
      <div class="trending-heading">🔥 Trending Right Now</div>
      <div class="trending-strip">
        <% trendingProjects.forEach(function(tp, ti) { %>
        <a href="/projects/<%= tp.id %>" class="trending-card" style="--track-hue: <%= (ti * 60) % 360 %>deg">
          <div class="trending-card-track"><%= tp.track_name || 'General' %></div>
          <div class="trending-card-title"><%= tp.title %></div>
          <div class="trending-card-meta">
            <span>👍 <%= tp.vote_count || 0 %></span>
            <span class="trending-badge">🔥 Hot</span>
          </div>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- ── Project Grid ──────────────────────────────────────────── -->
    <% if (!projects || projects.length === 0) { %>

    <!-- Empty State -->
    <div class="empty-state">
      <div class="empty-state-icon">🔍</div>
      <div class="empty-state-title">No Projects Found</div>
      <div class="empty-state-msg">Try changing your search or filters to see more results.</div>
      <a href="/projects" class="btn-secondary">Clear Filters</a>
    </div>

    <% } else { %>
    <div class="gallery-grid">
      <% projects.forEach(function(project, idx) { %>
      <%
        var trackHue = project.track_id ? ((project.track_id * 47) % 360) : (idx * 37 % 360);
        var statusClass = {
          'idea': 'badge-purple',
          'in_development': 'badge-orange',
          'submitted': 'badge-blue',
          'completed': 'badge-green',
          'live': 'badge-bright-green',
          'open_for_contributors': 'badge-teal'
        }[project.status] || 'badge-gray';
        var statusLabel = {
          'idea': 'Idea',
          'in_development': 'In Development',
          'submitted': 'Submitted',
          'completed': 'Completed',
          'live': 'Live',
          'open_for_contributors': 'Open for Contributors'
        }[project.status] || project.status;
        var diffClass = {
          'beginner': 'badge-green',
          'intermediate': 'badge-orange',
          'advanced': 'badge-red'
        }[project.difficulty] || 'badge-gray';
        var diffLabel = project.difficulty ? (project.difficulty.charAt(0).toUpperCase() + project.difficulty.slice(1)) : 'Unknown';
        var techs = (project.technologies && Array.isArray(project.technologies)) ? project.technologies.slice(0, 3) : [];
        var tags  = (project.tags && Array.isArray(project.tags)) ? project.tags.slice(0, 3) : [];
        var userLoggedIn = (typeof session !== 'undefined' && session);
      %>
      <article class="project-card" data-id="<%= project.id %>">
        <!-- Track colour banner -->
        <div class="track-banner" style="background: hsl(<%= trackHue %>, 55%, 50%)"></div>

        <!-- Card body -->
        <div class="card-body">
          <!-- Title row -->
          <div class="card-title-row">
            <a href="/projects/<%= project.id %>" class="card-title"><%= project.title %></a>
            <div class="card-actions-top">
              <button
                class="btn-save <%= project.user_saved ? 'active' : '' %>"
                data-id="<%= project.id %>"
                data-action="save"
                title="<%= userLoggedIn ? 'Save project' : 'Login to save' %>"
                aria-label="Save"
              >🔖 <span class="save-count"><%= project.save_count || 0 %></span></button>
              <button
                class="btn-vote <%= project.user_voted ? 'active' : '' %>"
                data-id="<%= project.id %>"
                data-action="vote"
                title="<%= userLoggedIn ? 'Vote for project' : 'Login to vote' %>"
                aria-label="Vote"
              >👍 <span class="vote-count"><%= project.vote_count || 0 %></span></button>
            </div>
          </div>

          <!-- Summary -->
          <p class="card-summary"><%= project.summary || 'No description provided.' %></p>

          <!-- Badges row -->
          <div class="card-badges">
            <span class="badge badge-track" style="background:hsl(<%= trackHue %>,55%,92%);color:hsl(<%= trackHue %>,55%,30%)"><%= project.track_name || 'General' %></span>
            <span class="badge <%= diffClass %>"><%= diffLabel %></span>
            <span class="badge <%= statusClass %>"><%= statusLabel %></span>
          </div>

          <!-- Tech stack -->
          <% if (techs.length > 0) { %>
          <div class="card-tech">
            <% techs.forEach(function(t) { %><span class="badge badge-tech"><%= t %></span><% }) %>
            <% if (project.technologies && project.technologies.length > 3) { %><span class="badge badge-tech">+<%= project.technologies.length - 3 %></span><% } %>
          </div>
          <% } %>

          <!-- Tags -->
          <% if (tags.length > 0) { %>
          <div class="card-tags">
            <% tags.forEach(function(tag) { %><span class="tag-chip">#<%= tag %></span><% }) %>
          </div>
          <% } %>

          <!-- Stats -->
          <div class="card-stats">
            <span title="Views">👁 <%= project.view_count || 0 %></span>
            <span title="Votes">👍 <%= project.vote_count || 0 %></span>
            <span title="Saves">🔖 <%= project.save_count || 0 %></span>
            <span title="Comments">💬 <%= project.comment_count || 0 %></span>
          </div>

          <!-- Meta indicators -->
          <div class="card-meta-indicators">
            <% if (project.open_source) { %><span class="meta-indicator">🔓 Open Source</span><% } %>
            <% if (project.live_demo_url) { %><span class="meta-indicator meta-live">🟢 Live Demo</span><% } %>
          </div>

          <!-- CTA Buttons -->
          <div class="card-cta">
            <a href="/projects/<%= project.id %>" class="btn-card-primary">View Project</a>
            <% if (project.repo_url) { %><a href="<%= project.repo_url %>" target="_blank" rel="noopener" class="btn-card-secondary">GitHub</a><% } %>
            <% if (project.live_demo_url) { %><a href="<%= project.live_demo_url %>" target="_blank" rel="noopener" class="btn-card-secondary">Live Demo</a><% } %>
          </div>
        </div>
      </article>
      <% }) %>
    </div>

    <!-- ── Pagination ─────────────────────────────────────────── -->
    <% if (typeof pages !== 'undefined' && pages > 1) { %>
    <nav class="pagination" aria-label="Page navigation">
      <%
        var currentPage = typeof page !== 'undefined' ? parseInt(page) : 1;
        var buildPageUrl = function(p) {
          var params = [];
          if (q) params.push('q=' + encodeURIComponent(q));
          if (track) params.push('track=' + encodeURIComponent(track));
          if (difficulty) params.push('difficulty=' + encodeURIComponent(difficulty));
          if (status) params.push('status=' + encodeURIComponent(status));
          if (open_source) params.push('open_source=1');
          if (has_demo) params.push('has_demo=1');
          if (contributors) params.push('contributors=1');
          if (sort) params.push('sort=' + encodeURIComponent(sort));
          params.push('page=' + p);
          return '/projects?' + params.join('&');
        };
      %>
      <% if (currentPage > 1) { %>
      <a href="<%= buildPageUrl(currentPage - 1) %>" class="page-btn">← Prev</a>
      <% } else { %>
      <span class="page-btn page-btn-disabled">← Prev</span>
      <% } %>

      <% for (var p = 1; p <= pages; p++) { %>
        <% if (p === currentPage) { %>
        <span class="page-btn page-btn-active"><%= p %></span>
        <% } else if (p === 1 || p === pages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
        <a href="<%= buildPageUrl(p) %>" class="page-btn"><%= p %></a>
        <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
        <span class="page-btn page-btn-ellipsis">…</span>
        <% } %>
      <% } %>

      <% if (currentPage < pages) { %>
      <a href="<%= buildPageUrl(currentPage + 1) %>" class="page-btn">Next →</a>
      <% } else { %>
      <span class="page-btn page-btn-disabled">Next →</span>
      <% } %>
    </nav>
    <% } %>

    <% } /* end projects.length > 0 */ %>
  </div><!-- /.gallery-main -->
</div><!-- /.gallery-layout -->

<!-- ── Tooltip element ──────────────────────────────────────────── -->
<div class="vote-tooltip" id="voteTooltip" role="alert" aria-live="polite"></div>

<script>
(function () {
  /* ── Helpers ── */
  var loggedIn = <%= (typeof session !== 'undefined' && session) ? 'true' : 'false' %>;

  var tooltip = document.getElementById('voteTooltip');
  function showTooltip(msg, x, y) {
    tooltip.textContent = msg;
    tooltip.style.left = x + 'px';
    tooltip.style.top  = (y - 40) + 'px';
    tooltip.classList.add('visible');
    clearTimeout(tooltip._t);
    tooltip._t = setTimeout(function () { tooltip.classList.remove('visible'); }, 2200);
  }

  /* ── Vote / Save toggle buttons ── */
  document.querySelectorAll('.btn-vote, .btn-save').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      var id     = btn.dataset.id;
      var action = btn.dataset.action; // 'vote' or 'save'
      var rect   = btn.getBoundingClientRect();

      if (!loggedIn) {
        showTooltip('Login to ' + action, rect.left + window.scrollX, rect.top + window.scrollY);
        return;
      }

      fetch('/api/projects/' + id + '/' + action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      })
      .then(function (res) {
        if (!res.ok) throw new Error('Request failed');
        return res.json();
      })
      .then(function (data) {
        btn.classList.toggle('active', !!data.active);
        var countEl = btn.querySelector('.' + action + '-count');
        if (countEl && typeof data.count !== 'undefined') countEl.textContent = data.count;
        /* Also update the stats row count inside the same card */
        var card = btn.closest('.project-card');
        if (card) {
          var statSpans = card.querySelectorAll('.card-stats span');
          statSpans.forEach(function (s) {
            if (action === 'vote' && s.title === 'Votes') s.textContent = '👍 ' + data.count;
            if (action === 'save' && s.title === 'Saves') s.textContent = '🔖 ' + data.count;
          });
        }
      })
      .catch(function () {
        showTooltip('Something went wrong. Try again.', rect.left + window.scrollX, rect.top + window.scrollY);
      });
    });
  });

  /* ── Sort select: navigate preserving all active filters ── */
  var sortSelect = document.getElementById('sortSelect');
  if (sortSelect) {
    sortSelect.addEventListener('change', function () {
      var params = new URLSearchParams(window.location.search);
      params.set('sort', sortSelect.value);
      params.delete('page'); // reset to page 1 on sort change
      window.location.href = '/projects?' + params.toString();
    });
  }

  /* ── Filter form: auto-submit on radio/checkbox change ── */
  var filterForm = document.getElementById('filterForm');
  if (filterForm) {
    /* Sync sort value into the hidden input before submitting */
    filterForm.querySelectorAll('input[type="radio"], input[type="checkbox"]').forEach(function (el) {
      el.addEventListener('change', function () {
        var hiddenSort = document.getElementById('hiddenSort');
        if (hiddenSort && sortSelect) hiddenSort.value = sortSelect.value;
        filterForm.submit();
      });
    });
  }

  /* ── Vote / Save toggle buttons ── */
  document.querySelectorAll('.btn-vote, .btn-save').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      var id     = btn.dataset.id;
      var action = btn.dataset.action; // 'vote' or 'save'
      var rect   = btn.getBoundingClientRect();

      if (!loggedIn) {
        showTooltip('Login to ' + action, rect.left + window.scrollX, rect.top + window.scrollY);
        return;
      }

      fetch('/api/projects/' + id + '/' + action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        credentials: 'same-origin'
      })
      .then(function (res) {
        if (!res.ok) throw new Error('Request failed');
        return res.json();
      })
      .then(function (data) {
        // API returns { voted: bool, count } or { saved: bool, count }
        var isActive = action === 'vote' ? data.voted : data.saved;
        btn.classList.toggle('active', !!isActive);
        var countEl = btn.querySelector('.' + action + '-count');
        if (countEl && typeof data.count !== 'undefined') countEl.textContent = data.count;
        /* Also update the stats row count inside the same card */
        var card = btn.closest('.project-card');
        if (card) {
          card.querySelectorAll('.card-stats span').forEach(function (s) {
            if (action === 'vote' && s.title === 'Votes') s.textContent = '👍 ' + data.count;
            if (action === 'save' && s.title === 'Saves') s.textContent = '🔖 ' + data.count;
          });
        }
      })
      .catch(function () {
        showTooltip('Something went wrong. Try again.', rect.left + window.scrollX, rect.top + window.scrollY);
      });
    });
  });

  /* ── Search debounce (400 ms) ── */
  var searchInput = document.getElementById('searchInput');
  var searchForm  = document.getElementById('searchForm');
  var debounceTimer;
  if (searchInput && searchForm) {
    searchInput.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(function () { searchForm.submit(); }, 400);
    });
  }
})();
</script>

<%- include('layouts/footer') %>
