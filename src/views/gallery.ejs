<!DOCTYPE html>
<html>
<head><title>Project Gallery</title></head>
<body>
<div class="gallery-container" style="max-width: 1200px; margin: 0 auto; padding: 40px 20px;">
  <h1 style="font-size: 2.5rem; margin-bottom: 24px; color: #1a1a1a;">Project Gallery</h1>
  
  <form method="GET" action="/projects" style="display: flex; gap: 12px; margin-bottom: 32px; flex-wrap: wrap;">
    <input 
      type="text" 
      name="q" 
      value="<%= q %>" 
      placeholder="Search projects..." 
      style="padding: 12px; border: 2px solid #ccc; border-radius: 4px; flex-grow: 1; min-width: 250px; font-size: 1rem;"
    >
    <select name="track" style="padding: 12px; border: 2px solid #ccc; border-radius: 4px; font-size: 1rem;">
      <option value="">All Tracks</option>
      <% tracks.forEach(t => { %>
        <option value="<%= t.id %>" <%= track === t.id ? 'selected' : '' %>><%= t.name %></option>
      <% }) %>
    </select>
    <button type="submit" style="padding: 12px 24px; background: #1a1a1a; color: white; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; font-weight: bold;">
      Search
    </button>
  </form>

  <% if (projects.length === 0) { %>
    <div style="background: #f8f9fa; padding: 40px; text-align: center; border-radius: 8px; border: 2px dashed #ccc;">
      <h3 style="color: #666; margin: 0;">No projects found</h3>
      <p style="color: #888; margin-top: 8px;">Try adjusting your search filters.</p>
    </div>
  <% } else { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 24px;">
      <% projects.forEach(p => { %>
        <div class="project-card" style="background: white; border: 2px solid #1a1a1a; border-radius: 8px; overflow: hidden; box-shadow: 4px 4px 0px #1a1a1a; transition: transform 0.2s;">
          <div style="padding: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 12px;">
              <h2 style="margin: 0; font-size: 1.5rem; color: #1a1a1a;"><a href="/projects/<%= p.id %>" style="color: inherit; text-decoration: none;"><%= p.title.toLowerCase() %></a></h2>
              <span style="background: #e0e7ff; color: #3730a3; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: bold;"><%= p.track_name %></span>
            </div>
            
            <p style="color: #555; line-height: 1.5; margin-bottom: 20px; font-size: 0.95rem;"><%= p.summary %></p>
            
            <div style="border-top: 1px solid #eee; padding-top: 16px; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 0.9rem; color: #666; font-weight: 500;">By <%= p.team_name %></span>
              <% if (p.repo_url) { %>
                <a href="<%= p.repo_url %>" target="_blank" style="color: #1a73e8; text-decoration: none; font-size: 0.9rem; font-weight: bold;">View Repo dY!M</a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
</body>
</html>
