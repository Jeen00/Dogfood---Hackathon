<%- include('layouts/header', { title: 'Project Gallery', session }) %>

<h1>Project Gallery</h1>

<form method="GET" action="/projects" class="search-form">
  <div class="search-row">
    <input
      type="text"
      name="q"
      value="<%= q %>"
      placeholder="Search projects..."
      style="width: 280px;"
    >
    <select name="track">
      <option value="">All tracks</option>
      <% for (const tr of tracks) { %>
        <option value="<%= tr.id %>" <%= track === tr.id ? 'selected' : '' %>>
          <%= tr.name %>
        </option>
      <% } %>
    </select>
    <button type="submit">Search</button>
    <% if (q || track) { %>
      <a href="/projects" class="btn-secondary">Clear</a>
    <% } %>
  </div>
</form>

<% if (projects.length === 0) { %>
  <p>No projects found.</p>
<% } else { %>
  <p><%= projects.length %> project<%= projects.length === 1 ? '' : 's' %> found.</p>
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Team</th>
        <th>Track</th>
        <th>Submitted</th>
      </tr>
    </thead>
    <tbody>
      <% for (const p of projects) { %>
        <tr>
          <td><a href="/projects/<%= p.id %>"><%= p.title %></a></td>
          <td><%= p.team_name %></td>
          <td><%= p.track_name %></td>
          <td><%= p.submitted_at ? p.submitted_at.slice(0, 10) : 'N/A' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<%- include('layouts/footer') %>
